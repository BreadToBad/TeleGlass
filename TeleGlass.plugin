            ),
            Header(text="О проекте"),
            Text(
                text="GitHub",
                subtext="BreadToBad/TeleGlass",
                icon="msg_link",
                on_click=self._open_github,
            ),
        ]

    def _open_github(self, view):
        try:
            jclass("org.telegram.messenger.browser.Browser").openUrl(
                view.getContext(), "https://github.com/BreadToBad/TeleGlass"
            )
        except Exception as exc:
            self._log_error("GitHub: открытие страницы", exc)

    # Настройки и журнал

    def _preset_values(self, index):
        if type(index) is not int or not 0 <= index < 4:
            raise ValueError("Неизвестный пресет TeleGlass.")
        excluded = {item.key for item in self._developer_settings() if getattr(item, "key", None)}
        excluded.update(("glass_color_dark", "glass_color_light"))
        defaults = {
            key: default
            for key, (default, _maximum) in self._settings_schema().items()
            if key not in excluded
        }
        if index == 2:
            return defaults
        # Пресет не перезаписывает пользовательские цвета и настройки журнала.
        presets = {
            0: {
                "glass_enabled": True,
                "glass_density_dark": 2,
