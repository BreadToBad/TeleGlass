DARK_RIM_TOP = 0x38FFFFFF
DARK_RIM_BOTTOM = 0x18FFFFFF
DARK_SHADOW = 0x40000000

LIGHT_RIM_TOP = 0x26000000
LIGHT_RIM_BOTTOM = 0x12000000
LIGHT_SHADOW = 0x26000000

LENS_INTENSITY = 0.72
LENS_THICKNESS_DP = 9.0
RIM_WIDTH_TOP_DP = 0.35
RIM_WIDTH_BOTTOM_DP = 0.25
SHADOW_ALPHA = 0.035

