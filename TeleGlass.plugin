                default=5,
                items=[
                    "Без ограничения",
                    "120 FPS",
                    "90 FPS",
                    "60 FPS",
                    "45 FPS",
                    "30 FPS",
                    "20 FPS",
                    "15 FPS",
                ],
                icon="msg_speed",
