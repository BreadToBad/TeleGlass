                "glass_density_dark": 2,
                "glass_density_light": 2,
                "glass_outline": 3,
                "glass_date_dark_text": True,
                "perf_lens": 0,
                "perf_native_dates": False,
                "perf_no_shadow": True,
                "perf_round_light": True,
                "perf_glass_fps": 3,
                "perf_round_fps": 5,
