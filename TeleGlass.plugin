    def _show_settings_presets(self, *_args):
        from ui.alert import AlertDialogBuilder

        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment is not None else None
        if activity is None:
            return
        builder = AlertDialogBuilder(activity)
        builder.set_title("Пресеты настроек")
        builder.set_message(
            "Цвета подложки стекла и настройки для разработчиков не изменятся. "
            "Для корректного применения настроек нужна полная перезагрузка приложения."
        )
        defaults = self._preset_values(2)
        labels = []
        for index, title in enumerate(("Максимальный", "Повышенный", "Стандартный", "Минимальный")):
            values = self._preset_values(index)
            selected = all(self._setting(key, defaults[key]) == value for key, value in values.items())
            labels.append(("✓ " if selected else "") + title)

        def select(dialog, index):
            self._apply_settings_preset(index)
            dialog.dismiss()

        builder.set_items(labels, select)
        builder.set_negative_button("Отмена", lambda dialog, _which: dialog.dismiss())
        builder.show()

    def _apply_settings_preset(self, index):
        values = self._preset_values(index)

        def apply():
            if not self._transfer_alive:
                return
            previous = {key: self._setting(key, default) for key, default in self._preset_values(2).items()}
            last_key = next(reversed(values))
            try:
                for key, value in values.items():
                    self.set_setting(key, value, reload_settings=key == last_key)
                self._load_perf()
                self._reload_glass()
            except Exception as exc:
                self._log_error("Применение пресета", exc)
                try:
                    last_key = next(reversed(previous))
                    for key, value in previous.items():
                        self.set_setting(key, value, reload_settings=key == last_key)
                    self._load_perf()
                    self._reload_glass()
                    self._settings_notice("Пресет не применён. Прежние настройки восстановлены.")
                except Exception as rollback_error:
                    self._log_error("Восстановление настроек после пресета", rollback_error)
                    self._settings_notice(
                        "Ошибка применения и восстановления. Проверьте настройки TeleGlass."
                    )
            else:
                self._settings_notice("Пресет применён.")

        self.schedule(apply, 0)

    def _settings_schema(self):
        schema = {
            "glass_color_dark": (0x393939, 0xFFFFFF),
            "glass_color_light": (0xEDEDED, 0xFFFFFF),
            "glass_emoji_buttons": (False, None),
        }
        for items in (
            self.create_settings(),
            self._appearance_settings(),
            self._performance_settings(),
            self._glass_settings(),
            self._developer_settings(),
        ):
            for item in items:
                key = getattr(item, "key", None)
                if key:
                    choices = getattr(item, "items", None)
                    schema[key] = (item.default, len(choices) - 1 if choices else None)
        return schema

    def _validate_settings_file(self, payload):
        if (
            type(payload) is not dict
            or payload.get("plugin") != "ios_liquid_glass"
            or type(payload.get("format")) is not int
            or payload["format"] != 1
            or type(payload.get("settings")) is not dict
        ):
            raise ValueError("Это не поддерживаемый файл настроек TeleGlass.")
        schema = self._settings_schema()
        settings = payload["settings"]
        if not settings or settings.keys() - schema.keys() - {
            "perf_settings_capture",
            "glass_outline_migrated",
        }:
            raise ValueError("Файл содержит неизвестные настройки. Возможно, нужна новая версия TeleGlass.")
        if "perf_settings_capture" in settings and type(settings["perf_settings_capture"]) is not bool:
            raise ValueError("Недопустимое значение настройки: perf_settings_capture")
        values = {}
        for key, (default, maximum) in schema.items():
            value = settings.get(key, default)
            if type(value) is not type(default) or (maximum is not None and not 0 <= value <= maximum):
                raise ValueError("Недопустимое значение настройки: " + key)
            values[key] = value
        values["glass_emoji_tabs"] = values["glass_emoji_buttons"] = (
            values["glass_emoji_tabs"] or values["glass_emoji_buttons"]
        )
        return values

    def _settings_notice(self, message):
        from android.widget import Toast
        from org.telegram.messenger import ApplicationLoader

        Toast.makeText(ApplicationLoader.applicationContext, message, Toast.LENGTH_LONG).show()

    def _register_settings_file(self):
        try:
            from file_utils import FilesController

            self._settings_file_secret = FilesController.register(
                FilesController.FileInfo(
                    ext="teleglass",
                    on_click=self._open_settings_file,
                    whitelist_places=[FilesController.Place.ChatActivity],
                )
            )
        except Exception as exc:
            self._log_error("Регистрация файла настроек", exc)
            self._settings_notice(
                "Не удалось включить открытие .teleglass из чата. Импорт настроек недоступен."
            )

    def _open_settings_file(self, args):
        if self._transfer_alive:
            self._read_settings_file(path=str(args.file.getAbsolutePath()), activity=args.activity)

    def _read_settings_file(self, path, activity=None):
        import json
        from client_utils import run_on_queue

        def read():
            try:
                with open(path, "rb") as stream:
                    data = stream.read(65537)
                if len(data) > 65536:
                    raise ValueError("Файл настроек слишком большой (максимум 64 КиБ).")
                payload = json.loads(bytes(data).decode("utf-8-sig"))
                self.schedule(lambda: self._confirm_settings_import(payload, activity), 0)
            except Exception as exc:
                self._log_error("Чтение настроек", exc)
                message = (
                    str(exc)
                    if isinstance(exc, ValueError)
                    and not isinstance(exc, (UnicodeError, json.JSONDecodeError))
                    else "Не удалось прочитать файл настроек TeleGlass."
                )
                self.schedule(lambda: self._settings_notice(message) if self._transfer_alive else None, 0)

        run_on_queue(read)

    def _confirm_settings_import(self, payload, activity=None):
        from ui.alert import AlertDialogBuilder

        if not self._transfer_alive:
            return
        try:
            values = self._validate_settings_file(payload)
        except ValueError as exc:
            self._settings_notice(str(exc))
            return
        fragment = get_last_fragment()
        activity = activity or (fragment.getParentActivity() if fragment is not None else None)
        if activity is None:
            return
        builder = AlertDialogBuilder(activity)
        builder.set_title("Импортировать настройки TeleGlass?")
        builder.set_message(
            "Все текущие настройки TeleGlass будут заменены настройками из файла. Журнал не изменится."
        )

        def apply(dialog, _which):
            if not self._transfer_alive:
                dialog.dismiss()
                return
            previous = {
                key: self._setting(key, default)
                for key, (default, _maximum) in self._settings_schema().items()
            }
            try:
                self.import_settings(values)
                self._logging_enabled = values["logging_enabled"]
                self._load_log_limit()
                self._load_perf()
                self._reload_glass()
            except Exception as exc:
                self._log_error("Импорт настроек", exc)
                try:
                    self.import_settings(previous)
                    self._logging_enabled = previous["logging_enabled"]
                    self._load_log_limit()
                    self._load_perf()
                    self._reload_glass()
                    self._settings_notice("Импорт не выполнен. Прежние настройки восстановлены.")
                except Exception as rollback_error:
                    self._log_error("Восстановление настроек после ошибки импорта", rollback_error)
                    self._settings_notice("Ошибка импорта и восстановления. Проверьте настройки TeleGlass.")
            else:
                self._settings_notice("Настройки TeleGlass импортированы.")
            dialog.dismiss()

        builder.set_positive_button("Импортировать", apply)
        builder.set_negative_button("Отмена", lambda dialog, _which: dialog.dismiss())
        builder.show()

    def _export_settings_file(self, *_args):
        import json
        import tempfile
        from file_utils import get_cache_dir

        fragment = get_last_fragment()
        if fragment is None:
            return
        try:
            settings = {
                key: self._setting(key, default)
                for key, (default, _maximum) in self._settings_schema().items()
            }
            payload = {
                "plugin": "ios_liquid_glass",
                "format": 1,
                "version": __version__,
                "settings": settings,
            }
            self._validate_settings_file(payload)
            # Не перезаписываем файл, пока Telegram отправляет его в фоне.
            directory = tempfile.mkdtemp(prefix="teleglass-", dir=str(get_cache_dir()))
            path = os.path.join(directory, "TeleGlass-" + strftime("%Y-%m-%d-%H-%M-%S") + ".teleglass")
            with open(path, "w", encoding="utf-8") as stream:
                json.dump(payload, stream, ensure_ascii=False, indent=2)
            self._share_settings_file(fragment, path)
        except Exception as exc:
            self._log_error("Экспорт настроек", exc)
            self._settings_notice("Не удалось экспортировать настройки TeleGlass.")

    def _share_settings_file(self, parent, path):
        from android.os import Bundle
        from org.telegram.ui import DialogsActivity
        from org.telegram.messenger import AccountInstance, MessageObject, SendMessagesHelper

        plugin = self

        class Recipient(dynamic_proxy(jclass("org.telegram.ui.DialogsActivity$DialogsActivityDelegate"))):
            def canSelectStories(self):
                return False

            def didSelectStories(self, fragment):
                return False

            def didSelectDialogs(self, fragment, dids, message, param, notify, schedule_date, *extra):
                if not plugin._transfer_alive:
                    return False
                try:
                    account = AccountInstance.getInstance(fragment.getCurrentAccount())
                    for i in range(dids.size()):
                        peer = dids.get(i)
                        reply = None
                        if peer.topicId != 0:
                            topic = (
                                account.getMessagesController()
                                .getTopicsController()
                                .findTopic(-peer.dialogId, peer.topicId)
                            )
                            if topic is None or topic.topicStartMessage is None:
                                raise ValueError("Тема недоступна")
                            reply = MessageObject(
                                fragment.getCurrentAccount(), topic.topicStartMessage, False, False
                            )
                        SendMessagesHelper.prepareSendingDocument(
                            account,
                            path,
                            path,
                            None,
                            str(message) if message is not None else None,
                            "application/octet-stream",
                            peer.dialogId,
                            reply,
                            reply,
                            None,
                            None,
                            None,
                            bool(notify),
                            int(schedule_date),
                            None,
                            None,
                            False,
                        )
                    fragment.finishFragment()
                    return True
                except Exception as exc:
                    plugin._log_error("Отправка настроек", exc)
                    plugin._settings_notice("Не удалось подготовить отправку файла настроек.")
                    return False

        args = Bundle()
        args.putBoolean("onlySelect", True)
        args.putBoolean("canSelectTopics", True)
        args.putInt("dialogsType", 3)
        picker = DialogsActivity(args)
        picker.setDelegate(Recipient())
        if not parent.presentFragment(picker):
            raise RuntimeError("Не удалось открыть выбор получателя")

    def _developer_settings(self):
        return [
            Header(text="Для разработчиков"),
            Switch(
                key="logging_enabled",
                text="Запись журнала",
                default=False,
                icon="msg_log",
                on_change=self._on_logging_changed,
            ),
            Selector(
                key="log_limit",
                text="Размер журнала",
                default=1,
                items=["128 КиБ", "512 КиБ", "1 МиБ", "2 МиБ"],
                icon="msg_filled_storageusage",
                on_change=self._on_log_limit_changed,
            ),
            Text(text="Скопировать логи", icon="msg_copy", on_click=self._copy_logs),
            Text(text="Очистить журнал логов", icon="msg_clear", on_click=self._clear_logs),
        ]

    def _on_logging_changed(self, value):
        self.set_setting("logging_enabled", bool(value), reload_settings=False)
        self._logging_enabled = bool(value)
        if self._java_runtime is not None:
            self._java_runtime.logging(self._logging_enabled)
        if self._logging_enabled:
            self._warned.clear()
            for entry in self._main_headers.values():
                entry.pop("diagnostics", None)
                entry.pop("glass_frame_logged", None)
                entry.pop("blur_root", None)
            self.log("Журнал: запись включена")
            self._schedule_diag_heartbeat()

    def _schedule_diag_heartbeat(self):
        if self._diag_heartbeat_scheduled or not self._logging_enabled:
            return
        self._diag_heartbeat_scheduled = True
        self.schedule(self._diag_heartbeat, 1000)

    def _diag_heartbeat(self):
        self._diag_heartbeat_scheduled = False
        if not self._logging_enabled:
            return
        capture = [0, 0, 0, 0]
        for state in self._capture_states.values():
            stats = state.get("stats")
            if stats is not None:
                for index in range(4):
                    capture[index] += int(stats[index])
        try:
            fragment = get_last_fragment()
            fragment_name = str(fragment.getClass().getName()) if fragment is not None else "None"
        except Exception:
            fragment_name = "unknown"
        draw = [int(value) for value in self._diag_draw_counts]
        self.log(
            "Диагностика: состояние; "
            f"round_active={self._round_video_active}; round_playing={self._round_playing}; "
            f"fragment={fragment_name}; captures(in={capture[0]},gate_skip={capture[1]},"
            f"interval_skip={capture[2]},real={capture[3]}); "
            f"draw(header_root={draw[0]},header_fade={draw[1]},panel={draw[2]},"
            f"round={draw[3]},player={draw[4]})"
        )
        self._schedule_diag_heartbeat()

    def _schedule_round_poll(self):
        if self._round_poll_scheduled or not self._active:
            return
        self._round_poll_scheduled = True
        self.schedule(self._round_poll, 200)

    def _round_poll(self):
        self._round_poll_scheduled = False
        if not self._active:
            return
        # В некоторых форках события MediaController теряются. Опрос страхует их.
        self._round_start()
        self._schedule_round_poll()

    def _load_log_limit(self):
        try:
            index = max(0, min(3, int(self._setting("log_limit", 1))))
        except (TypeError, ValueError, OverflowError):
            index = 1
        self._log_limit = (128, 512, 1024, 2048)[index] * 1024
        self._trim_logs()

    def _on_log_limit_changed(self, value):
        self.set_setting("log_limit", int(value), reload_settings=False)
        self._load_log_limit()
        self.log(f"Журнал: лимит изменён; bytes={self._log_limit}")

    def _trim_logs(self):
        limit = getattr(self, "_log_limit", 512 * 1024)
        if getattr(self, "_log_bytes", 0) > limit:
            # Оставляем запас, иначе следующая запись снова скопирует весь журнал.
            tail = self._log_buffer.getvalue().encode("utf-8")[-limit * 3 // 4 :].decode("utf-8", "ignore")
            tail = tail.partition("\n")[2]
            self._log_buffer = StringIO()
            self._log_buffer.write(tail)
            self._log_bytes = len(tail.encode("utf-8"))
            self._log_trimmed = True

    def log(self, message, level="INFO"):
        if not self._logging_enabled:
            return
        prefix = f"{strftime('%Y-%m-%d %H:%M:%S')} [{level}] TeleGlass: "
        text = "".join(prefix + line + "\n" for line in str(message).splitlines()) or prefix + "\n"
        self._log_buffer.write(text)
        self._log_bytes += len(text.encode("utf-8"))
        self._trim_logs()
        try:
            super().log(text.rstrip("\n"))
        except Exception:
            pass  # Отказ логгера SDK не должен мешать записи в наш буфер.

    def _diag_draw(self, index):
        if self._logging_enabled:
            self._diag_draw_counts[index] = int(self._diag_draw_counts[index]) + 1

    def _log_error(self, context, error, level="ERROR"):
        if not self._logging_enabled:
            return
        detail = (
            "".join(format_exception(type(error), error, error.__traceback__)).rstrip()
            if isinstance(error, BaseException)
            else str(error)
        )
        self.log(f"{context}: ошибка; {detail}", level)

    def _warn_once(self, context, error):
        if context not in self._warned:
            self._warned.add(context)
            self._log_error(context, error, "WARN")

    def _clear_logs(self, *_args):
        from android.widget import Toast
        from org.telegram.messenger import ApplicationLoader

        self._log_buffer.seek(0)
        self._log_buffer.truncate(0)
        self._log_bytes = 0
        self._log_trimmed = False
        Toast.makeText(
            ApplicationLoader.applicationContext, "Журнал TeleGlass очищен.", Toast.LENGTH_LONG
        ).show()

    def _copy_logs(self, *_args):
        from android.widget import Toast
        from org.telegram.messenger import ApplicationLoader

        try:
            self.log("Журнал: копирование")
            report = (
                f"TeleGlass {__version__} — журнал текущего запуска\n"
                f"logging_enabled={self._logging_enabled}\n"
                f"log_bytes={getattr(self, '_log_bytes', 0)}; log_limit={self._log_limit}; "
                f"older_entries_removed={getattr(self, '_log_trimmed', False)}\nactive={self._active} "
                f"known_fragments={len(self._known_fragments)} "
                f"top_surfaces={len(self._top_surfaces)} "
                f"pinned_surfaces={len(self._pinned_surfaces)}\n"
                f"elements={self._element_flags}\nperformance={self._perf}\n"
                f"appearance={self._appearance}\n\n"
                + "diagnostic_counts="
                + str([int(value) for value in self._diag_draw_counts])
                + "\n"
                + self._glass_diagnostics()
                + "\n\n"
                + "Главная подложка — состояние при копировании:\n"
                + "\n".join(
                    f"owner={key}; ready={entry.get('ready')}; "
                    f"events={sorted(entry.get('diagnostics', set()))}; "
                    f"search={self.field(entry['fragment'], 'searchAnimationProgress')}; "
                    f"action={self.field(entry['fragment'], 'progressToActionMode')}; "
                    f"drawingBlur={self.field(self.field(entry['fragment'], 'fragmentView'), 'drawingBlur')}; "
                    f"slide={self.field(entry['fragment'], 'slideFragmentProgress')}; "
                    f"fade={self.field(entry['fragment'], 'topBubblesFadeView') is not None}"
                    for key, entry in getattr(self, '_main_headers', {}).items()
                )
                + "\n\n"
                + self._log_buffer.getvalue()
            )
            if not AndroidUtilities.addToClipboard(report):
                raise RuntimeError("Clipboard unavailable")
            message = "Логи скопированы в буфер обмена."
        except Exception as exc:
            self._log_error("Копирование журнала", exc)
            message = "Не удалось скопировать логи в буфер обмена."
        Toast.makeText(ApplicationLoader.applicationContext, message, Toast.LENGTH_LONG).show()

    def _glass_diagnostics(self):
        def describe(obj):
            if obj is None:
                return "None"
            try:
                return f"{obj.getClass().getName()}#{_identity(obj)}"
            except Exception:
                return f"{type(obj).__name__}#{_identity(obj)}"

        def call(obj, method):
            try:
                return getattr(obj, method)() if obj is not None else "unknown"
            except Exception as exc:
                return f"unknown({type(exc).__name__})"

        def node_state(node):
            if node is None:
                return "None"
            # Без getRenderEffect состояние GPU проверить нельзя.
            attached = call(node, "getRenderEffect")
            return (
                f"{describe(node)}; attached={describe(attached) if not isinstance(attached, str) else attached}; "
                f"display_list={call(node, 'hasDisplayList')}"
            )

        lines = [
            "Диагностика стекла — снимок состояния (v3):",
            "None у поля = отсутствует либо недоступно мосту; attached=unknown не подтверждает состояние GPU.",
            f"round_playing={getattr(self, '_round_playing', False)}; "
            f"lens_mode={self._perf.get('lens', 0)}; "
            f"tracked={len(getattr(self, '_original_drawables', {}))}; "
            f"java_runtime={getattr(self, '_java_runtime_status', 'unknown')}",
        ]
        try:
            lines.append(f"android_sdk={jclass('android.os.Build$VERSION').SDK_INT}")
        except Exception as exc:
            lines.append(f"android_sdk=unknown({type(exc).__name__})")
        try:
            lite = jclass("org.telegram.messenger.LiteMode")
            lines.append(
                f"telegram_flags: chat_blur={lite.isEnabled(lite.FLAG_CHAT_BLUR)}; "
                f"liquid_glass={lite.isEnabled(lite.FLAG_LIQUID_GLASS)}; "
                f"chat_blur_enabled={jclass('org.telegram.messenger.SharedConfig').chatBlurEnabled()}"
            )
        except Exception as exc:
            lines.append(f"telegram_flags=unknown({type(exc).__name__}: {exc})")
        try:
            controller = jclass("org.telegram.messenger.MediaController").getInstance()
            message = controller.getPlayingMessageObject()
            lines.append(
                f"player_message={message is not None}; "
                f"is_round={call(message, 'isRoundVideo')}; "
                f"paused={call(controller, 'isMessagePaused')}; "
                f"downloading={call(controller, 'isDownloadingCurrentMessage')}"
            )
        except Exception as exc:
            lines.append(f"player_query_error={type(exc).__name__}: {exc}")
        factories, sources, suppressors = {}, {}, {}
        owners = dict(getattr(self, '_known_fragments', {}))
        owners.update(
            {
                _identity(entry['fragment']): entry['fragment']
                for entry in getattr(self, '_main_headers', {}).values()
            }
        )
        owners.update(getattr(self, '_main_owners', {}))
        owners.update({_identity(owner): owner for _view, owner in getattr(self, '_owners', {}).values()})
        for owner_key, owner in owners.items():
            panel = self.field(owner, "topPanelLayout")
            if panel is not None:
                native = self.field(panel, "backgroundDrawable")
                lines.append(
                    f"owner={owner_key}; stock_panel={describe(panel)}; drawable={describe(native)}; "
                    f"source={describe(self.field(native, 'source'))}; "
                    f"provider={describe(self.field(native, 'colorProvider'))}; "
                    f"lens={describe(self.field(native, 'liquidGlassEffect'))}"
                )
            suppressor = self.field(owner, "scrollableViewNoiseSuppressor")
            if suppressor is not None:
                suppressors[_identity(suppressor)] = suppressor
                lines.append(f"owner={owner_key}; capture_suppressor={describe(suppressor)}")
            factory = self.glass_factory(owner)
            if factory is None:
                continue
            source = self.field(factory, "source")
            factories[_identity(factory)] = (factory, source)
            lines.append(
                f"owner={owner_key}; factory={describe(factory)}; source={describe(source)}; "
                f"allowed={self.field(factory, 'isLiquidGlassEffectAllowed')}"
            )
            for name in (
                "glassBackgroundDrawableFactory",
                "glassBackgroundDrawableFactoryFrosted",
                "iBlur3FactoryLiquidGlass",
                "iBlur3FactoryFrostedLiquidGlass",
                "iBlur3FactoryBlur",
            ):
                candidate = self.field(owner, name)
                if candidate is not None:
                    lines.append(
                        f"owner={owner_key}; {name}={describe(candidate)}; "
                        f"source={describe(self.field(candidate, 'source'))}; "
                        f"allowed={self.field(candidate, 'isLiquidGlassEffectAllowed')}"
                    )
        for key, state in list(getattr(self, '_original_drawables', {}).items()):
            drawable = state[0]
            try:
                effect = self.field(drawable, "liquidGlassEffect")
                saved = getattr(self, '_saved_lenses', {}).get(key)
                props = self.field(drawable, "boundProps")
                source = call(drawable, "getSource")
                if source is not None and not isinstance(source, str):
                    sources[_identity(source)] = source
                node = self.field(drawable, "renderNodeFill")
                render_node = self.field(drawable, "renderNode")
                lines.append(
                    f"drawable={describe(drawable)}; owner={getattr(self, '_drawable_owners', {}).get(key)}; "
                    f"lens={describe(effect)}; saved_lens={describe(saved)}; "
                    f"lens_attempted={key in getattr(self, '_lens_attempted', set())}; "
                    f"shader={describe(self.field(effect, 'shader'))}; "
                    f"effect={describe(self.field(effect, 'effect'))}; "
                    f"lens_node={describe(self.field(effect if effect is not None else saved, 'node'))}; "
                    f"intensity={self.field(props, 'liquidIntensity')}; "
                    f"thickness={self.field(props, 'liquidThickness')}; "
                    f"background={self.field(drawable, 'backgroundColor')}; "
                    f"source={describe(source)}; fill=[{node_state(node)}]; "
                    f"render=[{node_state(render_node)}]; "
                    f"bounds={call(drawable, 'getBounds')}; "
                    f"invalidated={self.field(drawable, 'renderNodeInvalidated')}"
                )
            except Exception as exc:
                lines.append(f"drawable={key}; diagnostic_error={type(exc).__name__}: {exc}")
        for _factory, source in factories.values():
            if source is not None:
                sources[_identity(source)] = source
        for source in sources.values():
            suppressor = self.field(source, "scrollableNoiseSuppressor")
            if suppressor is not None:
                suppressors[_identity(suppressor)] = suppressor
            lines.append(
                f"source={describe(source)}; node=[{node_state(self.field(source, 'renderNode'))}]; "
                f"under={describe(self.field(source, 'underSource'))}; "
                f"fallback={describe(self.field(source, 'fallbackSource'))}; "
                f"noise_suppressor={describe(self.field(source, 'scrollableNoiseSuppressor'))}"
            )
        for suppressor in suppressors.values():
            lines.append(
                f"suppressor={describe(suppressor)}; "
                f"captured_liquid_glass={self.field(suppressor, 'isLiquidGlassEnabled')}; "
                f"simple_mode={self.field(suppressor, 'simpleMode')}; "
                f"downscale_k={self.field(suppressor, 'k')}; "
                f"allow_noise_suppress={self.field(suppressor, 'allowNoiseSuppress')}; "
                f"active_parts={self.field(suppressor, 'rectRenderNodesCount')}"
            )
            try:
                nodes = self.field(suppressor, "resultRenderNodes")
                lines.append(f"result_nodes={len(nodes) if nodes is not None else 'unknown'}")
                parts = self.field(suppressor, "rectRenderNodes")
                if parts is not None:
                    for index in range(min(int(parts.size()), 4)):
                        part = parts.get(index)
                        lines.append(
                            f"part={index}; "
                            f"glass_channel={describe(self.field(part, 'renderNodesForGlass'))}; "
                            f"blur_channel={describe(self.field(part, 'renderNodesForBlur'))}"
                        )
            except Exception as exc:
                lines.append(f"suppressor_detail=unknown({type(exc).__name__}: {exc})")
        return "\n".join(lines)

    def _appearance_settings(self):
        return [
            Header(text="Плотность подложки стекла"),
            Selector(
                key="glass_density_dark",
                text="Тёмная тема",
                default=2,
                items=["15% — прозрачнее", "30%", "45% — баланс", "60%", "75% — плотнее"],
                icon="msg_brightness_low",
                on_change=lambda value: self._on_density_changed("dark", value),
            ),
            Selector(
                key="glass_density_light",
                text="Светлая тема",
                default=2,
                items=["15% — прозрачнее", "30%", "45% — баланс", "60%", "75% — плотнее"],
                icon="msg_brightness_high",
                on_change=lambda value: self._on_density_changed("light", value),
            ),
            Header(text="Цвет подложки стекла"),
            Text(
                text="Тёмная тема",
                subtext=f"#{self._glass_color(True):06X}",
                icon="msg_theme",
                on_click=lambda *_args: self._show_glass_color_picker("dark"),
            ),
            Text(
                text="Светлая тема",
                subtext=f"#{self._glass_color(False):06X}",
                icon="msg_photoeditor",
                on_click=lambda *_args: self._show_glass_color_picker("light"),
            ),
            Header(text="Контур капсул"),
            Selector(
                key="glass_outline",
                text="Выраженность",
                default=3,
                items=["Выключен", "Слабый", "Обычная", "Повышенная"],
                icon="msg_text_outlined",
                on_change=self._on_outline_changed,
            ),
            Header(text="Плавающие даты"),
            Switch(
                key="glass_date_dark_text",
                text="Тёмный текст плавающих дат",
                default=True,
                subtext="Только в светлой теме при включённой стеклянной капсуле даты.",
                icon="msg_calendar",
                on_change=self._on_perf_changed,
            ),
            Header(text="Сервис"),
            Text(text="Сбросить оформление", icon="msg_reset", on_click=self._confirm_reset_appearance),
        ]

    def _on_outline_changed(self, value):
        self.set_setting("glass_outline", int(value), reload_settings=False)
        self._load_perf()
        self._reload_glass()

    def _outline_factor(self):
        return (0.0, 0.5, 1.55, 2.05)[self._appearance.get("outline", 3)]

    def _outline_width_factor(self):
        return (1.0, 1.0, 1.65, 2.15)[self._appearance.get("outline", 3)]

    def _confirm_reset_appearance(self, *_args):
        self._confirm_reset("appearance")

    def _confirm_reset(self, section):
        from ui.alert import AlertDialogBuilder

        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment is not None else None
        if activity is None:
            return
        appearance = {
            "glass_density_dark": 2,
            "glass_density_light": 2,
            "glass_color_dark": 0x393939,
            "glass_color_light": 0xEDEDED,
            "glass_outline": 3,
            "glass_date_dark_text": True,
        }
        performance = {
            item.key: item.default for item in self._performance_settings() if getattr(item, "key", None)
        }
        elements = {item.key: item.default for item in self._glass_settings() if getattr(item, "key", None)}
        elements["glass_emoji_buttons"] = False
        titles = {
            "appearance": "Сбросить оформление",
            "performance": "Сбросить производительность",
            "elements": "Сбросить каталог элементов",
            "all": "Сбросить настройки",
        }
        defaults = {
            "appearance": appearance,
            "performance": performance,
            "elements": elements,
            "all": dict(
                appearance, **performance, **elements, glass_enabled=True, logging_enabled=False, log_limit=1
            ),
        }[section]
        builder = AlertDialogBuilder(activity)
        builder.set_title(titles[section] + "?")
        builder.set_message(
            "Все настройки TeleGlass вернутся к стандартным. Журнал не очищается."
            if section == "all"
            else "Настройки этого раздела вернутся к стандартным. Остальные разделы не изменятся."
        )

        def reset(dialog, _which):
            last_key = next(reversed(defaults))
            for key, value in defaults.items():
                self.set_setting(key, value, reload_settings=key == last_key)
            self._load_perf()
            if section == "all":
                self._logging_enabled = False
                self._load_log_limit()
            self._reload_glass()
            dialog.dismiss()

        builder.set_positive_button("Сбросить", reset)
        builder.set_negative_button("Отмена", lambda dialog, _which: dialog.dismiss())
        builder.show()

    def _glass_color(self, dark):
        return self._appearance.get("color_dark" if dark else "color_light", 0x393939 if dark else 0xEDEDED)

    def _on_glass_color_changed(self, theme, color):
        color = int(color) & 0xFFFFFF
        self._appearance["color_" + theme] = color
        self.set_setting("glass_color_" + theme, color, reload_settings=True)
        self._on_perf_changed()

    def _show_glass_color_picker(self, theme):
        from ui.alert import AlertDialogBuilder

        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment is not None else None
        if activity is None:
            return
        title = "Цвет подложки. " + ("Тёмная тема" if theme == "dark" else "Светлая тема")
        plugin = self
        try:
            from org.telegram.ui.Components import ColorPicker

            class ColorDelegate(
                dynamic_proxy(jclass("org.telegram.ui.Components.ColorPicker$ColorPickerDelegate"))
            ):
                def setColor(self, color, num, applyNow):
                    pass

                def getDefaultColor(self, num):
                    return 0

                def hasChanges(self):
                    return False

                def openThemeCreate(self, share):
                    pass

                def deleteTheme(self):
                    pass

                def rotateColors(self):
                    pass

            picker = ColorPicker(activity, False, ColorDelegate())
            picker.setType(0, False, 1, 1, False, 0, False)
            picker.setColor(to_java_int(0xFF000000 | self._glass_color(theme == "dark")), 0)
            builder = AlertDialogBuilder(activity)
            builder.set_title(title)
            # setView передаёт высоту в LayoutHelper, поэтому здесь dp.
            builder.set_view(picker, height=285)

            def apply_color(dialog, _which):
                plugin._on_glass_color_changed(theme, picker.getColor())
                dialog.dismiss()

            builder.set_positive_button("Применить", apply_color)
            builder.set_negative_button("Отмена", lambda dialog, _which: dialog.dismiss())
            builder.set_on_dismiss_listener(lambda _dialog: picker.hideKeyboard())
            builder.show()
        except Exception as exc:
            self._warn_once("Выбор цвета стекла", exc)
            colors = (0xFFFFFF, 0x000000, 0xFF0000, 0x00FF00, 0x0000FF, 0x800080)
            builder = AlertDialogBuilder(activity)
            builder.set_title(title)

            def select_color(dialog, index):
                plugin._on_glass_color_changed(theme, colors[index])
                dialog.dismiss()

            builder.set_items(["Белый", "Чёрный", "Красный", "Зелёный", "Синий", "Фиолетовый"], select_color)
            builder.set_negative_button("Отмена", lambda dialog, _which: dialog.dismiss())
            builder.show()

    def _on_density_changed(self, theme, value):
        self.set_setting("glass_density_" + theme, int(value), reload_settings=False)
        self._on_perf_changed()

    def _glass_density(self, dark):
        return (0.15, 0.30, 0.45, 0.60, 0.75)[self._appearance.get("dark" if dark else "light", 2)]

    def _open_performance_settings(self):
        # SDK может скрыть Selector, пока его значение не сохранено.
        for key, default in (("perf_glass_fps", 5), ("perf_round_fps", 7)):
            index = self._setting(key, None)
            if type(index) is not int or not 0 <= index < len(GLASS_FPS):
                self.set_setting(key, default, reload_settings=False)
        return self._performance_settings()

    def _performance_settings(self):
        return [
            Header(text="Производительность"),
            Selector(
                key="perf_lens",
                text="Преломление",
                default=0,
                items=["Полное", "Умеренное", "Только размытие"],
                icon="msg_blur_radial",
                on_change=self._on_perf_changed,
            ),
            Switch(
                key="perf_native_dates",
                text="Облегчённые даты",
                default=True,
                subtext="Заменяет статические даты штатными. Плавающая дата остаётся стеклянной.",
                icon="msg_calendar",
                on_change=self._on_perf_changed,
            ),
            Switch(
                key="perf_no_shadow",
                text="Не рисовать тени стекла",
                default=True,
                subtext="Убирает тени капсул. Размытие и преломление сохраняются.",
                icon="msg_brightness_low",
                on_change=self._on_perf_changed,
            ),
            Switch(
                key="perf_round_light",
                text="Облегчать стекло при кружке",
                default=True,
