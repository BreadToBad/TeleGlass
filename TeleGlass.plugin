            ),
            Header(text="Сервис"),
            Text(
                text="Сбросить производительность",
                icon="msg_reset",
                on_click=lambda *_args: self._confirm_reset("performance"),
            ),
        ]

    def _load_perf(self):
        self._java_tabs_targets.clear()
        self._java_input_targets.clear()
        try:
            outline = int(self._setting("glass_outline", 3))
        except (TypeError, ValueError, OverflowError):
            outline = 3
        self._appearance["outline"] = max(0, min(3, outline))
        self._appearance["date_dark_text"] = bool(self._setting("glass_date_dark_text", True))
        for theme in ("dark", "light"):
            try:
                index = int(self._setting("glass_density_" + theme, 2))
            except (TypeError, ValueError, OverflowError):
                index = 2
            self._appearance[theme] = max(0, min(4, index))
            default_color = 0x393939 if theme == "dark" else 0xEDEDED
            try:
                color = int(self._setting("glass_color_" + theme, default_color))
            except (TypeError, ValueError, OverflowError):
                color = default_color
            self._appearance["color_" + theme] = color if 0 <= color <= 0xFFFFFF else default_color
        disabled = (
            "glass_profile_tabs",
            "glass_dates",
            "glass_side",
            "glass_folders",
            "glass_main_header",
            "glass_archive_header",
            "glass_main_search",
            "glass_bot_photo",
            "glass_emoji_tabs",
            "glass_emoji_buttons",
            "glass_photo_caption",
            "glass_photo_tools",
            "glass_photo_send",
            "glass_report_spam",
        )
        self._element_flags = {
            key: bool(self._setting(key, key not in disabled))
            for key in (
                "glass_forward",
                "glass_topics",
                "glass_profile_tabs",
                "glass_folders",
                "glass_main_nav",
                "glass_main_header",
                "glass_archive_header",
                "glass_header",
                "glass_main_search",
                "glass_input",
                "glass_mentions",
                "glass_dates",
                "glass_pinned",
                "glass_player",
                "glass_translate",
                "glass_bot_photo",
                "glass_side",
                "glass_bottom",
                "glass_report_spam",
                "glass_settings_header",
                "glass_emoji_tabs",
                "glass_emoji_buttons",
                "glass_photo_caption",
                "glass_photo_tools",
                "glass_photo_send",
                "glass_attach",
            )
        }
        emoji_enabled = self._element_flags["glass_emoji_tabs"] or self._element_flags["glass_emoji_buttons"]
        for key in ("glass_emoji_tabs", "glass_emoji_buttons"):
            if self._element_flags[key] != emoji_enabled:
                self.set_setting(key, emoji_enabled, reload_settings=False)
                self._element_flags[key] = emoji_enabled
        self._perf = {
            "native_dates": bool(self._setting("perf_native_dates", True)),
            "lens": int(self._setting("perf_lens", 0)),
            "no_shadow": bool(self._setting("perf_no_shadow", True)),
            "round_light": bool(self._setting("perf_round_light", True)),
        }
        self._native_dates_gate[0] = 1 if self._perf["native_dates"] else 0
        for key, default in (("glass_fps", 5), ("round_fps", 7)):
            try:
                index = int(self._setting("perf_" + key, default))
            except (TypeError, ValueError, OverflowError):
                index = default
            self._perf[key] = GLASS_FPS[index if 0 <= index < len(GLASS_FPS) else default]
        self._side_draw_enabled[0] = int(self._element_flags["glass_side"])

    def _on_capture_perf_changed(self, *_args):
        self.schedule(self._reload_glass, 0)

    def _update_capture_intervals(self):
        fps = self._perf.get("glass_fps", 60)
        round_fps = self._perf.get("round_fps", 30) if self._round_video_active else 0
        # Захват оставляем включённым: без него Blur3 сереет при открытии чата.
        if round_fps:
            fps = min(fps, round_fps) if fps else round_fps
        interval = int(1_000_000_000 / fps) if fps else 0
        for state in self._capture_states.values():
            if state["clock"][1] != interval:
                state["handler"].removeCallbacks(state["callback"])
                state["clock"][0] = state["clock"][4] = 0
                state["clock"][1] = interval
        for state in getattr(self, "_media_glass", {}).values():
            state["gate"][6][1] = interval

    def _on_master_changed(self, value):
        enabled = bool(value)
        self.log(f"Настройки: общий выключатель; enabled={enabled}")
        self.set_setting("glass_enabled", enabled, reload_settings=False)

        def apply():
            targets = list(self._known_fragments.values())
            targets += list(self._main_owners.values()) + list(self._folder_owners.values())
            targets += [entry["fragment"] for entry in self._main_headers.values()]
            targets += [entry["fragment"] for entry in self._main_searches.values()]
            current = get_last_fragment()
            if current is not None:
                targets.append(current)
            self._active = False
            self.restore_all()
            self._active = enabled
            if enabled:
                self._load_perf()
                self._round_start()
                self._schedule_round_poll()
                for fragment in {_identity(f): f for f in targets if f is not None}.values():
                    self._patch_chat(fragment)
                    self._discover_main_nav(fragment)

        self.schedule(apply, 0)

    def _reload_glass(self, *_args):
        """Пересоздать стекло без перезапуска клиента."""
        self.log("Оформление: пересоздание стекла")
        targets = list(self._known_fragments.values())
        targets += [fragment for _view, fragment in self._owners.values()]
        targets += [
            entry["fragment"] for entry in chain(self._top_surfaces.values(), self._pinned_surfaces.values())
        ]
        targets += list(self._main_owners.values()) + list(self._folder_owners.values())
        targets += [entry["fragment"] for entry in self._main_headers.values()]
        targets += [entry["fragment"] for entry in self._main_searches.values()]
        current = get_last_fragment()
        if current is not None:
            targets.append(current)
        self._active = False
        self.restore_all()
        self._active = bool(self._setting("glass_enabled", True))
        if not self._active:
            return
        self._load_perf()
        self._round_start()
        self._schedule_round_poll()
        for fragment in {_identity(f): f for f in targets if f is not None}.values():
            self._patch_chat(fragment)
            self._discover_main_nav(fragment)

    def _on_perf_changed(self, *_args):
        self.schedule(self._apply_perf_changed, 0)

    def _apply_perf_changed(self):
        self._load_perf()
        self._round_start(force=True)
        materials = list(self._styled_glass.items())
        self._styled_glass.clear()
        self._lens_attempted.clear()
        self._provider_cache.clear()
        self._date_materials.clear()
        if self._active:
            fragments = dict(self._known_fragments)
            fragments.update(self._main_owners)
            fragments.update(self._folder_owners)
            for key, (drawable, sig, *_rest) in materials:
                fragment = fragments.get(self._drawable_owners.get(key))
                if fragment is not None:
                    self.style_glass_drawable(fragment, drawable, sig[2], variant=sig[6])
                    drawable.invalidateSelf()
        for entry in self._patched_dates.values():
            cell = entry.get("cell")
            if cell is not None:
                cell.invalidate()
        self._on_setting_changed()

