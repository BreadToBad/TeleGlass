JAVA_RUNTIME_DEX = ''
# Java-фильтр отсекает лишние захваты до входа в Python.
CAPTURE_GATE = """
state = object.get(this);
if (state != null) {
    clock = state[0];
    stats = state[6];
    round = state[7][0] != 0;
    stats[0] = stats[0] + 1;
    if (clock[1] < 0) { stats[1] = stats[1] + 1; param.setResult(false); return true; }
    if (clock[1] == 0) { return false; }
    now = java.lang.System.nanoTime();
    width = param.args[1]; height = param.args[2];
    geometry = state[4]; count = geometry[1].getInt(this);
    bounds = state[5];
    urgent = width != clock[2] || height != clock[3] || bounds.length != count * 4;
    if (bounds.length != count * 4) { bounds = new long[count * 4]; state[5] = bounds; }
    for (i = 0; i < count; i++) {
        part = geometry[0].get(i); rect = geometry[2].get(part);
        urgent = urgent || !geometry[3].get(part).hasDisplayList();
        if (!round) {
            urgent = urgent || bounds[i * 4] != rect.left || bounds[i * 4 + 1] != rect.top
                || bounds[i * 4 + 2] != rect.right || bounds[i * 4 + 3] != rect.bottom;
        }
    }
    if (clock[0] != 0 && !urgent && now - clock[0] < clock[1]) {
        if (clock[4] == 0) {
            clock[4] = 1;
            state[2].postDelayed(state[3], (clock[1] - (now - clock[0])) / 1000000 + 1);
        }
        stats[2] = stats[2] + 1;
        param.setResult(false);
    } else {
        if (clock[4] != 0) { state[2].removeCallbacks(state[3]); clock[4] = 0; }
        clock[0] = now; clock[2] = width; clock[3] = height;
        for (i = 0; i < count; i++) {
            rect = geometry[2].get(geometry[0].get(i));
            bounds[i * 4] = rect.left; bounds[i * 4 + 1] = rect.top;
            bounds[i * 4 + 2] = rect.right; bounds[i * 4 + 3] = rect.bottom;
        }
        stats[3] = stats[3] + 1;
    }
}
return false;
"""


def to_java_int(val: int) -> int:
    val = val & 0xFFFFFFFF
    if val >= 0x80000000:
        val -= 0x100000000
    return int(val)


def dp(val: float) -> float:
    try:
        return float(AndroidUtilities.dpf2(float(val)))
    except Exception:
        return float(val * 2.5)


def _identity(obj: Any) -> int:
    if obj is None:
        return 0
    try:
        return int(System.identityHashCode(obj))
    except Exception:
        return id(obj)


def _is_dark() -> bool:
    try:
        return bool(Theme.isCurrentThemeDark())
    except Exception:
        return True


def create_glass_rim(
    radius: float, width: int, height: int, stroke_width: float = 0.6
) -> Optional[LayerDrawable]:
    """Контур для резервных поверхностей и дат, без заливки поверх стекла."""
    if width <= 0 or height <= 0:
        return None
    try:
        radius = max(0.0, min(float(radius), min(width, height) / 2.0))
        stroke = max(1, int(dp(stroke_width)))
        dark = _is_dark()
        rim = GradientDrawable()
        rim.setShape(GradientDrawable.RECTANGLE)
        rim.setColor(0)
        rim_alpha = 0x18 if dark else 0x12
        rim_color = (rim_alpha << 24) | (0xFFFFFF if dark else 0x000000)
        rim.setStroke(stroke, to_java_int(rim_color))
        rim.setCornerRadius(radius)
        drawable = LayerDrawable(jarray(jclass("android.graphics.drawable.Drawable"))([rim]))
        drawable.setLayerInset(0, stroke, stroke, stroke, stroke)
        return drawable
    except Exception:
        return None


