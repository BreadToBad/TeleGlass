    def on_plugin_load(self):
        self._lifecycle_token = object()
        try:
            self._native_liquid_glass = bool(jclass("org.telegram.messenger.LiteMode").isEnabled(1 << 18))
        except Exception as exc:
            self._warn_once("Штатная настройка стекла", exc)
        self._load_java_runtime()
        self._transfer_alive = True
        self._register_settings_file()
        self._logging_enabled = bool(self._setting("logging_enabled", False))
        self._load_log_limit()
        self._load_perf()
        self._active = bool(self._setting("glass_enabled", True))
        self._round_start()
        self._schedule_round_poll()
        self._schedule_diag_heartbeat()
        self.log(
            f"Плагин: загрузка; version={__version__}; active={self._active}; "
            f"elements={self._element_flags}; performance={self._perf}"
        )
        try:
            self.install_hooks()
            self.log("Хуки: установлены; group=основные")
            self._install_main_nav_hooks()
            self.log("Хуки: установлены; group=главная навигация")
            self._install_extra_hooks()
            self.log("Хуки: установлены; group=дополнительные элементы")
        except Exception as exc:
            self._log_error("Загрузка плагина", exc)
            raise
        fragment = get_last_fragment()
        if fragment is not None:
            self._queue_chat(fragment)
            self.schedule(lambda: self._discover_main_nav(fragment), 0)
        for delay in (64, 180, 650):
            self.schedule(lambda: self._discover_main_nav(get_last_fragment()), delay)
        self.log("Плагин: загружен")

    def on_plugin_unload(self):
        self._transfer_alive = False
        self._round_poll_scheduled = False
        if self._settings_file_secret is not None:
            try:
                from file_utils import FilesController

                FilesController.unregister("teleglass", self._settings_file_secret)
            except Exception as exc:
                self._log_error("Удаление обработчика настроек", exc)
            self._settings_file_secret = None
        self.log("Плагин: выгрузка")
        self._active = False
        self._lifecycle_token = object()

        plugin = self

        # SDK освобождает Python-прокси сразу после возврата из on_plugin_unload.
        class Cleanup(dynamic_proxy(jclass("java.lang.Runnable"))):
            def run(self):
                plugin.restore_all()

        cleanup = Cleanup()
        if self._java_runtime is not None:
            self._java_runtime.onUiAndWait(cleanup)
        else:
            # Без Java-моста тоже ждём завершения очистки в UI-потоке.
            Looper = jclass("android.os.Looper")
            if Looper.myLooper() == Looper.getMainLooper():
                cleanup.run()
            else:
                task = jclass("java.util.concurrent.FutureTask")(cleanup, None)
                if not jclass("android.os.Handler")(Looper.getMainLooper()).post(task):
                    raise RuntimeError("UI handler rejected TeleGlass cleanup")
                interrupted = False
                try:
                    while True:
                        try:
                            task.get()
                            break
                        except jclass("java.lang.InterruptedException"):
                            interrupted = True
                finally:
                    if interrupted:
                        jclass("java.lang.Thread").currentThread().interrupt()

    def create_settings(self):
        # Меню собирается лениво; View создаём в обработчиках нажатий.
        return [
            Switch(
                key="glass_enabled",
                text="Включить жидкое стекло",
                default=True,
                icon="msg_photo_blur",
                on_change=self._on_master_changed,
