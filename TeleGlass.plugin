            Text(text="Пресеты настроек", icon="msg_customize", on_click=self._show_settings_presets),
            Header(text="Основное"),
            Text(text="Каталог элементов", icon="msg_list", create_sub_fragment=self._glass_settings),
            Text(text="Внешний вид", icon="msg_theme", create_sub_fragment=self._appearance_settings),
            Text(
