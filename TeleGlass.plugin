                on_change=self._on_emoji_changed,
            ),
            Switch(
                key="glass_photo_caption",
                text="Подпись к фото",
                default=False,
                subtext="Добавляет стекло полю подписи и его кнопкам.",
                icon="msg_photo_text2",
                on_change=self._on_setting_changed,
            ),
            Switch(
                key="glass_photo_tools",
                text="Инструменты просмотра фото",
                default=False,
                subtext="Оформляет панель инструментов просмотра изображения.",
                icon="msg_photoeditor",
                on_change=self._on_setting_changed,
            ),
            Switch(
                key="glass_photo_send",
                text="Отправка фото",
                default=False,
                subtext="Оформляет кнопку отправки в окне выбора изображения.",
                icon="msg_send",
                on_change=self._on_setting_changed,
            ),
            Switch(
                key="glass_attach",
                text="Панель вложений",
                default=True,
                subtext="Оформляет кнопки панели добавления медиа и файлов.",
                icon="msg_input_attach2",
                on_change=self._on_setting_changed,
            ),
            Header(text="Сервис"),
            Text(
                text="Сбросить каталог элементов",
                icon="msg_reset",
                on_click=lambda *_args: self._confirm_reset("elements"),
            ),
        ]

    def _setting(self, key, default=True):
        try:
            return self.get_setting(key, default)
        except Exception:
            return default

    def _enabled(self, key):
        return self._active and self._element_flags.get(key, True)

    def _on_setting_changed(self, *_args):
        # on_change приходит из PluginsQueue; View меняем только в UI-потоке.
        self.schedule(self._apply_setting_changed, 0)

    def _apply_setting_changed(self):
        previous = self._element_flags.copy()
        self._load_perf()
        # Снимаем отключённое стекло сразу, не ждём следующего layout/updateColors.
        if self._active and any(
            previous.get(key, True) and not self._element_flags.get(key, True) for key in self._element_flags
        ):
            # _reload_glass запомнит открытые экраны и вернёт оставшиеся эффекты.
            self._reload_glass()
            return
        self.log(
            f"Настройки: обновлены; elements={self._element_flags}; performance={self._perf}; "
            f"appearance={self._appearance}"
        )
        for owner in list(self._main_owners.values()):
            self.schedule(lambda owner=owner: self._style_main_nav(owner), 0)
        for owner in list(self._folder_owners.values()):
            self.schedule(lambda owner=owner: self._style_folders(owner), 0)
        for entry in list(self._main_headers.values()):
            self.schedule(
                lambda owner=entry["fragment"]: self._style_main_header(owner, allow_archive=True), 0
            )
        for entry in list(self._main_searches.values()):
            self.schedule(
                lambda owner=entry["fragment"]: self._style_main_search(owner, allow_archive=True), 0
            )
        fragments = dict(self._known_fragments)
        fragments.update({_identity(fragment): fragment for _view, fragment in self._owners.values()})
        fragment = get_last_fragment()
        if fragment is not None:
            fragments[_identity(fragment)] = fragment
        for fragment in fragments.values():
            self._queue_chat(fragment)

    def _on_emoji_changed(self, value):
        for key in ("glass_emoji_tabs", "glass_emoji_buttons"):
            self.set_setting(key, bool(value), reload_settings=False)
        self._on_setting_changed()

    def _on_folders_changed(self, value):
        self.set_setting("glass_folders", bool(value), reload_settings=False)
        self._on_setting_changed()

    def _on_main_header_changed(self, value):
        self.set_setting("glass_main_header", bool(value), reload_settings=False)
        self._on_setting_changed()

    def _on_archive_header_changed(self, value):
        self.set_setting("glass_archive_header", bool(value), reload_settings=False)
        self._on_setting_changed()

    def _on_main_search_changed(self, value):
        self.set_setting("glass_main_search", bool(value), reload_settings=False)
        self._on_setting_changed()

    # Java-мост и общие материалы

    def _load_java_runtime(self):
        try:
            data = jclass("java.util.Base64").getDecoder().decode(JAVA_RUNTIME_DEX)
            parent = jclass("org.telegram.messenger.AndroidUtilities").getClass().getClassLoader()
            loader = jclass("dalvik.system.InMemoryDexClassLoader")(
                jclass("java.nio.ByteBuffer").wrap(data), parent
            )
            # shortcut: регистрация зависит от Chaquopy cls_dict; сменить при появлении публичного API.
            runtime = None
            for suffix in (
                "",
                "$Colors",
                "$FadeSource",
                "$Refresh",
                "$Nav",
                "$ListDraw",
                "$InputGate",
                "$BulletinCapture",
                "$SettingsInvalidation",
                "$TabsGate",
                "$TopFade",
                "$PhotoGate",
                "$BotMenus",
                "$StockPanels",
            ):
                name = JAVA_RUNTIME_NAME + suffix
                cls = loader.loadClass(name)
                wrapped = jclass(name, {"_chaquopy_j_klass": cls._chaquopy_this})
                if not suffix:
                    runtime = wrapped
            runtime.colors(0, 0, 0, 0).getBackgroundColor()
            runtime.logging(bool(self._setting("logging_enabled", False)))
            self._java_photo_gate = runtime.photo()
            self._java_bot_menus = runtime.botMenus()
            self._java_stock_panels = runtime.stockPanels()
            self._java_runtime = runtime
            self._java_runtime_status = "active:" + JAVA_RUNTIME_NAME
        except Exception as exc:
            self._java_runtime = None
            self._java_photo_gate = None
            self._java_bot_menus = None
            self._java_stock_panels = None
            self._java_runtime_status = "fallback:" + type(exc).__name__
            self._warn_once("Java-мост недоступен, используем Python", exc)

    def field(self, obj, name):
        if obj is None:
            return None
        try:
            return getattr(obj, name)
        except Exception:
            pass
        try:
            member = self._java_field(obj, name)
            if member is not None:
                return member.get(obj)
            if self._field_cache.get((obj.getClass(), name)) is not False:
                return None
        except Exception:
            pass
        # Старый SDK иногда читает поля, закрытые для Java reflection.
        try:
            return get_private_field(obj, name)
        except Exception:
            return None

    def _java_field(self, obj, name):
        cls = obj.getClass()
        key = (cls, name)
        if key in self._field_cache:
            self._field_cache.move_to_end(key)
            return self._field_cache[key] or None
        member = None
        for _ in range(12):
            if cls is None:
                break
            try:
                member = cls.getDeclaredField(name)
            except Exception:
                cls = cls.getSuperclass()
                continue
            try:
                member.setAccessible(True)
            except Exception:
                member = False  # Поле есть, но SDK ещё должен попробовать свой способ чтения.
            break
        # Промахи тоже кэшируем: этот путь вызывается при отрисовке.
        self._field_cache[key] = member
        if len(self._field_cache) > 512:
            self._field_cache.popitem(last=False)
        return member or None

    def _set_java_field(self, obj, name, value, kind):
        try:
            member = self._java_field(obj, name)
            if member is None:
                return False
            if kind == "int":
                member.setInt(obj, to_java_int(value))
            elif kind == "bool":
                member.setBoolean(obj, bool(value))
            elif kind == "float":
                member.setFloat(obj, float(value))
            else:
                member.set(obj, value)
            return True
        except Exception:
            pass
        return False

    def schedule(self, callback, delay_ms=16):
        token = self._lifecycle_token

        def run():
            if self._lifecycle_token is not token:
                return
            try:
                callback()
            except Exception as exc:
                self._log_error("Отложенная задача", exc)

        try:
            from android_utils import run_on_ui_thread

            run_on_ui_thread(run, int(delay_ms))
        except Exception:
            try:
                AndroidUtilities.runOnUIThread(run, int(delay_ms))
            except Exception as exc:
                self._warn_once("Планировщик UI", exc)

    def glass_factory(self, fragment):
        if fragment is None:
            return None
        return (
            self.field(fragment, "glassBackgroundDrawableFactory")
            or self.field(fragment, "iBlur3FactoryLiquidGlass")
            or self.field(fragment, "glassBackgroundDrawableFactoryFrosted")
            or self.field(fragment, "iBlur3FactoryFrostedLiquidGlass")
            or self.field(fragment, "iBlur3FactoryBlur")
        )

    def _drop_capture_limit(self, key):
        state = self._capture_states.pop(key, None)
        if state is None:
            return
        self._attach_targets.remove(state["owner"])
        self._capture_targets.remove(state["suppressor"])
        self._capture_owners.remove(state["owner"])
        state["clock"][4] = 0
        state["handler"].removeCallbacks(state["callback"])

    def _configure_capture_limit(self, fragment):
        key = _identity(fragment)
        suppressor = self.field(fragment, "scrollableViewNoiseSuppressor")
        state = self._capture_states.get(key)
        if suppressor is None:
            if state is not None:
                self._drop_capture_limit(key)
            return
        if state is not None:
            if _identity(state["suppressor"]) == _identity(suppressor):
                return
            self._drop_capture_limit(key)
        try:
            cls = fragment.getClass()
            class_name = str(cls.getName())
            if class_name in self._capture_unavailable:
                return
            root = self.field(fragment, "fragmentView") or self.field(fragment, "containerView")
            if root is None and class_name.endswith(".EmojiView"):
                root = fragment
            parts = self.field(suppressor, "rectRenderNodes")
            if root is None or parts is None or parts.isEmpty():
                return
            method = self._capture_methods.get(cls)
            owner_class = cls
            while cls is not None and method is None:
                for candidate in cls.getDeclaredMethods():
                    name = str(candidate.getName())
                    if name not in (
                        "blur3_InvalidateBlur",
                        "invalidateBlurCaptures",
                        "invalidateMergedVisibleBlurredPositionsAndSources",
                    ):
                        continue
                    types = candidate.getParameterTypes()
                    if str(candidate.getReturnType().getName()) == "void" and (
                        (name == "blur3_InvalidateBlur" and len(types) == 0)
                        or (
                            name
                            in ("invalidateBlurCaptures", "invalidateMergedVisibleBlurredPositionsAndSources")
                            and len(types) == 1
                            and str(types[0].getName()) == "int"
                        )
                    ):
                        method = candidate
                        break
                cls = cls.getSuperclass()
            if method is None:
                self._capture_unavailable.add(class_name)
                return
            self._capture_methods[owner_class] = method
            if self._capture_targets is None:
                self._capture_targets = jclass("java.util.IdentityHashMap")()
                self._capture_owners = jclass("java.util.IdentityHashMap")()
            method.setAccessible(True)
            capture_class = suppressor.getClass()
            capture = self._capture_render_methods.get(capture_class)
            if capture is None:
                capture = next(
                    (
                        m
                        for m in capture_class.getDeclaredMethods()
                        if str(m.getName()) == "invalidateResultRenderNodes"
                        and str(m.getReturnType().getName()) == "boolean"
                        and len(m.getParameterTypes()) == 3
                        and str(m.getParameterTypes()[0].getName()).endswith(".IBlur3Capture")
                        and all(str(t.getName()) == "int" for t in m.getParameterTypes()[1:])
                    ),
                    None,
                )
            if capture is None:
                raise RuntimeError("Нет совместимого метода захвата Blur3")
            self._capture_render_methods[capture_class] = capture
            parts = self.field(suppressor, "rectRenderNodes")
            count = self._java_field(suppressor, "rectRenderNodesCount")
            if parts is None or count is None or parts.isEmpty():
                return
            position = self._java_field(parts.get(0), "position")
            node = self._java_field(parts.get(0), "renderNode")
            if position is None or node is None:
                raise RuntimeError("Нет координат захвата Blur3")
            hook_key = (str(capture.getDeclaringClass().getName()), str(capture.getName()))
            if hook_key not in self._capture_hooks:
                capture.setAccessible(True)
                handle = self.hook_method(
                    capture,
                    before=lambda _param: None,
                    before_filters=[HookFilter.Condition(CAPTURE_GATE, object=self._capture_targets)],
                )
                if not handle:
                    raise RuntimeError("SDK не установил ограничитель захвата Blur3")
                self._capture_hooks.add(hook_key)
            # Смена темы и геометрии требует свежего фона, прокрутка подчиняется лимиту.
            owner_hook_key = (str(method.getDeclaringClass().getName()), str(method.getName()))
            if len(method.getParameterTypes()) and owner_hook_key not in self._capture_hooks:
                # Биты 1/2 — содержимое и позиции. Сами границы проверит CAPTURE_GATE.
                scroll_mask = 3
                handle = self.hook_method(
                    method,
                    before=lambda _param: None,
                    before_filters=[
                        HookFilter.Condition(
                            "state = object.get(this); if (state != null && state[1][0] == 0 && (param.args[0] & ~"
                            + str(scroll_mask)
                            + ") != 0) { state[0][0] = 0; } return false;",
                            object=self._capture_owners,
                        )
                    ],
                )
                if not handle:
                    raise RuntimeError("SDK не установил обход лимита для геометрии")
                self._capture_hooks.add(owner_hook_key)
            clock = jarray(jclass("java.lang.Long").TYPE)([0, 0, 0, 0, 0])
            handler = jclass("android.os.Handler")(jclass("android.os.Looper").getMainLooper())
            args = jarray(jclass("java.lang.Object"))([jint(1)] if len(method.getParameterTypes()) else [])
            plugin = self

            class Refresh(dynamic_proxy(jclass("java.lang.Runnable"))):
                def run(self):
                    state = plugin._capture_states.get(key)
                    if state is None or state["callback"] is not self:
                        return
                    if clock[4] == 0:
                        return
                    clock[4] = 0
                    if not plugin._active:
                        return
                    try:
                        if root.isAttachedToWindow() and root.isShown():
                            clock[0] = 0
                            method.invoke(fragment, args)
                            root.invalidate()
                    except Exception as exc:
                        plugin._drop_capture_limit(key)
                        plugin._warn_once("Отложенный захват Blur3", exc)

            failure_proxy = None
            if self._java_runtime is not None:
                plugin = self

                class CaptureFailure(dynamic_proxy(jclass("java.lang.Runnable"))):
                    def run(self):
                        plugin._drop_capture_limit(key)

                failure_proxy = CaptureFailure()
            callback = (
                self._java_runtime.refresh(clock, root, fragment, method, args, failure_proxy)
                if self._java_runtime is not None
                else Refresh()
            )
            stats = jarray(jclass("java.lang.Long").TYPE)([0, 0, 0, 0])
            self._capture_states[key] = {
                "owner": fragment,
                "suppressor": suppressor,
                "clock": clock,
                "handler": handler,
                "callback": callback,
                "stats": stats,
            }
            geometry = jarray(jclass("java.lang.Object"))([parts, count, position, node])
            self._capture_targets.put(
                suppressor,
                jarray(jclass("java.lang.Object"))(
                    [
                        clock,
                        root,
                        handler,
                        callback,
                        geometry,
                        jarray(jclass("java.lang.Long").TYPE)([]),
                        stats,
                        self._round_capture_gate,
                    ]
                ),
            )
            self._capture_owners.put(
                fragment,
                jarray(jclass("java.lang.Object"))([clock, self._round_capture_gate]),
            )
            self._update_capture_intervals()
        except Exception as exc:
            self._drop_capture_limit(key)
            if "class_name" in locals():
                self._capture_unavailable.add(class_name)
            self._warn_once("Ограничение частоты захвата Blur3", exc)

    def _repair_blur_source(self, fragment):
        if not self._active or fragment is None:
            return
        self._configure_capture_limit(fragment)
        old = self.field(fragment, "scrollableViewNoiseSuppressor")
        if old is None or self.field(old, "isLiquidGlassEnabled") != False:
            return
        failure_key = f"Восстановление Blur3 после холодного запуска #{_identity(old)}"
        if failure_key in self._warned:
            return
        # Старый suppressor запомнил LiteMode до загрузки плагина. Меняем и его, не только линзу.
        changed = []
        try:
            simple = self.field(old, "simpleMode")
            noise = self.field(old, "allowNoiseSuppress")
            if simple is None or noise is None:
                raise RuntimeError("Неизвестная конфигурация Blur3")
            cls = jclass("org.telegram.ui.Components.blur3.DownscaleScrollableNoiseSuppressor")
            fresh = cls(bool(simple), bool(noise))
            if not self.field(fresh, "isLiquidGlassEnabled"):
                # ART мог встроить старый isEnabled: вместе с флагом нужны два канала.
                RenderNode = jclass("android.graphics.RenderNode")
                nodes = jarray(RenderNode)([RenderNode("TeleGlass clear"), RenderNode("TeleGlass frosted")])
                for name, value, kind in (
                    ("isLiquidGlassEnabled", True, "bool"),
                    ("k", 1, "int"),
                    ("resultRenderNodes", nodes, "obj"),
                ):
                    if not self._set_java_field(fresh, name, value, kind):
                        raise RuntimeError("Не удалось подготовить Blur3: " + name)
            if (
                not self.field(fresh, "isLiquidGlassEnabled")
                or self.field(fresh, "k") != 1
                or len(self.field(fresh, "resultRenderNodes")) != 2
            ):
                raise RuntimeError("Новый Blur3 не создал режим стекла")
            positions = jclass("java.util.ArrayList")()
            parts = self.field(old, "rectRenderNodes")
            count = self.field(old, "rectRenderNodesCount")
            if parts is None or count is None:
                raise RuntimeError("Недоступны области захвата Blur3")
            for index in range(int(count)):
                positions.add(jclass("android.graphics.RectF")(self.field(parts.get(index), "position")))
            fresh.setupRenderNodes(positions, int(count))
            fresh_parts = self.field(fresh, "rectRenderNodes")
            if any(
                self.field(fresh_parts.get(index), "renderNodesForGlass") is None
                for index in range(int(count))
            ):
                raise RuntimeError("Blur3 не создал отдельный канал стекла")
            targets = [(fragment, "scrollableViewNoiseSuppressor", old)]
            for name in (
                "glassBackgroundSourceRenderNode",
                "glassBackgroundSourceFrostedRenderNode",
                "iBlur3SourceGlass",
                "iBlur3SourceGlassFrosted",
                "blurredBackgroundSourceRenderNode",
            ):
                source = self.field(fragment, name)
                if source is not None and _identity(
                    self.field(source, "scrollableNoiseSuppressor")
                ) == _identity(old):
                    targets.append((source, "scrollableNoiseSuppressor", old))
            for obj, name, original in targets:
                self._snapshot_object(obj, (name,), fragment)
                if not self._set_java_field(obj, name, fresh, "obj"):
                    raise RuntimeError("Не удалось подключить Blur3: " + name)
                changed.append((obj, name, original))
            self._configure_capture_limit(fragment)

            def refresh():
                if _identity(self.field(fragment, "scrollableViewNoiseSuppressor")) != _identity(fresh):
                    return
                try:
                    # Пересчёт оставляем Telegram: он обновит и области, и подписки.
                    for name in ("iBlur3SourceGlass", "iBlur3SourceGlassFrosted"):
                        node = self.field(self.field(fragment, name), "renderNode")
                        if node is not None:
                            node.discardDisplayList()
                    names = {
                        "blur3_InvalidateBlur": [],
                        "invalidateBlurCaptures": [jint(7)],
                        # Без jint мост кладёт Python int в Object[] как Long, а не Integer.
                        "invalidateMergedVisibleBlurredPositionsAndSources": [jint(7)],
                    }
                    java_cls = fragment.getClass()
                    refresh_method = None
                    while java_cls is not None and refresh_method is None:
                        for method in java_cls.getDeclaredMethods():
                            args = names.get(str(method.getName()))
                            if args is not None and len(method.getParameterTypes()) == len(args):
                                refresh_method = method
                                break
                        if refresh_method is None:
                            java_cls = java_cls.getSuperclass()
                    if refresh_method is None:
                        raise RuntimeError("Не найден штатный пересчёт Blur3")
                    refresh_method.setAccessible(True)
                    refresh_method.invoke(fragment, jarray(jclass("java.lang.Object"))(args))
                    view = self.field(fragment, "fragmentView")
                    if view is not None:
                        view.invalidate()
                    self.log("Blur3: восстановлен после холодного запуска; liquid=True; k=1; channels=2")
                except Exception as exc:
                    for obj, name, original in reversed(changed):
                        if not self._set_java_field(obj, name, original, "obj"):
                            self._warn_once("Откат восстановления Blur3", name)
                    self._drop_capture_limit(_identity(fragment))
                    self._warn_once(failure_key, exc)

            self.schedule(refresh, 0)
        except Exception as exc:
            for obj, name, original in reversed(changed):
                if not self._set_java_field(obj, name, original, "obj"):
                    self._warn_once("Откат восстановления Blur3", name)
            self._drop_capture_limit(_identity(fragment))
            self._warn_once(failure_key, exc)

    def _scale_alpha(self, color, factor):
        alpha = (int(color) >> 24) & 0xFF
        rgb = int(color) & 0x00FFFFFF
        return to_java_int((max(0, min(255, int(alpha * factor))) << 24) | rgb)

    def make_provider(self, variant=""):
        try:
            dark = variant == "photo" or _is_dark()
            edge_alpha = 0.82 if variant == "pinned" else 1.0
            density = self._glass_density(dark)
            if variant == "emoji":
                # На пёстрой сетке эмодзи нужна более плотная заливка.
                density = 1.0 - (1.0 - density) * 0.5
            if dark:
                rim_top, rim_bottom, shadow = DARK_RIM_TOP, DARK_RIM_BOTTOM, DARK_SHADOW
            else:
                rim_top, rim_bottom, shadow = LIGHT_RIM_TOP, LIGHT_RIM_BOTTOM, LIGHT_SHADOW
            tint = self._glass_color(dark) | int(255 * density) << 24
            if variant == "bottom_container":
                # Общему контуру заливка не нужна: она уже есть у каждой кнопки.
                tint = to_java_int(tint & 0x00FFFFFF)
            else:
                tint = to_java_int(tint)
            rim_top = self._scale_alpha(rim_top, edge_alpha * 0.55 * self._outline_factor())
            rim_bottom = self._scale_alpha(rim_bottom, edge_alpha * 0.45 * self._outline_factor())
            shadow = self._scale_alpha(shadow, edge_alpha)
            if self._java_runtime is not None:
                return self._java_runtime.colors(tint, rim_top, rim_bottom, shadow)
            # Нужен provider, иначе updateColors вернёт цвета темы.
            if getattr(self, "_color_provider_class", None) is None:

                class GlassColors(
                    dynamic_proxy(
                        jclass(
                            "org.telegram.ui.Components.blur3.drawable.color.BlurredBackgroundColorProvider"
                        )
                    )
                ):
                    def __init__(self, background, top, bottom, shadow):
                        super().__init__()
                        self.colors = (background, top, bottom, shadow)

                    def getBackgroundColor(self):
                        return self.colors[0]

                    def getStrokeColorTop(self):
                        return self.colors[1]

                    def getStrokeColorBottom(self):
                        return self.colors[2]

                    def getShadowColor(self):
                        return self.colors[3]

                self._color_provider_class = GlassColors
            return self._color_provider_class(tint, rim_top, rim_bottom, shadow)
        except Exception as exc:
            self._warn_once("Источник цветов стекла", exc)
            return None

    def _snapshot_object(self, obj, names, fragment=None):
        if obj is None:
            return
        if fragment is not None:
            self._object_owners[_identity(obj)] = _identity(fragment)
        entry = self._original_objects.setdefault(_identity(obj), {"object": obj, "fields": {}})
        for name in names:
            if name not in entry["fields"]:
                value = obj.getBackground() if name == "background" else self.field(obj, name)
                if value is not None or name in (
                    "glassDrawable",
                    "glassDrawableBack",
                    "glassDrawableMenu",
                    "blurredBackgroundDrawable",
                    "background",
                ):
                    entry["fields"][name] = value

    def _snapshot_drawable(self, drawable, fragment=None):
        key = _identity(drawable)
        if fragment is not None:
            self._drawable_owners[key] = _identity(fragment)
        if key in self._original_drawables:
            return
        props = self.field(drawable, "boundProps")
        fields = {}
        for name in ("colorProvider", "shadowAlpha", "shadowLayerRadius", "shadowLayerDx", "shadowLayerDy"):
            value = self.field(drawable, name)
            if value is not None:
                fields[name] = value
        prop_fields = {}
        if props is not None:
            for name in ("liquidThickness", "liquidIntensity", "strokeWidthTop", "strokeWidthBottom"):
                value = self.field(props, name)
                if value is not None:
                    prop_fields[name] = value
            radii = self.field(props, "radii")
            if radii is not None:
                prop_fields["radii"] = [float(v) for v in radii]
        try:
            alpha = int(drawable.getAlpha())
        except Exception:
            alpha = 255
        try:
            member = self._java_field(drawable, "liquidGlassEffect")
            if member is not None:
                fields["liquidGlassEffect"] = member.get(drawable)
        except Exception:
            pass
        self._original_drawables[key] = (drawable, fields, prop_fields, alpha)

    def _restore_materials(self, fragment=None, drawable_key=None):
        self._java_tabs_targets.clear()
        self._java_input_targets.clear()
        owner = _identity(fragment)
        for key, state in list(self._original_drawables.items()):
            if drawable_key is not None and key != drawable_key:
                continue
            if fragment is not None and self._drawable_owners.get(key) != owner:
                continue
            drawable, fields, props, alpha = state
            try:
                if "source" in fields:
                    if not self._set_java_field(drawable, "source", fields["source"], "obj"):
                        self._warn_once("Восстановление источника стекла чата", "Не удалось вернуть источник стекла")
                    drawable.invalidateDisplayList()
                provider = fields.get("colorProvider")
                if provider is not None:
                    drawable.setColorProvider(provider)
                if "liquidIntensity" in props:
                    drawable.setIntensity(float(props["liquidIntensity"]))
                if "liquidThickness" in props:
                    drawable.setThickness(int(props["liquidThickness"]))
                if "strokeWidthTop" in props and "strokeWidthBottom" in props:
                    drawable.setStrokeWidth(float(props["strokeWidthTop"]), float(props["strokeWidthBottom"]))
                radii = props.get("radii")
                if radii is not None and len(radii) >= 8:
                    drawable.setRadius(radii[0], radii[2], radii[4], radii[6])
                if "shadowAlpha" in fields:
                    drawable.setShadowAlpha(float(fields["shadowAlpha"]))
                if "shadowLayerRadius" in fields:
                    drawable.setShadowParams(
                        float(fields["shadowLayerRadius"]),
                        float(fields.get("shadowLayerDx", 0)),
                        float(fields.get("shadowLayerDy", 0)),
                    )
                if "liquidGlassEffect" in fields:
                    self._set_glass_effect(drawable, fields["liquidGlassEffect"])
                drawable.setAlpha(alpha)
                drawable.updateColors()
                drawable.invalidateSelf()
            except Exception as exc:
                self._warn_once("Восстановление материала", exc)
            self._original_drawables.pop(key, None)
            self._fade_sources.pop(key, None)
            self._settings_sources.pop(key, None)
        self._refresh_draw_filter_targets()
        if drawable_key is not None:
            return
        for key, entry in list(self._original_objects.items()):
            if fragment is not None and self._object_owners.get(key) != owner:
                continue
            obj = entry["object"]
            try:
                for name, value in entry["fields"].items():
                    if name == "background":
                        obj.setBackground(value)
                    else:
                        kind = "bool" if isinstance(value, bool) else "obj"
                        self._set_java_field(obj, name, value, kind)
            except Exception as exc:
                self._warn_once("Восстановление объекта", exc)
            try:
                obj.invalidate()
            except Exception:
                pass
            self._original_objects.pop(key, None)

    def _release_drawable(self, drawable):
        self._java_tabs_targets.clear()
        self._java_input_targets.clear()
        key = _identity(drawable)
        self._native_positions.pop(key, None)
        for cache in (
            self._original_drawables,
            self._drawable_owners,
            self._styled_glass,
            self._saved_lenses,
        ):
            cache.pop(key, None)
        self._lens_attempted.discard(key)
        self._fade_sources.pop(key, None)
        self._settings_sources.pop(key, None)
        self._refresh_draw_filter_targets()

    def _refresh_draw_filter_targets(self):
        self._java_settings_targets.clear()
        if self._java_photo_gate is not None:
            self._java_photo_gate.clear()
        if self._draw_filter_targets is None:
            return
        photos, lists = self._draw_filter_targets[:2]
        photos.clear()
        lists.clear()
        for viewer in self._photo_sources.values():
            photos.add(viewer)
        if self._java_photo_gate is not None and self._photo_sources:
            try:
                sources, viewers, members = [], [], []
                for viewer in self._photo_sources.values():
                    source = self.field(viewer, "blurredBackgroundSource")
                    member = self._java_field(viewer, "blurredBackgroundSource")
                    if member is None or source is None or _identity(source) not in self._photo_sources:
                        raise RuntimeError("photo source unavailable")
                    sources.append(source)
                    viewers.append(viewer)
                    members.append(member)
                self._java_photo_gate.update(
                    jarray(jclass("java.lang.Object"))(sources),
                    jarray(jclass("java.lang.Object"))(viewers),
                    jarray(jclass("java.lang.reflect.Field"))(members),
                )
            except Exception as exc:
                self._java_photo_gate.clear()
                self._warn_once("Фильтр галереи недоступен, используем Python", exc)
        for state in self._settings_sources.values():
            lists.add(state["proxy"].view)
        if self._java_runtime is not None:
            groups = {}
            for state in self._settings_sources.values():
                groups.setdefault(_identity(state["proxy"].view), []).append(state)
            for states in groups.values():
                try:
                    proxy = states[0]["proxy"]
                    bar = self.field(proxy.fragment, "actionBar")
                    bar = bar if bar is not None and self._is_settings_header(proxy.fragment, bar) else None
                    self._java_settings_targets.put(
                        proxy.view,
                        self._java_runtime.settings(
                            jarray(
                                jclass("org.telegram.ui.Components.blur3.drawable.BlurredBackgroundDrawable")
                            )([state["drawable"] for state in states]),
                            jarray(jclass("java.lang.Object"))(
                                [state["proxy"].java_flags for state in states]
                            ),
                            bar,
                            proxy.fragment,
                            self._java_field(proxy.fragment, "actionBar"),
                        ),
                    )
                except Exception as exc:
                    self._warn_once("Обновление настроек через Java недоступно, используем Python", exc)

    def _lens_values(self):
        mode = self._perf.get("lens", 0)
        if mode == 2:
            return 0.0, 0
        if mode == 1:
            return 0.40, int(dp(5))
        return LENS_INTENSITY, int(dp(LENS_THICKNESS_DP))

    def _round_start(self, controller=None, force=False, message_hint=None):
        playing = False
        if self._active and (self._perf.get("round_light", True) or self._perf.get("round_fps", 30)):
            try:
                if controller is None:
                    controller = jclass("org.telegram.messenger.MediaController").getInstance()
                if message_hint is not None:
                    # В начале playMessage контроллер ещё хранит предыдущее сообщение.
                    playing = bool(message_hint.isRoundVideo())
                else:
                    message = controller.getPlayingMessageObject()
                    playing = (
                        message is not None
                        and bool(message.isRoundVideo())
                        and not controller.isMessagePaused()
                    )
            except Exception as exc:
                self._warn_once("Состояние проигрывания кружка", exc)
                if not force:
                    return
                playing = self._round_video_active
        if playing != self._round_video_active:
            self._round_video_active = playing
            self._round_capture_gate[0] = 1 if playing else 0
            self._round_panel_clips.clear()
            self._update_capture_intervals()
        playing = playing and self._perf.get("round_light", True)
        if self._java_bot_menus is not None:
            try:
                self._java_bot_menus.light(playing or self._perf.get("lens", 0) == 2)
            except Exception as exc:
                self._warn_once("Меню бота при проигрывании кружка", exc)
        if playing == self._round_playing and not force:
            return
        self._round_playing = playing
        self.log(
            f"Кружок: состояние изменено; active={self._round_video_active}; playing={playing}; "
            f"light={self._perf.get('round_light', True)}"
        )
        intensity = 0.0 if playing else self._lens_values()[0]
        # Плеер и кнопки могли выпасть из LRU, но линзы у них всё ещё есть.
        for drawable in self._round_drawables():
            try:
                self._set_round_material(drawable)
                drawable.setIntensity(float(intensity))
                if force:
                    drawable.setThickness(self._lens_values()[1])
                drawable.updateColors()
                drawable.invalidateSelf()
            except Exception as exc:
                self._warn_once("Стекло при проигрывании кружка", exc)
        self._refresh_round_chat_surfaces()

    def _round_drawables(self):
        found = {}

        def add(drawable):
            if drawable is not None:
                found[_identity(drawable)] = drawable

        for state in self._original_drawables.values():
            add(state[0])
        for state in self._styled_glass.values():
            add(state[0])
        for entry in self._patched_dates.values():
            add(entry.get("surface"))
        for entry in self._top_surfaces.values():
            add(entry.get("surface"))
        for entry in self._pinned_surfaces.values():
            add(entry.get("surface"))
        for entry in self._main_nav.values():
            add(entry.get("surface"))
        for entry in self._extra_surfaces.values():
            add(entry.get("surface"))
        for entry in self._native_surfaces.values():
            add(entry[3])
        return tuple(found.values())

    def _set_round_material(self, drawable):
        key = _identity(drawable)
        if self._round_playing or self._perf.get("lens", 0) == 2:
            effect = self.field(drawable, "liquidGlassEffect")
            if effect is not None:
                self._saved_lenses[key] = effect
                self._set_glass_effect(drawable, None)
        elif key in self._saved_lenses:
            self._set_glass_effect(drawable, self._saved_lenses[key])
            self._saved_lenses.pop(key, None)

    def _set_glass_effect(self, drawable, effect):
        previous = self.field(drawable, "liquidGlassEffect") or self._saved_lenses.get(_identity(drawable))
        if self._java_runtime is not None:
            self._java_runtime.glassEffect(drawable, effect, previous)
            return
        node = self.field(effect if effect is not None else previous, "node") or self.field(
            drawable, "renderNodeFill"
        )
        if node is not None:
            # Нулевая intensity не снимает RuntimeShader с RenderNode.
            node.setRenderEffect(self.field(effect, "effect") if effect is not None else None)
        if not self._set_java_field(drawable, "liquidGlassEffect", effect, "obj"):
            raise RuntimeError("Не удалось переключить шейдер преломления")
        if hasattr(drawable, "invalidateDisplayList"):
            drawable.invalidateDisplayList()
        drawable.invalidateSelf()

    def _outline_stroke_matches(self, drawable):
        props = self.field(drawable, "boundProps")
        if props is None:
            return False
        expected_top = float(dp(RIM_WIDTH_TOP_DP)) * self._outline_width_factor()
        expected_bottom = float(dp(RIM_WIDTH_BOTTOM_DP)) * self._outline_width_factor()
        radii = self.field(props, "radii")
        top_seam = (
            radii is not None
            and len(radii) == 8
            and abs(float(radii[0])) <= 0.001
            and abs(float(radii[2])) <= 0.001
        )
        bottom_seam = (
            radii is not None
            and len(radii) == 8
            and abs(float(radii[4])) <= 0.001
            and abs(float(radii[6])) <= 0.001
        )
        actual_top = float(self.field(props, "strokeWidthTop") or 0)
        actual_bottom = float(self.field(props, "strokeWidthBottom") or 0)
        return (abs(actual_top - expected_top) <= 0.001 or (top_seam and abs(actual_top) <= 0.001)) and (
            abs(actual_bottom - expected_bottom) <= 0.001 or (bottom_seam and abs(actual_bottom) <= 0.001)
        )

    def style_glass_drawable(self, fragment, drawable, radius=None, variant=""):
        if drawable is None:
            return False
        self._repair_blur_source(fragment)
        clear = self.field(fragment, "glassBackgroundSourceRenderNode") or self.field(
            fragment, "iBlur3SourceGlass"
        )
        frosted = self.field(fragment, "glassBackgroundSourceFrostedRenderNode") or self.field(
            fragment, "iBlur3SourceGlassFrosted"
        )
        # Поле ввода по умолчанию берёт frosted; для линзы нужен glass.
        if clear is not None and frosted is not None and _identity(clear) != _identity(frosted):
            if _identity(self.field(drawable, "source")) == _identity(frosted):
                self._snapshot_drawable(drawable, fragment)
                self._original_drawables[_identity(drawable)][1].setdefault("source", frosted)
                try:
                    if not self._set_java_field(drawable, "source", clear, "obj"):
                        raise RuntimeError("Не удалось переключить капсулу на канал стекла")
                    drawable.invalidateDisplayList()
                    self._styled_glass.pop(_identity(drawable), None)
                except Exception as exc:
                    self._set_java_field(drawable, "source", frosted, "obj")
                    self._warn_once("Источник стекла чата", exc)
        dark = variant == "photo" or _is_dark()
        intensity, thickness = self._lens_values()
        density, color, outline = self._glass_density(dark), self._glass_color(dark), self._outline_factor()
        sig = (
            dark,
            100,
            None if radius is None else int(radius),
            intensity,
            thickness,
            self._perf.get("no_shadow", True),
            variant,
            density,
            color,
            outline,
            bool(self._round_playing),
        )
        key = _identity(drawable)
        cached = self._styled_glass.get(key)
        if self._round_playing or self._perf.get("lens", 0) == 2:
            # updateColors может вернуть линзу, даже если наш стиль не менялся.
            self._snapshot_drawable(drawable, fragment)
            self._set_round_material(drawable)
            try:
                drawable.setIntensity(0.0)
            except Exception:
                pass
        if (
            cached is not None
            and _identity(cached[0]) == key
            and cached[1] == sig
            and _identity(self.field(drawable, "colorProvider")) == _identity(cached[2])
            and self._outline_stroke_matches(drawable)
        ):
            self._styled_glass.move_to_end(key)
            return True

        provider_key = (_identity(fragment), dark, variant, density, color, outline)
        provider = self._provider_cache.get(provider_key)
        if provider is None:
            provider = self.make_provider(variant=variant)
            if provider is not None:
                self._provider_cache[provider_key] = provider
        if provider is None:
            return False
        self._snapshot_drawable(drawable, fragment)
        try:
            if self._round_playing or self._perf.get("lens", 0) == 2:
                self._set_round_material(drawable)
            elif self.field(drawable, "liquidGlassEffect") is None and key not in self._lens_attempted:
                self._lens_attempted.add(key)
                saved = self._saved_lenses.pop(key, None)
                if saved is not None:
                    self._set_glass_effect(drawable, saved)
                else:
                    try:
                        drawable.setLiquidGlassEffectAllowed()
                    except Exception as exc:
                        self._warn_once("Создание линзы стекла", exc)
            drawable.setColorProvider(provider)
            try:
                drawable.setAlpha(255)
            except Exception:
                pass
            if radius is not None:
                drawable.setRadius(float(radius))
            try:
                drawable.setIntensity(0.0 if self._round_playing else float(intensity))
                drawable.setThickness(thickness)
                width_factor = self._outline_width_factor()
                drawable.setStrokeWidth(
                    float(dp(RIM_WIDTH_TOP_DP)) * width_factor, float(dp(RIM_WIDTH_BOTTOM_DP)) * width_factor
                )
                drawable.setShadowAlpha(0.0 if self._perf.get("no_shadow", True) else float(SHADOW_ALPHA))
                drawable.updateColors()
            except Exception as exc:
                self._warn_once("Параметры материала стекла", exc)
            try:
                drawable.invalidateSelf()
            except Exception:
                pass

            self._styled_glass[key] = (drawable, sig, provider)
            self._styled_glass.move_to_end(key)
            if len(self._styled_glass) > 256:
                self._styled_glass.popitem(last=False)
            return True
        except Exception as exc:
            self._warn_once("Оформление стеклянной поверхности", exc)
            return False

    def _refresh_round_chat_surfaces(self):
        # Из-за плеера весь чат не переоформляем: достаточно ввода и нижней панели.
        owners = {_identity(fragment): fragment for fragment in self._known_fragments.values()}
        owners.update({_identity(owner): owner for _view, owner in self._owners.values() if owner is not None})
        for fragment in owners.values():
            try:
                self._style_input(fragment)
                self._style_bottom_overlay(fragment)
            except Exception as exc:
                self._warn_once("Обновление капсул при смене состояния кружка", exc)

    def _track_native_position(self, drawable, factory):
        # create(view) уже подписывает drawable на перемещения View.
        if (
            drawable is not None
            and self.field(factory, "viewPositionWatcher") is not None
            and self.field(factory, "parent") is not None
        ):
            self._native_positions[_identity(drawable)] = True

    def create_glass_surface(self, fragment, view, radius):
        factory = self.glass_factory(fragment)
        if fragment is None or view is None or factory is None:
            return None
        try:
            try:
                self._snapshot_object(factory, ("isLiquidGlassEffectAllowed",), fragment)
                factory.setLiquidGlassEffectAllowed(True)
            except Exception:
                pass
            drawable = factory.create(view)
            self._track_native_position(drawable, factory)
            if drawable is None:
                return None
            try:
                drawable.setPadding(0)
            except Exception:
                pass
            if not self.style_glass_drawable(fragment, drawable, radius=radius):
                return None
            view.setBackground(drawable)
            view.invalidate()
            return drawable
        except Exception as exc:
            self._warn_once("Создание стеклянной поверхности", exc)
            return None

    def _drawable_has_lens(self, drawable):
        try:
            return self.field(drawable, "liquidGlassEffect") is not None
        except Exception:
            return False

    def _apply_rim(self, key, view, radius, width, height, sig, entry, stroke_width=0.6):
        if view is None or width <= 0 or height <= 0:
            return
        factor = self._outline_factor()
        sig = (sig, factor)
        if entry.get("rim_sig") == sig:
            return
        old = self._rims.pop(key, None)
        if old is not None:
            try:
                view.getOverlay().remove(old)
            except Exception:
                pass
        if factor == 0:
            entry["rim_sig"] = sig
            view.invalidate()
            return
        rim = create_glass_rim(
            radius, width, height, stroke_width=stroke_width * self._outline_width_factor()
        )
        if rim is None:
            return
        try:
            rim.setAlpha(min(255, int(255 * factor)))
            rim.setBounds(0, 0, int(width), int(height))
            view.getOverlay().add(rim)
            self._rims[key] = rim
            entry["rim_sig"] = sig
            view.invalidate()
        except Exception:
            pass

    # Главный экран: панель, поиск и нижняя навигация

    def _is_main_dialogs(self, fragment):
        try:
            return (
                str(fragment.getClass().getName()) == "org.telegram.ui.DialogsActivity"
                and not self.field(fragment, "folderId")
                and not self.field(fragment, "dialogsType")
                and not self.field(fragment, "onlySelect")
            )
        except Exception:
            return False

    def _remember_header_menu(self, entry, menu):
        if menu is None:
            return
        key = _identity(menu)
        state = entry["menus"].get(key)
        if state is None:
            state = {
                "view": menu,
                "x": float(menu.getTranslationX()),
                "glass": bool(self.field(menu, "glassMode")),
                "children": {},
            }
            # Меню выделения могло родиться уже с нашим glassMode и сдвигом.
            if entry.get("ready") and not entry["fields"].get("glassMode"):
                state["glass"], state["x"] = False, 0.0
            entry["menus"][key] = state
        for index in range(int(menu.getChildCount())):
            child = menu.getChildAt(index)
            params = child.getLayoutParams()
            if hasattr(params, "leftMargin") and _identity(child) not in state["children"]:
                state["children"][_identity(child)] = (child, int(params.leftMargin), int(params.rightMargin))

    def _restore_main_header(self, key):
        entry = self._main_headers.pop(key, None)
        if entry is None:
            return
        self._restoring_headers.add(key)
        for view in entry.get("draw_targets", ()):
            self._main_header_views.remove(view)
            # У градиента и историй свои display lists, поэтому инвалидируем и детей.
            view.invalidate()
        self._header_list_targets.remove(entry.get("list_root"))
        self._java_list_targets.remove(entry.get("list_root"))
        self._header_layout_targets.remove(entry["bar"])
        bar = entry["bar"]
        fade_view = entry.get("fade_view")
        if fade_view is not None:
            self._main_header_views.remove(fade_view)
            self._owners.pop(_identity(fade_view), None)
            self._owned_views.remove(fade_view)
            parent = fade_view.getParent()
            if parent is not None:
                parent.removeView(fade_view)
        story_title = entry.get("story_title")
        try:
            node = entry.get("story_content")
            if node is not None:
                node.discardDisplayList()
            if story_title is not None:
                self._restore_materials(drawable_key=_identity(story_title[1]))
                self._release_drawable(story_title[1])
                story_title[1].setCallback(None)
                self._owners.pop(_identity(story_title[0]), None)
                self._owned_views.remove(story_title[0])
        except Exception as exc:
            self._warn_once("Восстановление заголовка историй", exc)
        try:
            for drawable in entry.get("drawables", ()):
                self._restore_materials(drawable_key=_identity(drawable))
                self._release_drawable(drawable)
                if all(
                    _identity(drawable) != _identity(entry["fields"][name])
                    for name in ("glassDrawable", "glassDrawableBack", "glassDrawableMenu")
                ):
                    drawable.setCallback(None)
            for name, value in entry["fields"].items():
                kind = "bool" if isinstance(value, bool) else "int" if name == "actionBarColor" else "obj"
                self._set_java_field(bar, name, value, kind)
            # Фон шапки рисуется по флагам, а не через View.background.
            bar.setBackground(entry["background"])
            content = entry["fields"].get("contentView")
            if entry["fields"].get("blurredBackground") and content is not None:
                try:
                    if hasattr(bar, "setDrawBlurBackground") and not bool(
                        self.field(bar, "blurredBackground")
                    ):
                        bar.setDrawBlurBackground(content)
                    content.blurBehindViews.add(bar)
                except Exception:
                    pass
            # updateColors не должен снова включить стекло во время восстановления.
            self._owners.pop(_identity(bar), None)
            self._owned_views.remove(bar)
            try:
                bar.updateColors()
            except Exception:
                pass
            bar.setClipChildren(entry["clip"])
            for state in entry["menus"].values():
                menu = state["view"]
                menu.setGlassMode(state["glass"])
                menu.setTranslationX(state["x"])
                for child, left, right in state["children"].values():
                    params = child.getLayoutParams()
                    params.leftMargin, params.rightMargin = left, right
                    child.setLayoutParams(params)
                menu.requestLayout()
            if entry["back"] is not None:
                entry["back"].setTranslationX(entry["back_x"])
            bar.requestLayout()
            bar.invalidate()
            root = self.field(entry["fragment"], "fragmentView")
            if root is not None:
                root.invalidate()
            stories = self.field(entry["fragment"], "dialogStoriesCell")
            for target in (
                stories,
                self.field(stories, "titleView") if stories is not None else None,
                self.field(stories, "recyclerListView") if stories is not None else None,
                self.field(stories, "listViewMini") if stories is not None else None,
            ):
                if target is not None and hasattr(target, "invalidate"):
                    target.invalidate()
            if stories is not None and hasattr(stories, "requestLayout"):
                stories.requestLayout()
        except Exception as exc:
            self._warn_once("Восстановление главной шапки", exc)
        finally:
            self._restoring_headers.discard(key)

    def _style_main_header(self, fragment, allow_archive=False):
        key = _identity(fragment)
        if key in self._restoring_headers:
            return
        self._style_main_search(fragment, allow_archive=allow_archive)
        archive = (
            str(fragment.getClass().getName()) == "org.telegram.ui.DialogsActivity"
            and int(self.field(fragment, "folderId") or 0) == 1
            and not self.field(fragment, "dialogsType")
            and not self.field(fragment, "onlySelect")
        )
        setting = "glass_archive_header" if archive else "glass_main_header"
        if not (self._is_main_dialogs(fragment) or (allow_archive and archive)) or not self._enabled(setting):
            self._restore_main_header(key)
            return
        bar = self.field(fragment, "actionBar")
        if bar is None:
            return
        entry = self._main_headers.get(key)
        if entry is not None and _identity(entry["bar"]) != _identity(bar):
            self._restore_main_header(key)
            entry = None
        names = ("glassDrawable", "glassDrawableBack", "glassDrawableMenu")
        try:
            if entry is None:
                fields = {
                    name: self.field(bar, name)
                    for name in names
                    + (
                        "glassMode",
                        "glassModeIsForum",
                        "glassOnlyBack",
                        "blurredBackground",
                        "contentView",
                        "actionBarColor",
                    )
                }
                back = self.field(bar, "backButtonImageView")
                entry = {
                    "fragment": fragment,
                    "bar": bar,
                    "fields": fields,
                    "background": bar.getBackground(),
                    "clip": bool(bar.getClipChildren()),
                    "menus": {},
                    "back": back,
                    "back_x": float(back.getTranslationX()) if back is not None else 0.0,
                }
                self._main_headers[key] = entry
                for name in ("menu", "actionMode"):
                    self._remember_header_menu(entry, self.field(bar, name))
                entry["drawables"] = [fields[name] for name in names if fields[name] is not None]
                if any(fields[name] is None for name in names):
                    factory = self.glass_factory(fragment)
                    provider = self.make_provider()
                    if factory is None or provider is None:
                        self._restore_main_header(key)
                        return
                    entry["factory"] = factory
                    # create() без View не оставляет лишнюю подписку в watcher.
                    allowed = self.field(factory, "isLiquidGlassEffectAllowed")
                    try:
                        factory.setLiquidGlassEffectAllowed(True)
                        for name in names:
                            if fields[name] is not None:
                                continue
                            drawable = factory.create()
                            if drawable is None:
                                raise RuntimeError("Фабрика не создала " + name)
                            entry["drawables"].append(drawable)
                            drawable.setColorProvider(provider)
                            drawable.setRadius(float(dp(23)))
                            drawable.setPadding(int(dp(6)))
                            drawable.setCallback(bar)
                            if not self._set_java_field(bar, name, drawable, "obj"):
                                raise RuntimeError("Не удалось установить " + name)
                    finally:
                        if allowed is not None:
                            factory.setLiquidGlassEffectAllowed(bool(allowed))
                entry["drawables"] = [self.field(bar, name) for name in names]
                if any(drawable is None for drawable in entry["drawables"]):
                    self._restore_main_header(key)
                    return
                self._remember_owner(bar, fragment)
                self._remember_owner(self.field(fragment, "fragmentView"), fragment)
                self._set_java_field(bar, "glassMode", True, "bool")
                # У заголовка без ChatAvatarContainer работает только ветка glassModeIsForum.
                self._set_java_field(bar, "glassModeIsForum", True, "bool")
                self._set_java_field(bar, "glassOnlyBack", False, "bool")
                bar.setClipChildren(False)
                for state in entry["menus"].values():
                    state["view"].setGlassMode(True)
                    state["view"].setTranslationX(-float(dp(10)))
                if back is not None:
                    back.setTranslationX(float(dp(2)))
                bar.setBackground(None)
                bar.requestLayout()
                bar.invalidate()
            sample = None
            for drawable in entry["drawables"]:
                if not self.style_glass_drawable(fragment, drawable):
                    return
                if sample is None:
                    try:
                        sample = self._header_fade_sample(fragment)
                    except Exception as exc:
                        self._warn_once("Выборка фона градиента шапки", exc)
                        sample = False
                if sample is not False:
                    self._sample_header_fade(fragment, drawable, sample)
                if entry.get("factory") is not None:
                    self._sync_surface_offset(fragment, bar, drawable, entry["factory"])
            story_title = entry.get("story_title")
            if story_title is not None:
                self.style_glass_drawable(fragment, story_title[1], float(dp(23)))
            self._remember_owner(self.field(fragment, "fragmentView"), fragment)
            self._remember_owner(self.field(fragment, "topBubblesFadeView"), fragment)
            self._remember_owner(self.field(fragment, "dialogStoriesCell"), fragment)
            stories = self.field(fragment, "dialogStoriesCell")
            self._remember_owner(self.field(stories, "titleView"), fragment)
            self._remember_owner(self.field(stories, "recyclerListView"), fragment)
            self._remember_owner(self.field(stories, "listViewMini"), fragment)
            entry["ready"] = True
            for view in entry.get("draw_targets", ()):
                self._main_header_views.remove(view)
            entry["draw_targets"] = [
                view
                for view in (
                    bar,
                    self.field(fragment, "fragmentView"),
                    self.field(fragment, "topBubblesFadeView"),
                    stories,
                )
                if view is not None
            ]
            for view in entry["draw_targets"]:
                self._main_header_views.add(view)
                if entry.get("top_fade") is None:
                    view.invalidate()
            self._bind_header_blur_root(fragment)
            self._main_top_fade(fragment)
            members = [self._java_field(bar, name) for name in names]
            if all(member is not None for member in members):
                self._header_layout_targets.put(
                    bar,
                    jarray(jclass("java.lang.Object"))(
                        [value for pair in zip(members, entry["drawables"]) for value in pair]
                    ),
                )
            # blurredBackground нужен и режиму выделения, его не выключаем.
        except Exception as exc:
            self._warn_once("Главная шапка", exc)
            self._restore_main_header(key)

    def _header_trace(self, fragment, event, detail=""):
        if not self._logging_enabled:
            return
        entry = self._main_headers.get(_identity(fragment))
        if entry is not None and event not in entry.setdefault("diagnostics", set()):
            entry["diagnostics"].add(event)
            self.log(f"Главная подложка: {event}" + (f"; {detail}" if detail else ""))

    def _bind_header_blur_root(self, fragment):
        root = self.field(fragment, "fragmentView")
        if root is None or self._header_blur_hook is None:
            return
        entry = self._main_headers[_identity(fragment)]
        if entry.get("blur_root") == _identity(root):
            return
        entry["blur_root"] = _identity(root)
        try:
            members = [
                self._java_field(fragment, name) for name in ("actionBar", "topBubblesFadeView", "viewPages")
            ]
            if all(member is not None for member in members):
                self._header_list_targets.remove(entry.get("list_root"))
                self._java_list_targets.remove(entry.get("list_root"))
                entry["list_root"] = root
                self._header_list_targets.put(
                    root, jarray(jclass("java.lang.Object"))([fragment] + members + [entry.get("fade_view")])
                )
            self._java_list_targets.remove(root)
            cls = root.getClass()
            root_name = str(cls.getName())
            installed = []
            found = 0
            for _ in range(12):
                if cls is None:
                    break
                name = str(cls.getName())
                if (
                    name == "org.telegram.ui.Components.SizeNotifierFrameLayout"
                    and self._header_blur_flag is None
                ):
                    try:
                        flag = cls.getDeclaredField("drawingBlur")
                        flag.setAccessible(True)
                        self._header_blur_flag = flag
                    except Exception as exc:
                        self._warn_once("Флаг размытия главной шапки", exc)
                if name not in self._header_blur_classes:
                    self._header_blur_classes.add(name)
                    for method in cls.getDeclaredMethods():
                        if str(method.getName()) == "drawBlurRect":
                            found += 1
                            method.setAccessible(True)
                            if self.hook_method(method, self._header_blur_hook):
                                installed.append(name)
                            else:
                                self._warn_once("Хук размытия шапки: " + name, "SDK не установил хук")
                        elif (
                            str(method.getName()) == "dispatchDraw"
                            and not name.startswith(("android.", "androidx."))
                            and self._header_root_draw_hook is not None
                        ):
                            method.setAccessible(True)
                            if self.hook_method(method, self._header_root_draw_hook):
                                installed.append(name + ".dispatchDraw")
                            else:
                                self._warn_once("Хук контейнера шапки: " + name, "SDK не установил хук")
                        elif not name.startswith(("android.", "androidx.")):
                            hook = (
                                self._header_list_draw_hook if str(method.getName()) == "drawChild" else None
                            )
                            if hook is not None:
                                method.setAccessible(True)
                                if self.hook_method(method, hook):
                                    installed.append(name + "." + str(method.getName()))
                                else:
                                    self._warn_once("Хук списка под шапкой: " + name, "SDK не установил хук")
                cls = cls.getSuperclass()
            if self._java_runtime is not None and self._header_blur_flag is not None:
                fields = [
                    self._java_field(fragment, name)
                    for name in (
                        "inPreviewMode",
                        "progressToActionMode",
                        "searchIsShowed",
                        "topBubblesFadeView",
                        "viewPages",
                        "slideFragmentProgress",
                        "rightSlidingDialogContainer",
                        "slideFragmentLite",
                        "slideAmplitudeDp",
                        "scrollYOffset",
                    )
                ]
                if all(member is not None for member in fields):
                    entry["java_list"] = self._java_runtime.list(
                        fragment,
                        root,
                        entry["bar"],
                        self._header_blur_flag,
                        jarray(jclass("java.lang.reflect.Field"))(fields),
                        float(AndroidUtilities.density),
                    )
                    entry["java_list"].setTopFade(entry.get("fade_view"))
                    self._java_list_targets.put(root, entry["java_list"])
            self._header_trace(
                fragment,
                "контейнер обнаружен",
                f"class={root_name}; hooks={installed}; поиск={self.field(fragment, 'fragmentSearchField') is not None}",
            )
            if not found and not installed:
                self._header_trace(
                    fragment,
                    "проверка хуков",
                    "Классы уже проверены либо drawBlurRect отсутствует; см. события отсечения при прокрутке",
                )
        except Exception as exc:
            self._warn_once("Поиск источника размытия шапки", exc)

    def _restore_main_search(self, key):
        search = self._main_searches.pop(key, None)
        if search is None:
            return
        try:
            self._restore_materials(drawable_key=_identity(search["drawable"]))
            self._release_drawable(search["drawable"])
            # updateColors мог заменить drawable. Возвращаем именно штатный фон.
            self._set_java_field(search["view"], "blurredBackgroundDrawable", search["original"], "obj")
            if search["original"] is None:
                search["drawable"].setCallback(None)
            self._set_java_field(search["view"], "bg", search.get("bg"), "obj")
            self._set_java_field(search["view"], "onCloseSearch", search.get("callback"), "obj")
            if search.get("bg") is not None and search.get("bg_alpha") is not None:
                search["bg"].setAlpha(search["bg_alpha"])
            if search.get("original") is not None and search.get("drawable_alpha") is not None:
                search["original"].setAlpha(search["drawable_alpha"])
            self._owners.pop(_identity(search["view"]), None)
            self._owned_views.remove(search["view"])
            search["view"].invalidate()
        except Exception as exc:
            self._warn_once("Восстановление поиска на главном экране", exc)

    def _style_main_search(self, fragment, allow_archive=False):
        key = _identity(fragment)
        archive = (
            str(fragment.getClass().getName()) == "org.telegram.ui.DialogsActivity"
            and int(self.field(fragment, "folderId") or 0) == 1
            and not self.field(fragment, "dialogsType")
            and not self.field(fragment, "onlySelect")
        )
        # Этот переключатель общий для поиска на главной и в архиве.
        setting = "glass_main_search"
        if not (self._is_main_dialogs(fragment) or (allow_archive and archive)) or not self._enabled(setting):
            self._restore_main_search(key)
            if self._active and (self._is_main_dialogs(fragment) or (allow_archive and archive)):
                self._use_stock_header_blur(
                    fragment, self.field(fragment, "fragmentSearchField"), "blurredBackgroundDrawable"
                )
            return
        view = self.field(fragment, "fragmentSearchField")
        if view is None:
            self._restore_main_search(key)
            return
        search = self._main_searches.get(key)
        current = self.field(view, "blurredBackgroundDrawable")
        if search is not None and (
            _identity(search["view"]) != _identity(view)
            or _identity(current) != _identity(search["drawable"])
        ):
            self._restore_main_search(key)
            # Сначала вернём старый фон, затем запомним новый штатный.
            self._set_java_field(view, "blurredBackgroundDrawable", current, "obj")
            search = None
        try:
            if search is None:
                self._restore_side_buttons(view=view, field="blurredBackgroundDrawable")
                drawable = current
                if drawable is None:
                    factory = self.glass_factory(fragment)
                    if factory is None:
                        self._header_trace(fragment, "нет фабрики для поиска")
                        return
                    drawable = factory.create()
                    if drawable is None:
                        return
                    view.setupBlurredBackground(drawable)
                    drawable.setCallback(view)
                search = {
                    "view": view,
                    "drawable": drawable,
                    "original": current,
                    "fragment": fragment,
                    "bg": self.field(view, "bg"),
                    "callback": self.field(view, "onCloseSearch"),
                    "bg_alpha": self.field(self.field(view, "bg"), "alpha"),
                    "drawable_alpha": self.field(current, "alpha"),
                }
                self._main_searches[key] = search
                self._remember_owner(view, fragment)
            search["ready"] = self.style_glass_drawable(fragment, search["drawable"], float(dp(20)))
            self._sample_header_fade(fragment, search["drawable"], sample=([], ()))
            if not search["ready"]:
                self._header_trace(fragment, "материал поиска не готов")
                return
            self._sync_surface_offset(fragment, view, search["drawable"], self.glass_factory(fragment))
            self._header_trace(fragment, "стекло поиска подключено")
        except Exception as exc:
            self._warn_once("Стекло поиска на главном экране", exc)

    def _main_header_clear(self, fragment, allow_search=False):
        setting = (
            "glass_archive_header"
            if str(fragment.getClass().getName()) == "org.telegram.ui.DialogsActivity"
            and int(self.field(fragment, "folderId") or 0) == 1
            else "glass_main_header"
        )
        return (
            self._enabled(setting)
            and _identity(fragment) in self._main_headers
            and self._main_headers[_identity(fragment)].get("ready", False)
            and not self.field(fragment, "inPreviewMode")
            and (
                allow_search
                or (
                    not self.field(fragment, "searchIsShowed")
                    and float(self.field(fragment, "searchAnimationProgress") or 0) <= 0
                )
            )
            and float(self.field(fragment, "progressToActionMode") or 0) <= 0
        )

    def _main_top_fade(self, owner):
        entry = self._main_headers[_identity(owner)]
        bar = entry["bar"]
        root = self.field(owner, "fragmentView")
        if root is None or int(bar.getMeasuredHeight()) <= 0:
            return None
        folders = self.field(owner, "filterTabsView")
        state = entry.get("top_fade")
        if state is None:
            view = jclass("org.telegram.ui.Components.chat.layouts.ChatActivityFadeView")(root.getContext())
            view.setupColorKey(Theme.key_windowBackgroundWhite)
            view.setWillNotDraw(False)
            view.setFadeHeightTop(int(dp(48)))
            view.setFadeZoneBottom(0)
            view.setClickable(False)
            view.setFocusable(False)
            view.setImportantForAccessibility(2)
            source, fade = self.field(view, "sourceColor"), self.field(view, "fadeDrawableTop")
            if source is None or fade is None:
                raise RuntimeError("Не удалось получить штатную подложку чата")
            index = root.indexOfChild(bar)
            if index < 0:
                raise RuntimeError("Шапка не принадлежит контейнеру списка")
            # Подложка должна рисоваться раньше и папок, и ActionBar.
            for name in (
                "topBubblesFadeView",
                "searchTabsAndFiltersLayout",
                "filterTabsView",
                "fragmentSearchField",
                "dialogStoriesCell",
                "topPanelLayout",
            ):
                child = self.field(owner, name)
                child_index = root.indexOfChild(child) if child is not None else -1
                if child_index >= 0:
                    index = min(index, child_index)
            root.addView(view, index, FrameLayout.LayoutParams(-1, int(dp(48))))
            self._remember_owner(view, owner)
            entry["fade_view"] = view
            state = source, fade
            entry["top_fade"] = state
            targets = self._header_list_targets.get(root)
            if targets is not None:
                targets[4] = view
            if entry.get("java_list") is not None:
                entry["java_list"].setTopFade(view)
            if self._java_runtime is not None:
                try:
                    entry["java_top_fade"] = self._java_runtime.topFade(root, bar, view, source, int(dp(48)))
                except Exception as exc:
                    self._warn_once("Градиент шапки через Java недоступен, используем Python", exc)
        source, fade = state
        view = entry["fade_view"]
        self._main_header_views.add(view)
        if entry.get("java_top_fade") is not None:
            try:
                color = owner.getThemedColor(Theme.key_windowBackgroundWhite)
                clear = self._main_header_clear(owner)
                signature = (color, _identity(folders), bool(clear))
                # Не пересчитываем градиент с теми же параметрами.
                if entry.get("top_fade_input_signature") != signature:
                    entry["java_top_fade"].update(color, folders, clear)
                    entry["top_fade_input_signature"] = signature
                return state
            except Exception as exc:
                entry.pop("java_top_fade", None)
                self._warn_once("Обновление градиента через Java недоступно, используем Python", exc)
        bottom = max(0, int(bar.getY() + bar.getMeasuredHeight()))
        if (
            folders is not None
            and _identity(folders.getParent()) == _identity(root)
            and int(folders.getVisibility()) == 0
            and float(folders.getAlpha()) > 0
            and int(folders.getMeasuredHeight()) > 0
        ):
            # Фейд начинается под папками, в том числе во время их сдвига.
            bottom = max(bottom, int(folders.getY() + folders.getMeasuredHeight()))
        zone = bottom + int(dp(48))
        width = int(root.getMeasuredWidth())
        params = view.getLayoutParams()
        if params.height != zone:
            params.height = zone
            view.setLayoutParams(params)
        # Слой иногда появляется после layout, уже внутри dispatchDraw.
        if view.getMeasuredWidth() != width or view.getMeasuredHeight() != zone:
            exact = 0x40000000
            view.measure(exact | width, exact | zone)
        if (view.getLeft(), view.getTop(), view.getRight(), view.getBottom()) != (0, 0, width, zone):
            view.layout(0, 0, width, zone)
        signature = (
            owner.getThemedColor(Theme.key_windowBackgroundWhite),
            zone,
            float(bar.getAlpha()) * 0.5,
            0 if self._main_header_clear(owner) else 4,
        )
        if entry.get("fade_signature") != signature:
            source.setColor(signature[0])
            view.setTopFadeColor(signature[0])
            view.setFadeZoneTop(signature[1])
            view.setAlpha(signature[2])
            view.setVisibility(signature[3])
            view.invalidate()
            entry["fade_signature"] = signature
        return state

    def _header_fade_layers(self, owner):
        layers = []
        entry = self._main_headers.get(_identity(owner))
        if entry is not None and self._main_header_clear(owner, allow_search=True):
            state = self._main_top_fade(owner)
            if state is not None and self._main_header_clear(owner):
                _source, fade = state
                view = entry.get("fade_view", entry["bar"])
                layers.append((view, fade, float(view.getAlpha())))
            pager = self.field(owner, "searchViewPager")
            gradient = self.field(pager, "gradientDrawable")
            if (
                gradient is not None
                and int(pager.getVisibility()) == 0
                and float(self.field(owner, "searchAnimationProgress") or 0) > 0
            ):
                layers.insert(0, (pager, gradient, float(pager.getAlpha())))
            return layers
        chat = self.field(owner, "chatActivityFadeView")
        if chat is not None:
            fade = self.field(chat, "fadeDrawableTop")
            if fade is not None and int(chat.getVisibility()) == 0:
                layers.append((chat, fade, float(chat.getAlpha())))
            return layers
        bar = self.field(owner, "actionBar")
        if self._is_settings_header(owner, bar):
            root = self.field(owner, "fragmentView")
            if root is not None:
                for index in range(root.getChildCount()):
                    view = root.getChildAt(index)
                    if (
                        _identity(view) in (_identity(bar), _identity(self.field(owner, "listView")))
                        or int(view.getVisibility()) != 0
                        or float(view.getAlpha()) <= 0
                    ):
                        continue
                    if float(view.getY()) >= float(bar.getY()) + float(bar.getHeight()):
                        continue
                    fade = self.field(view, "fadeDrawableTop") or view.getBackground()
                    if fade is not None and (
                        "fade" in str(view.getClass().getName()).lower()
                        or "GradientDrawable" in str(fade.getClass().getName())
                        or "WithFadeDrawable" in str(fade.getClass().getName())
                    ):
                        layers.append((view, fade, float(view.getAlpha())))
            background = bar.getBackground() if bar is not None else None
            if (
                background is not None
                and hasattr(background, "getClass")
                and any(
                    name in str(background.getClass().getName())
                    for name in ("ColorDrawable", "GradientDrawable", "WithFadeDrawable")
                )
            ):
                layers.append((bar, background, float(bar.getAlpha())))
            return layers
        pager = self.field(owner, "searchViewPager")
        gradient = self.field(pager, "gradientDrawable")
        if (
            gradient is not None
            and int(pager.getVisibility()) == 0
            and float(self.field(owner, "searchAnimationProgress") or 0) > 0
        ):
            layers.insert(0, (pager, gradient, float(pager.getAlpha())))
        return layers

    def _header_fade_sample(self, owner):
        layers, signature = [], []
        factory, dark = self.glass_factory(owner), _is_dark()
        entry = self._main_headers.get(_identity(owner))
        top = entry.get("top_fade") if entry is not None else None
        for view, fade, alpha in self._header_fade_layers(owner):
            position = self._source_position(owner, view, factory)
            if position is None or alpha <= 0:
                continue
            x, y = position
            bounds = fade.getBounds()
            if top is not None and _identity(fade) == _identity(top[1]):
                # У нашего color-fade нет mInsets/mColor. Цвет и геометрию читаем отдельно.
                signature.append(
                    (
                        _identity(fade),
                        x,
                        y,
                        alpha,
                        bounds.left,
                        bounds.top,
                        bounds.right,
                        bounds.bottom,
                        int(fade.getAlpha()),
                        top[0].getColor(),
                        -int(dp(48)),
                        (None, None),
                        dark,
                    )
                )
                layers.append((view, fade, alpha, x, y))
                continue
            source = self.field(self.field(fade, "drawable"), "source")
            color = source.getColor() if source is not None and hasattr(source, "getColor") else None
            insets = self.field(fade, "mInsets")
            gradient_state = (
                self.field(fade, "mColor"),
                None if insets is None else (insets.left, insets.top, insets.right, insets.bottom),
            )
            signature.append(
                (
                    _identity(fade),
                    x,
                    y,
                    alpha,
                    bounds.left,
                    bounds.top,
                    bounds.right,
                    bounds.bottom,
                    int(fade.getAlpha()),
                    color,
                    self.field(fade, "fadeHeight"),
                    gradient_state,
                    dark,
                )
            )
            layers.append((view, fade, alpha, x, y))
        return layers, tuple(signature)

    def _sample_header_fade(self, owner, drawable, sample=None, opacity=1.0):
        source = self.field(drawable, "source")
        if drawable is None or source is None:
            return
        key = _identity(drawable)
        state = self._fade_sources.get(key)
        if state is not None and _identity(source) != _identity(state["proxy"]):
            self._fade_sources.pop(key, None)
            state = None
        try:
            layers, signature = self._header_fade_sample(owner) if sample is None else sample
            if opacity != 1.0:
                # Ослабляем только фон для линзы, не видимый градиент.
                layers = [(view, fade, alpha * opacity, x, y) for view, fade, alpha, x, y in layers]
                signature = (signature, opacity)
            if state is None:
                if not layers:
                    return
                original = source
                state = {"original": original, "layers": [], "signature": None}
                if self._fade_source_class is None:
                    plugin = self

                    class FadeSource(
                        dynamic_proxy(
                            jclass("org.telegram.ui.Components.blur3.source.BlurredBackgroundSource")
                        )
                    ):
                        def __init__(self, state):
                            super().__init__()
                            # Не замыкаем proxy на самого себя через Java/Python.
                            self.state = {"original": state["original"], "layers": state["layers"]}

                        def createDrawable(self):
                            return self.state["original"].createDrawable()

                        def dispatchOnDrawablesRelativePositionChange(self):
                            self.state["original"].dispatchOnDrawablesRelativePositionChange()

                        def draw(self, canvas, left, top, right, bottom):
                            self.state["original"].draw(canvas, left, top, right, bottom)
                            for _view, fade, alpha, x, y in self.state["layers"]:
                                save = canvas.save()
                                try:
                                    canvas.clipRect(float(left), float(top), float(right), float(bottom))
                                    canvas.translate(float(x), float(y))
                                    if alpha < 1.0:
                                        bounds = fade.getBounds()
                                        canvas.saveLayerAlpha(
                                            float(bounds.left),
                                            float(bounds.top),
                                            float(bounds.right),
                                            float(bounds.bottom),
                                            int(255 * alpha),
                                        )
                                    fade.draw(canvas)
                                except Exception as exc:
                                    plugin._warn_once("Отрисовка градиента шапки", exc)
                                finally:
                                    canvas.restoreToCount(save)

                    self._fade_source_class = FadeSource
                state["proxy"] = (
                    self._java_runtime.fade(original)
                    if self._java_runtime is not None
                    else self._fade_source_class(state)
                )
                state["java"] = self._java_runtime is not None
                self._snapshot_drawable(drawable, owner)
                self._original_drawables[key][1].setdefault("source", original)
                if not self._set_java_field(drawable, "source", state["proxy"], "obj"):
                    raise RuntimeError("Не удалось подключить подложку к выборке стекла")
                self._fade_sources[key] = state
            state["layers"][:] = layers
            if state.get("java") and state["signature"] != signature:
                from java import jfloat

                state["proxy"].update(
                    jarray(jclass("android.graphics.drawable.Drawable"))(
                        [fade for _view, fade, _alpha, _x, _y in layers]
                    ),
                    jarray(jfloat)(
                        [value for _view, _fade, alpha, x, y in layers for value in (x, y, alpha)]
                    ),
                )
            if state["signature"] != signature:
                drawable.invalidateDisplayList()
                state["signature"] = signature
        except Exception as exc:
            self._warn_once("Выборка фона градиента шапки", exc)

    def _draw_main_title(self, owner, bar, canvas):
        """Рисуем только подложку заголовка: штатный текст и кнопки остаются на своих местах."""
        try:
            title = bar.getTitleTextView()
            drawable = self.field(bar, "glassDrawable")
            if title is None or drawable is None:
                return False
            if int(title.getVisibility()) != 0:
                return True
            cached = self._styled_glass.get(_identity(drawable))
            if (
                cached is None
                or cached[1][0] != _is_dark()
                or _identity(self.field(drawable, "colorProvider")) != _identity(cached[2])
            ):
                self.style_glass_drawable(owner, drawable)
            width = float(title.getTextWidth())
            if width <= 0:
                return False
            left = float(title.getTextStartX()) - float(title.getX())
            right = left + width
            view = title
            alpha = 1.0
            for _ in range(8):
                if _identity(view) == _identity(bar):
                    break
                # Со свёрнутыми историями ActionBar скрыт; заголовок рисует DialogStoriesCell.
                alpha *= float(view.getAlpha())
                if int(view.getVisibility()) != 0 or alpha <= 0:
                    return True
                scale, pivot = float(view.getScaleX()), float(view.getPivotX())
                left = float(view.getX()) + pivot + (left - pivot) * scale
                right = float(view.getX()) + pivot + (right - pivot) * scale
                view = view.getParent()
                if view is None:
                    return False
            else:
                return False
            props = self.field(drawable, "boundProps")
            padding = float(self.field(props, "padding") or 0)
            pad = float(dp(18)) + padding
            left, right = max(0, int(left - pad)), min(int(bar.getWidth()), int(right + pad))
            if right <= left:
                return False
            from org.telegram.ui.ActionBar import ActionBar

            center = float(bar.getHeight()) - float(ActionBar.getCurrentActionBarHeight()) / 2.0
            half = float(dp(23)) + padding
            radii = self.field(props, "radii")
            if radii is None or any(abs(float(r) - float(dp(23))) > 0.01 for r in radii):
                drawable.setRadius(float(dp(23)))
            drawable.setBounds(left, int(center - half), right, int(center + half))
            if alpha < 1.0:
                save = canvas.saveLayerAlpha(
                    float(left),
                    center - half,
                    float(right),
                    center + half,
                    max(0, min(255, int(255 * alpha))),
                )
                try:
                    drawable.draw(canvas)
                finally:
                    canvas.restoreToCount(save)
            else:
                drawable.draw(canvas)
            return True
        except Exception as exc:
            self._warn_once("Границы главного заголовка", exc)
            return False

    def _archive_title_right(self, owner, stories):
        if int(self.field(owner, "folderId") or 0) != 1:
            return None
        bar = self.field(owner, "actionBar")
        if (
            bar is None
            or self.field(bar, "glassDrawableMenu") is None
            or self.field(bar, "glassOnlyBack")
            or self.field(bar, "doNotDrawGlassMenu")
        ):
            return None
        animator = self.field(bar, "animatorMenuItemsWidth")
        width = int(animator.getFactor()) if animator is not None else 0
        if self.field(bar, "hasForcedMenuWidth"):
            width = int(self.field(bar, "forcedMenuWidth") or 0)
        if self.field(bar, "hasForcedMenuMinWidth"):
            width = max(
                width,
                int(
                    float(self.field(bar, "forcedMenuMinWidth") or 0)
                    * (1.0 - float(self.field(bar, "searchFactor") or 0))
                ),
            )
        if width <= 0:
            return None
        padding = self.field(bar, "glassPadding")
        padding = float(dp(6)) if padding is None else float(padding)
        # Повторяем расчёт ActionBar: прошлые bounds во время анимации уже неверны.
        return (
            float(bar.getX())
            - float(stories.getX())
            + float(bar.getWidth())
            - max(float(dp(46)), width)
            - padding * 2
            - float(dp(6))
        )

    def _draw_stories_title(self, owner, stories, canvas):
        entry = self._main_headers[_identity(owner)]
        title = self.field(stories, "titleView")
        if title is None or int(title.getVisibility()) != 0:
            return
        alpha = max(0.0, min(1.0, float(title.getAlpha())))
        if alpha <= 0:
            return
        width = float(title.getDrawable().getCurrentWidth())
        if width <= 0:
            return
        scale_x, scale_y = float(title.getScaleX()), float(title.getScaleY())
        left = float(title.getX()) + float(title.getPaddingLeft()) * scale_x
        right = left + width * scale_x
        center = (
            float(title.getY())
            + float(title.getPivotY())
            + (float(title.getHeight()) / 2.0 - float(title.getPivotY())) * scale_y
        )
        pad, half = float(dp(18)), float(dp(23))
        left, right, top, bottom = left - pad, right + pad, center - half, center + half
        mini = self.field(stories, "listViewMini")
        recycler = self.field(stories, "recyclerListView")
        # Во время перехода эти три аватара рисует DialogStoriesCell, не список.
        mini_visible = mini is not None and int(mini.getVisibility()) == 0
        parent = mini if mini_visible else recycler
        cells = self.field(stories, "viewsDrawInParent")
        if mini_visible:
            cells = [parent.getChildAt(i) for i in range(parent.getChildCount())]
        elif cells is not None:
            cells = [cells.get(i) for i in range(cells.size())]
        if parent is not None and cells is not None:
            from org.telegram.ui.ActionBar import ActionBar

            full_size, collapsed_size = float(dp(48)), float(dp(26.33))
            gap, inset = float(dp(5)), float(dp(8))
            parent_x, parent_y = float(parent.getX()), float(parent.getY())
            collapsed_y = (float(ActionBar.getCurrentActionBarHeight()) - collapsed_size) / 2.0
            for cell in cells:
                if float(cell.getAlpha()) <= 0:
                    continue
                progress = float(self.field(cell, "progressToCollapsed") or 0)
                size = full_size + (collapsed_size - full_size) * progress
                x = (
                    parent_x
                    + float(cell.getX())
                    + (float(cell.getMeasuredWidth()) - size) / 2.0 * (1.0 - progress)
                )
                y = parent_y + float(cell.getY()) + gap + (collapsed_y - gap) * progress
                # Оставляем место и выступающим кольцам историй.
                left, right = min(left, x - inset), max(right, x + size + inset)
                top, bottom = min(top, y - inset), max(bottom, y + size + inset)
        state = entry.get("story_title")
        if state is not None and _identity(state[0]) != _identity(title):
            self._restore_materials(drawable_key=_identity(state[1]))
            self._release_drawable(state[1])
            state[1].setCallback(None)
            self._owners.pop(_identity(state[0]), None)
            self._owned_views.remove(state[0])
            entry.pop("story_title", None)
            state = None
        factory = self.glass_factory(owner)
        if state is None:
            if factory is None:
                return
            drawable = factory.create()
            if drawable is None:
                return
            drawable.setPadding(0)
            drawable.setCallback(stories)
            state = (title, drawable)
            entry["story_title"] = state
        drawable = state[1]
        cached = self._styled_glass.get(_identity(drawable))
        if (
            cached is None
            or cached[1][0] != _is_dark()
            or _identity(self.field(drawable, "colorProvider")) != _identity(cached[2])
        ):
            if not self.style_glass_drawable(owner, drawable, float(dp(23))):
                return
        self._sample_header_fade(owner, drawable)
        limit = self._archive_title_right(owner, stories)
        fit = min(1.0, max(0.0, (limit - left) / (right - left))) if limit is not None else 1.0
        right = left + (right - left) * fit
        drawable.setBounds(int(left), int(top), int(right), int(bottom))
        self._sync_surface_offset(owner, stories, drawable, factory)
        # Рисуем до детей, иначе их alpha-слой обрежет левый край капсулы.
        save = canvas.saveLayerAlpha(left, top, right, bottom, int(255 * alpha)) if alpha < 1.0 else None
        try:
            drawable.draw(canvas)
        finally:
            if save is not None:
                canvas.restoreToCount(save)
        return fit, left

    def _style_attach_alert(self, alert):
        if not self._active or alert is None:
            return
        try:
            self._remember_owner(self.field(alert, "containerView"), alert)
            self._known_fragments[_identity(alert)] = alert
            self._repair_blur_source(alert)
            # Не пропускаем ActionBar галереи через setupGlass чата: это меняет её режим.
            bar = self.field(alert, "actionBar")
            surfaces = [
                ("glass_attach", self.field(bar, name))
                for name in ("glassDrawable", "glassDrawableBack", "glassDrawableMenu")
            ]
            wrapper = self.field(alert, "buttonsRecyclerViewWrapper")
            if wrapper is not None:
                surfaces.append(("glass_attach", wrapper.getBackground()))
            # Здесь же освобождаем материалы, которые успел заменить Telegram.
            self._style_native_controls(alert, surfaces)
            # Повторный захват с теми же данными отсекает Java-фильтр.
            self._attach_targets.remove(alert)
            if _identity(alert) in self._capture_states:
                pairs = []
                for obj, names in (
                    (alert, ("actionBar", "buttonsRecyclerViewWrapper", "scrollableViewNoiseSuppressor")),
                    (bar, ("glassDrawable", "glassDrawableBack", "glassDrawableMenu")),
                ):
                    if obj is None:
                        continue
                    for name in names:
                        member = self._java_field(obj, name)
                        if member is None:
                            return
                        pairs.extend((obj, member, self.field(obj, name)))
                for _setting, drawable in surfaces:
                    if drawable is None:
                        continue
                    member = self._java_field(drawable, "colorProvider")
                    if member is None:
                        return
                    pairs.extend((drawable, member, self.field(drawable, "colorProvider")))
                self._attach_targets.put(
                    alert,
                    jarray(jclass("java.lang.Object"))(
                        [wrapper, wrapper.getBackground() if wrapper is not None else None, *pairs]
                    ),
                )
        except Exception as exc:
            self._warn_once("Стекло панели вложений", exc)

    def _style_native_controls(self, owner, surfaces, variant=""):
        if not self._active or owner is None:
            return
        key = _identity(owner)
        current = {_identity(drawable): drawable for _setting, drawable in surfaces if drawable is not None}
        for old_key, drawable in self._native_controls.get(key, {}).items():
            if old_key not in current:
                self._restore_materials(drawable_key=old_key)
                self._release_drawable(drawable)
        self._native_controls[key] = current
        for setting, drawable in surfaces:
            if drawable is None:
                continue
            if self._enabled(setting):
                self._ensure_live_style(owner, drawable, variant=variant)
            elif _identity(drawable) in self._original_drawables:
                self._restore_materials(drawable_key=_identity(drawable))
                self._release_drawable(drawable)

    def _restore_emoji_materials(self, panel=None, drawable_key=None):
        for key, entry in list(self._emoji_materials.items()):
            if panel is not None and _identity(entry["panel"]) != _identity(panel):
                continue
            if drawable_key is not None and key != drawable_key:
                continue
            drawable = entry["drawable"]
            try:
                if not self._set_java_field(drawable, "source", entry["source"], "obj"):
                    raise RuntimeError("Не удалось вернуть источник панели эмодзи")
                self._set_glass_effect(drawable, entry["effect"])
                drawable.invalidateDisplayList()
            except Exception as exc:
                self._warn_once("Восстановление материала эмодзи", exc)
            self._styled_glass.pop(key, None)
            self._emoji_materials.pop(key, None)

    def _style_emoji_controls(self, panel, surfaces):
        current = {_identity(d): self._enabled(setting) for setting, d in surfaces if d is not None}
        suppressor = self.field(panel, "scrollableViewNoiseSuppressor")
        for key, entry in list(self._emoji_materials.items()):
            if _identity(entry["panel"]) == _identity(panel) and (
                key not in current
                or entry["enabled"] != current[key]
                or _identity(entry["suppressor"]) != _identity(suppressor)
            ):
                self._restore_emoji_materials(panel, key)
        self._style_native_controls(panel, surfaces, variant="emoji")
        native_source = self.field(panel, "blurredBackgroundSourceRenderNode")
        if native_source is None or suppressor is None:
            return
        for setting, drawable in surfaces:
            if drawable is None:
                continue
            key, enabled = _identity(drawable), self._enabled(setting)
            entry = self._emoji_materials.get(key)
            if entry is None:
                source = self.field(drawable, "source")
                if _identity(source) != _identity(native_source):
                    continue
                state = self._original_drawables.get(key)
                effect = (
                    state[1].get("liquidGlassEffect")
                    if state is not None
                    else self.field(drawable, "liquidGlassEffect")
                )
                material_source = jclass(
                    "org.telegram.ui.Components.blur3.source.BlurredBackgroundSourceRenderNode"
                )(None)
                # Источник у каждой кнопки свой: переключатели могут отличаться.
                material_source.setScrollableNoiseSuppressor(suppressor, -2 if enabled else -3)
                material_source.setUnderSource(self.field(source, "underSource"))
                entry = {
                    "panel": panel,
                    "drawable": drawable,
                    "source": source,
                    "effect": effect,
                    "enabled": enabled,
                    "suppressor": suppressor,
                    "material_source": material_source,
                }
                self._emoji_materials[key] = entry
            changed = False
            if _identity(self.field(drawable, "source")) != _identity(entry["material_source"]):
                if not self._set_java_field(drawable, "source", entry["material_source"], "obj"):
                    raise RuntimeError("Не удалось переключить источник панели эмодзи")
                changed = True
            # LiteMode-хук мог включить линзу раньше, чем мы прочитали настройки.
            if not enabled and self.field(drawable, "liquidGlassEffect") is not None:
                self._set_glass_effect(drawable, None)
                changed = True
            if changed:
                drawable.invalidateDisplayList()

    def _style_emoji_panel(self, panel):
        if not self._active or panel is None:
            return
        try:
            self._remember_owner(panel, panel)
            self._known_fragments[_identity(panel)] = panel
            if self._enabled("glass_emoji_tabs") or self._enabled("glass_emoji_buttons"):
                self._repair_blur_source(panel)
            else:
                self._drop_capture_limit(_identity(panel))
            # Убираем фон за капсулами, но сохраняем его для выключения.
            panel_key = _identity(panel)
            if panel_key not in self._emoji_backgrounds:
                bottom = self.field(panel, "bottomTabContainerBackground")
                tabs = self.field(panel, "emojiTabs")
                self._emoji_backgrounds[panel_key] = {
                    "panel": panel,
                    "background": panel.getBackground(),
                    "bottom_view": bottom,
                    "bottom": bottom.getBackground() if bottom is not None else None,
                    "tabs_view": tabs,
                    "tabs": tabs.getBackground() if tabs is not None else None,
                }
            else:
                saved = self._emoji_backgrounds[panel_key]
                bottom = self.field(panel, "bottomTabContainerBackground")
                current = panel.getBackground()
                if current is not None and _identity(current) != _identity(saved["background"]):
                    saved["background"] = current
                if bottom is not None and _identity(saved.get("bottom_view")) != _identity(bottom):
                    saved["bottom_view"], saved["bottom"] = bottom, bottom.getBackground()
                elif (
                    bottom is not None
                    and bottom.getBackground() is not None
                    and _identity(bottom.getBackground()) != _identity(saved["bottom"])
                ):
                    saved["bottom"] = bottom.getBackground()
                tabs = self.field(panel, "emojiTabs")
                if tabs is not None and _identity(saved.get("tabs_view")) != _identity(tabs):
                    saved["tabs_view"], saved["tabs"] = tabs, tabs.getBackground()
                elif (
                    tabs is not None
                    and tabs.getBackground() is not None
                    and _identity(tabs.getBackground()) != _identity(saved["tabs"])
                ):
                    saved["tabs"] = tabs.getBackground()
            if self._enabled("glass_emoji_tabs") or self._enabled("glass_emoji_buttons"):
                panel.setBackground(None)
                bottom = self.field(panel, "bottomTabContainerBackground")
                if bottom is not None:
                    bottom.setBackground(None)
                tabs = self.field(panel, "emojiTabs")
                if tabs is not None:
                    tabs.setBackground(None)
            else:
                saved = self._emoji_backgrounds.pop(panel_key, None)
                if saved is not None:
                    panel.setBackground(saved["background"])
                    bottom = self.field(panel, "bottomTabContainerBackground")
                    if bottom is not None:
                        bottom.setBackground(saved["bottom"])
                    tabs = saved.get("tabs_view") or self.field(panel, "emojiTabs")
                    if tabs is not None:
                        tabs.setBackground(saved["tabs"])
            surfaces = []
            for name in ("typeTabs", "backspaceButton", "stickerSettingsButton", "searchButton"):
                view = self.field(panel, name)
                if view is not None:
                    surfaces.append(
                        (
                            "glass_emoji_tabs" if name == "typeTabs" else "glass_emoji_buttons",
                            view.getBackground(),
                        )
                    )
            self._style_emoji_controls(panel, surfaces)
        except Exception as exc:
            self._warn_once("Стекло панели эмодзи", exc)

    def _style_photo_viewer(self, viewer):
        if not self._active or viewer is None:
            return
        try:
            source = self.field(viewer, "blurredBackgroundSource")
            self._known_fragments[_identity(viewer)] = viewer
            for key, current in list(self._photo_sources.items()):
                if _identity(current) == _identity(viewer) and key != _identity(source):
                    self._photo_sources.pop(key, None)
            if source is not None:
                self._photo_sources[_identity(source)] = viewer
            self._refresh_draw_filter_targets()
            self._remember_owner(self.field(viewer, "containerView"), viewer)
            surfaces = []
            tools = self.field(viewer, "itemsLayout")
            if tools is not None:
                surfaces.append(("glass_photo_tools", tools.getBackground()))
            for name in ("captionEdit", "topCaptionEdit"):
                caption = self.field(viewer, name)
                if caption is not None:
                    self._remember_owner(caption, viewer)
                    for field in ("backgroundForCaptionField", "backgroundForCaptionButton"):
                        surfaces.append(("glass_photo_caption", self.field(caption, field)))
            send = self.field(viewer, "pickerViewSendButton")
            surfaces.append(("glass_photo_send", self.field(send, "blurredBackgroundDrawable")))
            self._style_native_controls(viewer, surfaces, variant="photo")
        except Exception as exc:
            self._warn_once("Стекло галереи", exc)

    def _style_mentions(self, fragment):
        if not self._active or fragment is None:
            return
        view = self.field(fragment, "mentionContainer")
        if view is None:
            return
        try:
            self._remember_owner(view, fragment)
            # Границы и clipPath штатный drawable обновляет сам.
            self._style_native_controls(
                fragment, [("glass_mentions", self.field(view, "backgroundDrawable"))]
            )
        except Exception as exc:
            self._warn_once("Стекло подсказок упоминаний", exc)

    def _style_bot_menu(self, fragment):
        if not self._active or fragment is None or self._java_bot_menus is None:
            return
        try:
            intensity, thickness = self._lens_values()
            width = self._outline_width_factor()
            self._java_bot_menus.bind(
                fragment,
                self.make_provider(),
                self._enabled("glass_mentions"),
                float(intensity),
                int(thickness),
                float(dp(RIM_WIDTH_TOP_DP)) * width,
                float(dp(RIM_WIDTH_BOTTOM_DP)) * width,
                0.0 if self._perf.get("no_shadow", True) else float(SHADOW_ALPHA),
            )
        except Exception as exc:
            self._warn_once("Стекло меню бота", exc)

    def _is_settings_header(self, fragment, bar):
        if self.field(bar, "adaptiveBackground"):
            return True
        try:
            name = str(fragment.getClass().getName())
            return (".preferences." in name or ".plugins." in name) and self.field(
                fragment, "listView"
            ) is not None
        except Exception:
            return False

    def _sample_settings_list(self, fragment, drawable):
        view = self.field(fragment, "listView")
        original = self.field(drawable, "source")
        if view is None or original is None:
            return
        self._remember_owner(view, fragment)
        key = _identity(drawable)
        state = self._settings_sources.get(key)
        if state is not None and _identity(original) == _identity(state["proxy"]):
            if _identity(state["proxy"].view) != _identity(view):
                state["proxy"].view = view
                self._refresh_draw_filter_targets()
            return
        try:
            if self._settings_source_class is None:
                plugin = self

                class SettingsSource(
                    dynamic_proxy(jclass("org.telegram.ui.Components.blur3.source.BlurredBackgroundSource"))
                ):
                    def __init__(self, fragment, view, original):
                        super().__init__()
                        self.fragment, self.view, self.original = fragment, view, original
                        self.recording = self.failed = False
                        self.java_flags = jarray(jint)([0, 0])
                        self.captured_at = 0.0
                        self.capture_signature = None
                        self.pending = False
                        self.node = jclass("android.graphics.RenderNode")("TeleGlass settings")
                        self.node.setRenderEffect(
                            jclass("android.graphics.RenderEffect").createBlurEffect(
                                float(dp(1.66)),
                                float(dp(1.66)),
                                jclass("android.graphics.Shader$TileMode").CLAMP,
                            )
                        )

                    def createDrawable(self):
                        return self.original.createDrawable()

                    def dispatchOnDrawablesRelativePositionChange(self):
                        self.original.dispatchOnDrawablesRelativePositionChange()

                    def draw(self, canvas, left, top, right, bottom):
                        self.original.draw(canvas, left, top, right, bottom)
                        if not canvas.isHardwareAccelerated() or self.recording or self.failed:
                            return
                        recording = False
                        try:
                            x, y = plugin._source_position(
                                self.fragment, self.view, plugin.glass_factory(self.fragment)
                            )
                            width, height = max(1, int(right - left)), max(1, int(bottom - top))
                            color = self.fragment.getThemedColor(Theme.key_windowBackgroundGray)
                            signature = (
                                left,
                                top,
                                right,
                                bottom,
                                x,
                                y,
                                _is_dark(),
                                color,
                                _identity(self.view),
                            )
                            fps = plugin._perf.get("glass_fps", 60)
                            round_fps = plugin._perf.get("round_fps", 30) if plugin._round_video_active else 0
                            if round_fps:
                                fps = min(fps, round_fps) if fps else round_fps
                            now = monotonic()
                            remaining = 1.0 / fps - (now - self.captured_at) if fps else 0.0
                            if self.capture_signature == signature and remaining > 0:
                                save = canvas.save()
                                try:
                                    canvas.translate(float(left), float(top))
                                    canvas.drawRenderNode(self.node)
                                finally:
                                    canvas.restoreToCount(save)
                                if not self.pending:
                                    self.pending = True

                                    def refresh():
                                        self.pending = False
                                        if not plugin._active:
                                            return
                                        for state in plugin._settings_sources.values():
                                            if state["proxy"] is self:
                                                state["drawable"].invalidateDisplayList()
                                                state["drawable"].invalidateSelf()

                                    plugin.schedule(refresh, max(1, int(remaining * 1000) + 1))
                                return
                            self.node.setPosition(0, 0, width, height)
                            c = self.node.beginRecording(width, height)
                            recording = self.recording = True
                            self.java_flags[0] = 1
                            # drawColor(long) ждёт ColorLong, поэтому ARGB передаём как jint.
                            c.drawColor(jint(color))
                            root = plugin.field(self.fragment, "fragmentView")
                            background = root.getBackground() if root is not None else None
                            if background is not None:
                                save = c.save()
                                try:
                                    c.translate(float(-left), float(-top))
                                    background.draw(c)
                                finally:
                                    c.restoreToCount(save)
                            save = c.save()
                            c.translate(float(x - left), float(y - top))
                            # Захватываем список без ActionBar, чтобы шапка не отражалась сама в себе.
                            try:
                                if hasattr(self.view, "capture"):
                                    self.view.capture(
                                        c,
                                        jclass("android.graphics.RectF")(
                                            float(left - x),
                                            float(top - y),
                                            float(right - x),
                                            float(bottom - y),
                                        ),
                                    )
                                else:
                                    self.view.draw(c)
                            finally:
                                c.restoreToCount(save)
                            for view, fade, alpha in plugin._header_fade_layers(self.fragment):
                                position = plugin._source_position(
                                    self.fragment, view, plugin.glass_factory(self.fragment)
                                )
                                if position is None:
                                    continue
                                save = c.save()
                                try:
                                    c.translate(float(position[0] - left), float(position[1] - top))
                                    if alpha < 1.0:
                                        bounds = fade.getBounds()
                                        c.saveLayerAlpha(
                                            float(bounds.left),
                                            float(bounds.top),
                                            float(bounds.right),
                                            float(bounds.bottom),
                                            int(255 * alpha),
                                        )
                                    fade.draw(c)
                                finally:
                                    c.restoreToCount(save)
                            self.node.endRecording()
                            recording = self.recording = False
                            self.capture_signature, self.captured_at = signature, now
                            save = canvas.save()
                            try:
                                canvas.translate(float(left), float(top))
                                canvas.drawRenderNode(self.node)
                            finally:
                                canvas.restoreToCount(save)
                        except Exception as exc:
                            self.failed = True
                            self.java_flags[1] = 1
                            plugin._warn_once("Захват списка настроек", exc)
                        finally:
                            if recording:
                                try:
                                    self.node.endRecording()
                                except Exception as exc:
                                    plugin._warn_once("Завершение захвата настроек", exc)
                            self.recording = False
                            self.java_flags[0] = 0

                self._settings_source_class = SettingsSource
            proxy = self._settings_source_class(fragment, view, original)
            self._snapshot_drawable(drawable, fragment)
            self._original_drawables[key][1].setdefault("source", original)
            if not self._set_java_field(drawable, "source", proxy, "obj"):
                raise RuntimeError("Не удалось подключить список настроек к стеклу")
            self._settings_sources[key] = {"proxy": proxy, "drawable": drawable}
            self._refresh_draw_filter_targets()
            drawable.invalidateDisplayList()
        except Exception as exc:
            if key in self._settings_sources:
                self._set_java_field(drawable, "source", original, "obj")
                self._settings_sources.pop(key, None)
                self._refresh_draw_filter_targets()
            self._warn_once("Источник стекла настроек", exc)

    # Шапка чата и поле ввода

    def _style_action_bar(self, fragment):
        if (
            str(fragment.getClass().getName()) == "org.telegram.ui.DialogsActivity"
            and not self.field(fragment, "dialogsType")
            and not self.field(fragment, "onlySelect")
        ):
            self._style_main_header(fragment, allow_archive=True)
            return
        action_bar = self.field(fragment, "actionBar")
        if self._is_settings_header(fragment, action_bar):
            self._remember_owner(action_bar, fragment)
            self._repair_blur_source(fragment)
            for name in ("glassDrawable", "glassDrawableBack", "glassDrawableMenu"):
                drawable = self.field(action_bar, name)
                if self._enabled("glass_settings_header"):
                    self._restore_side_buttons(view=action_bar, field=name)
                    self._ensure_live_style(fragment, drawable)
                    self._sample_settings_list(fragment, drawable)
                else:
                    if _identity(drawable) in self._original_drawables:
                        self._restore_materials(drawable_key=_identity(drawable))
                        self._release_drawable(drawable)
                    if self._active:
                        self._use_stock_header_blur(fragment, action_bar, name)
            return
        # В раскрытом профиле капсула чата перекрывает содержимое шапки.
        try:
            if str(fragment.getClass().getName()) != "org.telegram.ui.ChatActivity":
                return
        except Exception:
            return
        if not self._enabled("glass_header"):
            return
        if action_bar is None:
            return
        self._remember_owner(action_bar, fragment)
        self._snapshot_object(
            action_bar, ("glassDrawable", "glassDrawableBack", "glassDrawableMenu", "glassOnlyBack"), fragment
        )
        self._set_java_field(action_bar, "glassOnlyBack", False, "bool")

        avatar_container = self.field(fragment, "avatarContainer")
        try:
            if avatar_container is not None and _identity(avatar_container) not in self._glass_mode_set:
                self._snapshot_object(avatar_container, ("glassMode", "isGlassMode"), fragment)
                avatar_container.setGlassMode()
                self._glass_mode_set.add(_identity(avatar_container))
        except Exception:
            pass

        names = ("glassDrawable", "glassDrawableBack", "glassDrawableMenu")
        drawables = [self.field(action_bar, n) for n in names]
        drawables = [d for d in drawables if d is not None]

        if not drawables:
            if not self._setup_native_action_bar_glass(fragment, action_bar):
                self._fallback_header_island(fragment, avatar_container)
                return
            drawables = [d for d in (self.field(action_bar, n) for n in names) if d is not None]

        if (
            drawables
            and not self._round_playing
            and self._perf.get("lens", 0) != 2
            and any(not self._drawable_has_lens(d) for d in drawables)
        ):
            key = ("actionbar", _identity(fragment))
            if key not in self._native_rebuilt:
                self._native_rebuilt.add(key)
                factory = self.glass_factory(fragment)
                provider = self.make_provider()
                if factory is not None and provider is not None:
                    try:
                        try:
                            self._snapshot_object(factory, ("isLiquidGlassEffectAllowed",), fragment)
                            factory.setLiquidGlassEffectAllowed(True)
                        except Exception:
                            pass
                        action_bar.setupGlass(factory, provider)
                        drawables = [d for d in (self.field(action_bar, n) for n in names) if d is not None]
                    except Exception:
                        pass

        sample = None
        for drawable in drawables:
            self.style_glass_drawable(fragment, drawable)
            if sample is None:
                try:
                    sample = self._header_fade_sample(fragment)
                except Exception as exc:
                    self._warn_once("Выборка фона градиента шапки", exc)
                    sample = False
            if sample is not False:
                self._sample_header_fade(fragment, drawable, sample, opacity=0.90)

        self._remove_header_island(avatar_container)
        try:
            action_bar.invalidate()
        except Exception:
            pass

    def _setup_native_action_bar_glass(self, fragment, action_bar):
        if not hasattr(action_bar, "setupGlass"):
            return False
        self._snapshot_object(
            action_bar, ("glassDrawable", "glassDrawableBack", "glassDrawableMenu", "glassOnlyBack"), fragment
        )
        factory = self.glass_factory(fragment)
        provider = self.make_provider()
        if factory is None or provider is None:
            return False
        try:
            try:
                self._snapshot_object(factory, ("isLiquidGlassEffectAllowed",), fragment)
                factory.setLiquidGlassEffectAllowed(True)
            except Exception:
                pass
            action_bar.setupGlass(factory, provider)
            self._set_java_field(action_bar, "glassOnlyBack", False, "bool")
            self._remove_header_island(self.field(fragment, "avatarContainer"))
            return True
        except Exception:
            return False

    def _style_input(self, fragment):
        # У «Обсудить» тоже убираем второй фон, если оформляем нижнюю панель.
        if not (self._enabled("glass_input") or self._enabled("glass_bottom")):
            return
        container = self.field(fragment, "chatInputViewsContainer")
        if container is not None:
            self._remember_owner(container, fragment)
            self._snapshot_object(
                container,
                (
                    "blurredBackgroundDrawable",
                    "inputIslandBubbleDrawable",
                    "drawInputBackground",
                    "background",
                ),
                fragment,
            )
            if container.getBackground() is not None:
                container.setBackground(None)
            enter_view = self.field(fragment, "chatActivityEnterView")
            if enter_view is not None:
                self._snapshot_object(enter_view, ("background",), fragment)
                if enter_view.getBackground() is not None:
                    enter_view.setBackground(None)
            drawables = []
            for name in ("blurredBackgroundDrawable", "inputIslandBubbleDrawable"):
                drawable = self.field(container, name)
                if drawable is not None:
                    drawables.append(drawable)

            if drawables:
                for drawable in drawables:
                    if not self._drawable_has_lens(drawable):
                        rebuilt = self._rebuild_input_island(fragment, container)
                        if rebuilt is not None:
                            drawables = [rebuilt]
                            break
                for drawable in drawables:
                    self.style_glass_drawable(fragment, drawable)
                    self._sample_input_backdrop(fragment, drawable)
                # drawInputBackground рисует саму капсулу поля, а не лишнюю заливку.
                if not self.field(container, "drawInputBackground"):
                    self._set_java_field(container, "drawInputBackground", True, "bool")
                try:
                    container.invalidate()
                except Exception:
                    pass
                return

        self._fallback_input_island(fragment)

    def _style_camera_controls(self, fragment):
        camera = self.field(fragment, "instantCameraView")
        if camera is None:
            return
        try:
            buttons, zoom = camera.getButtonsLayout(), camera.getZoomSlider()
            surfaces = [
                (buttons, buttons.getBackground() if buttons is not None else None),
                (zoom, self.field(zoom, "blurBackground")),
            ]
            key = _identity(camera)
            current = {_identity(d): d for _view, d in surfaces if d is not None}
            for old_key, drawable in self._native_controls.get(key, {}).items():
                if old_key not in current:
                    self._restore_materials(drawable_key=old_key)
                    self._release_drawable(drawable)
            self._native_controls[key] = current
            self._remember_owner(camera, fragment)
            for view, drawable in surfaces:
                if drawable is None:
                    continue
                self._remember_owner(view, fragment)
                if self._enabled("glass_input"):
                    # Размеры и анимацию зума рассчитывает сама камера.
                    self._ensure_live_style(fragment, drawable)
                    self._sample_input_backdrop(fragment, drawable)
                    self._sync_surface_offset(fragment, view, drawable, self.glass_factory(fragment))
                elif _identity(drawable) in self._original_drawables:
                    self._restore_materials(drawable_key=_identity(drawable))
                    self._release_drawable(drawable)
        except Exception as exc:
            self._warn_once("Капсулы камеры", exc)

    def _sample_input_backdrop(self, fragment, drawable):
        if not self._enabled("glass_input") or _identity(drawable) not in self._styled_glass:
            return
        try:
            view = self.field(fragment, "roundVideoRecordBackground")
            background = view.getBackground() if view is not None else None
            layers, signature = [], ()
            if background is not None and int(view.getVisibility()) == 0 and float(view.getAlpha()) > 0:
                position = self._source_position(fragment, view, self.glass_factory(fragment))
                if position is not None:
                    x, y = position
                    alpha, bounds = float(view.getAlpha()), background.getBounds()
                    # Берём фон самой записи: его цвет и плотность меняются в анимации.
                    layers = [(view, background, alpha, x, y)]
                    signature = (
                        _identity(background),
                        x,
                        y,
                        alpha,
                        int(background.getAlpha()),
                        bounds.left,
                        bounds.top,
                        bounds.right,
                        bounds.bottom,
                        _is_dark(),
                    )
            self._sample_header_fade(fragment, drawable, (layers, signature))
        except Exception as exc:
            self._warn_once("Подложка записи в поле ввода", exc)

    def _cache_input_gate(self, fragment, target):
        if self._java_runtime is None or not self._enabled("glass_input"):
            return
        self._java_input_targets.remove(target)
        try:
            backdrop = self.field(fragment, "roundVideoRecordBackground")
            if backdrop is not None and int(backdrop.getVisibility()) == 0 and float(backdrop.getAlpha()) > 0:
                return
            objects, fields, views = [], [], {}

            def watch(obj, names):
                if obj is None:
                    return
                for name in names:
                    member = self._java_field(obj, name)
                    if member is None:
                        raise RuntimeError("input gate field: " + name)
                    objects.append(obj)
                    fields.append(member)

            def view_chain(view):
                for _ in range(64):
                    if view is None or _identity(view) in views:
                        return
                    views[_identity(view)] = view
                    parent = view.getParent()
                    view = parent if isinstance(parent, View) else None
                raise RuntimeError("input gate parent depth")

            watch(fragment, ("chatInputViewsContainer", "instantCameraView", "roundVideoRecordBackground"))
            watch(fragment, ("glassBackgroundDrawableFactory",))
            factory = self.glass_factory(fragment)
            watch(factory, ("parent",))
            container = self.field(fragment, "chatInputViewsContainer")
            camera = self.field(fragment, "instantCameraView")
            backdrop = self.field(fragment, "roundVideoRecordBackground")
            surfaces = []
            if container is not None:
                watch(container, ("blurredBackgroundDrawable", "inputIslandBubbleDrawable"))
                surfaces += [
                    self.field(container, name)
                    for name in ("blurredBackgroundDrawable", "inputIslandBubbleDrawable")
                ]
                view_chain(container)
            if camera is not None:
                watch(camera, ("buttonsLayout", "zoomSlider"))
                buttons, zoom = camera.getButtonsLayout(), camera.getZoomSlider()
                watch(zoom, ("blurBackground",))
                surfaces += [
                    buttons.getBackground() if buttons is not None else None,
                    self.field(zoom, "blurBackground"),
                ]
                view_chain(camera)
                view_chain(buttons)
                view_chain(zoom)
            view_chain(backdrop)
            for drawable in surfaces:
                if drawable is None:
                    continue
                if _identity(drawable) not in self._styled_glass:
                    return
                watch(
                    drawable,
                    (
                        "source",
                        "colorProvider",
                        "liquidGlassEffect",
                        "boundProps",
                        "sourceOffsetX",
                        "sourceOffsetY",
                    ),
                )
                watch(self.field(drawable, "boundProps"), ("liquidIntensity", "liquidThickness"))
            if not surfaces:
                return
            self._java_input_targets.put(
                target,
                self._java_runtime.inputGate(
                    jarray(jclass("java.lang.Object"))(objects),
                    jarray(jclass("java.lang.reflect.Field"))(fields),
                    jarray(View)(list(views.values())),
                    backdrop,
                ),
            )
        except Exception as exc:
            self._warn_once("Фильтр ввода через Java недоступен, используем Python", exc)

    def _rebuild_input_island(self, fragment, container):
        key = ("input", _identity(container))
        if key in self._native_rebuilt:
            return None
        self._native_rebuilt.add(key)
        factory = self.glass_factory(fragment)
        if factory is None or not hasattr(container, "setInputIslandBubbleDrawable"):
            return None
        try:
            try:
                self._snapshot_object(factory, ("isLiquidGlassEffectAllowed",), fragment)
                factory.setLiquidGlassEffectAllowed(True)
            except Exception:
                pass
            drawable = factory.create(container)
            self._track_native_position(drawable, factory)
            if drawable is None:
                return None
            container.setInputIslandBubbleDrawable(drawable)
            self.style_glass_drawable(fragment, drawable)
            return drawable
        except Exception:
            return None

    def _fallback_input_island(self, fragment):
        enter_view = self.field(fragment, "chatActivityEnterView")
        if enter_view is None:
            return
        text_container = self.field(enter_view, "textFieldContainer")
        if text_container is None:
            return

        key = _identity(text_container)
        entry = self._fallback_inputs.get(key)
        if entry is not None:
            fragment_now = get_last_fragment()
            if fragment_now is not None:
                self.style_glass_drawable(fragment_now, entry["surface"], radius=entry["radius"])
            return

        w = int(text_container.getWidth() or 0)
        h = int(text_container.getHeight() or 0)
        if w <= 0 or h <= 0:
            return

        try:
            self._snapshot_object(enter_view, ("background",), fragment)
            self._snapshot_object(text_container, ("background",), fragment)
            enter_view.setBackground(None)
        except Exception:
            pass

        radius = min(h / 2.0, dp(24.0))
        surface = self.create_glass_surface(fragment, text_container, radius)
        if surface is None:
            return

        entry = {
            "surface": surface,
            "view": text_container,
            "fragment": fragment,
            "radius": radius,
            "rim_sig": None,
        }
        self._fallback_inputs[key] = entry
        self.log("Поле ввода: создан резервный фон")
        self._apply_rim(key, text_container, radius, w, h, (w, h), entry)

    # Очередь обновлений, привязки View и освобождение экранов

    def _queue_chat(self, fragment):
        if fragment is None or not self._active or self.field(fragment, "isFinished"):
            return
        self._prune_closed_fragments()
        key = _identity(fragment)
        if key in self._pending_chats:
            return
        self._pending_chats.add(key)
        token = self._chat_tokens.setdefault(key, object())
        self._known_fragments[key] = fragment

        def apply():
            if self._active and self._chat_tokens.get(key) is token:
                current = self._known_fragments.get(key)
                if current is not None:
                    if self.field(current, "isFinished"):
                        self._drop_chat(current)
                    else:
                        self._patch_chat(current)

        def finish():
            try:
                apply()
            finally:
                if self._chat_tokens.get(key) is token:
                    self._pending_chats.discard(key)

        self.schedule(apply, 0)
        # Поздний закреп и кнопки подхватят layout/create-хуки, повторный обход не нужен.
        self.schedule(finish, 180)

    def _queue_capsules(self, fragment):
        if fragment is None or not self._active or self.field(fragment, "isFinished"):
            return
        key = _identity(fragment)
        self._known_fragments[key] = fragment
        token = self._chat_tokens.setdefault(key, object())
        if key in self._pending_capsules:
            return
        self._pending_capsules[key] = token

        def apply():
            if self._active and self._chat_tokens.get(key) is token:
                current = self._known_fragments.get(key)
                if current is not None:
                    if self.field(current, "isFinished"):
                        self._drop_chat(current)
                    else:
                        self._repair_chat_capsules(current, True)

        def finish():
            try:
                apply()
            finally:
                if self._pending_capsules.get(key) is token:
                    self._pending_capsules.pop(key, None)

        for delay in (16, 64, 180, 400):
            self.schedule(apply, delay)
        self.schedule(finish, 800)

    def _remember_owner(self, view, fragment):
        if view is not None:
            key = _identity(view)
            previous = self._owners.get(key)
            if previous is None or _identity(previous[1]) != _identity(fragment):
                self._owners[key] = (view, fragment)
                self._owned_views.add(view)

    def _owner(self, view):
        entry = self._owners.get(_identity(view))
        return entry[1] if entry is not None else None

    def _prune_closed_fragments(self):
        now = monotonic()
        if now - self._last_cleanup < 5.0:
            return
        self._last_cleanup = now
        fragments = dict(self._known_fragments)
        for _view, owner in self._owners.values():
            if owner is not None:
                fragments[_identity(owner)] = owner
        for key, fragment in fragments.items():
            if self.field(fragment, "isFinished"):
                self._drop_chat(fragment)
                continue
            root = self.field(fragment, "fragmentView")
            try:
                if root is None or root.isAttachedToWindow():
                    self._detached_fragments.pop(key, None)
                    continue
                layout = fragment.getParentLayout()
                if layout is None:
                    self._detached_fragments.pop(key, None)
                    continue
                stack = layout.getFragmentStack()
                if stack is None or any(_identity(item) == key for item in stack):
                    self._detached_fragments.pop(key, None)
                    continue
            except Exception:
                # Без стека нельзя отличить закрытый экран от временно скрытого.
                self._detached_fragments.pop(key, None)
                continue
            since = self._detached_fragments.setdefault(key, now)
            if now - since >= 30.0:
                self._drop_chat(fragment)

    def _remove_view_listeners(self, key):
        position = self._pinned_positions.pop(key, None)
        if position is not None:
            try:
                observer, listener = position
                if self._pre_draw_depth:
                    removal_key = (_identity(observer), _identity(listener))
                    if removal_key not in self._deferred_listener_removals:
                        self._deferred_listener_removals[removal_key] = (observer, listener)

                        def remove_later(key=removal_key):
                            saved = self._deferred_listener_removals.pop(key, None)
                            if saved is not None and saved[0].isAlive():
                                saved[0].removeOnPreDrawListener(saved[1])

                        self.schedule(remove_later, 0)
                elif observer.isAlive():
                    observer.removeOnPreDrawListener(listener)
            except Exception as exc:
                self._warn_once("Удаление обработчика позиции закрепа", exc)
        for layouts in (self._pinned_layouts, self._player_layouts):
            entry = layouts.pop(key, None)
            if entry is not None:
                try:
                    entry[0].removeOnLayoutChangeListener(entry[1])
                except Exception as exc:
                    self._warn_once("Удаление обработчика разметки чата", exc)
        surface = self._surface_positions.pop(key, None)
        if surface is not None:
            self._round_positions.remove(surface["view"])

    def _unwatch_surface(self, view):
        self._java_bulletin_targets.remove(view)
        self._surface_positions.pop(_identity(view), None)
        self._round_positions.remove(view)

    def _watch_surface(self, fragment, view, surface, factory=None):
        key = _identity(view)
        factory = factory if factory is not None else self.glass_factory(fragment)
        entry = self._surface_positions.get(key)
        if (
            entry is None
            or _identity(entry["surface"]) != _identity(surface)
            or _identity(entry["factory"]) != _identity(factory)
            or _identity(entry["fragment"]) != _identity(fragment)
        ):
            entry = {"fragment": fragment, "view": view, "surface": surface, "factory": factory}
            self._surface_positions[key] = entry
        self._sync_surface_offset(fragment, view, surface, entry["factory"])

    def _watch_player_layout(self, context_view):
        key = _identity(context_view)
        if key in self._player_layouts:
            return
        try:
            plugin = self

            class PlayerLayout(dynamic_proxy(jclass("android.view.View$OnLayoutChangeListener"))):
                def onLayoutChange(
                    self, view, left, top, right, bottom, old_left, old_top, old_right, old_bottom
                ):
                    if plugin._active:
                        plugin._style_player(view)

            listener = PlayerLayout()
            context_view.addOnLayoutChangeListener(listener)
            self._player_layouts[key] = (context_view, listener)
        except Exception as exc:
            self._warn_once("Разметка плеера", exc)

    def _restore_main_nav(self, key):
        entry = self._main_nav.pop(key, None)
        if entry is None:
            return
        view, owner = entry["view"], entry["owner"]
        self._unwatch_surface(view)
        try:
            if entry.get("native_reuse"):
                state = self._original_drawables.get(_identity(entry["surface"]))
                if state is not None:
                    surface, fields, props, alpha = state
                    if fields.get("colorProvider") is not None:
                        surface.setColorProvider(fields["colorProvider"])
                    if "liquidIntensity" in props:
                        surface.setIntensity(float(props["liquidIntensity"]))
                    if "liquidThickness" in props:
                        surface.setThickness(int(props["liquidThickness"]))
                    if "liquidGlassEffect" in fields:
                        self._set_java_field(surface, "liquidGlassEffect", fields["liquidGlassEffect"], "obj")
                    surface.setAlpha(alpha)
                    surface.updateColors()
            if _identity(view.getBackground()) == _identity(entry["surface"]):
                padding = (
                    int(view.getPaddingLeft()),
                    int(view.getPaddingTop()),
                    int(view.getPaddingRight()),
                    int(view.getPaddingBottom()),
                )
                view.setBackground(entry["original_background"])
                view.setPadding(*padding)
            if _identity(self.field(owner, "tabsViewBackground")) == _identity(entry["surface"]):
                self._set_java_field(owner, "tabsViewBackground", entry["original_field"], "obj")
            view.invalidate()
            self._styled_glass.pop(_identity(entry["surface"]), None)
        except Exception as exc:
            self._warn_once("Восстановление главной навигации", exc)

    def _style_main_nav(self, owner):
        if owner is None or not self._active:
            return
        # Источник MainTabsActivity отдельный; лимит кружка нужен и ему.
        self._repair_blur_source(owner)
        view = self.field(owner, "tabsView")
        native = self.field(owner, "tabsViewBackground")
        if view is None or native is None:
            return
        key = _identity(view)
        self._main_owners[_identity(owner)] = owner
        self._remember_owner(view, owner)
        if not self._enabled("glass_main_nav"):
            self._restore_main_nav(key)
            return
        if key in self._styling_main:
            return
        self._styling_main.add(key)
        try:
            states = self.field(owner, "fragmentsArr")
            if states is not None:
                for index in range(int(states.size())):
                    child = self.field(states.valueAt(index), "fragment")
                    if child is not None and self.field(child, "fragmentView") is not None:
                        self._repair_blur_source(child)
                        self._remember_owner(self.field(child, "fragmentView"), child)
            entry = self._main_nav.get(key)
            if entry is not None and _identity(entry["surface"]) != _identity(native):
                self._restore_main_nav(key)
                entry = None
            if entry is None:
                root = self.field(owner, "contentView") or self.field(owner, "fragmentView")
                factory = jclass("org.telegram.ui.Components.blur3.BlurredBackgroundDrawableViewFactory")(
                    native.getSource()
                )
                if root is not None:
                    self._set_java_field(factory, "parent", root, "obj")
                self._snapshot_drawable(native, owner)
                entry = {
                    "view": view,
                    "owner": owner,
                    "surface": native,
                    "original_field": native,
                    "original_background": view.getBackground(),
                    "factory": factory,
                    "native_reuse": True,
                }
                self._track_native_position(native, self.field(owner, "iBlur3FactoryGlass"))
                self._main_nav[key] = entry
                self.log("Главная навигация: стекло подключено")
            # Без штатного градиента фон за капсулой темнеет и виден шов.
            self._ensure_live_style(owner, native, dp(28))
            if _identity(view.getBackground()) != _identity(native):
                padding = (
                    int(view.getPaddingLeft()),
                    int(view.getPaddingTop()),
                    int(view.getPaddingRight()),
                    int(view.getPaddingBottom()),
                )
                view.setBackground(native)
                view.setPadding(*padding)
            self._watch_surface(owner, view, native, entry["factory"])
            self._bind_home_guard(owner)
            entry["next_style_check"] = monotonic() + 1.0
        except Exception as exc:
            self._warn_once("Штатное стекло главной навигации", exc)
        finally:
            self._styling_main.discard(key)

    def _update_main_nav_frame(self, owner, view):
        entry = self._main_nav.get(_identity(view))
        if self._round_video_active and entry is not None:
            now = monotonic()
            if now < entry.get("round_next_position", 0.0):
                return
            entry["round_next_position"] = now + 1.0 / max(1, self._perf.get("round_fps", 30))
        if (
            entry is None
            or monotonic() >= entry.get("next_style_check", 0)
            or _identity(view.getBackground()) != _identity(entry["surface"])
        ):
            self._style_main_nav(owner)
            return
        self._sync_surface_offset(owner, view, entry["surface"], entry["factory"])

    def _ensure_live_style(self, fragment, drawable, radius=None, variant=""):
        key = _identity(drawable)
        cached = self._styled_glass.get(key)
        current = self.field(drawable, "colorProvider")
        if cached is not None and len(cached) > 2 and _identity(current) != _identity(cached[2]):
            self._styled_glass.pop(key, None)
        effect = self.field(drawable, "liquidGlassEffect")
        entry = self._main_nav.get(_identity(self.field(fragment, "tabsView")))
        if cached is not None and entry is not None:
            props = self.field(drawable, "boundProps")
            intensity, thickness = self._lens_values()
            if self._round_playing:
                intensity = 0.0
            actual_intensity = self.field(props, "liquidIntensity")
            actual_thickness = self.field(props, "liquidThickness")
            if (actual_intensity is not None and abs(float(actual_intensity) - intensity) > 0.001) or (
                actual_thickness is not None and int(actual_thickness) != thickness
            ):
                self._styled_glass.pop(key, None)
        if effect is None and not self._round_playing and entry is not None and entry.get("had_lens"):
            self._lens_attempted.discard(key)
        if (
            not self._round_playing
            and self._perf.get("lens", 0) != 2
            and key not in self._lens_attempted
            and effect is None
        ):
            self._styled_glass.pop(key, None)
        self.style_glass_drawable(fragment, drawable, radius, variant=variant)
        if entry is not None:
            entry["had_lens"] = self.field(drawable, "liquidGlassEffect") is not None

    def _discover_main_nav(self, fragment):
        if not self._active or fragment is None or self.field(fragment, "isFinished"):
            return
        self._prune_closed_fragments()
        self._discover_folders(fragment)
        try:
            cls = str(fragment.getClass().getName())
            if cls == "org.telegram.ui.MainTabsActivity":
                self._style_main_nav(fragment)
                return
            layout = fragment.getParentLayout()
            if layout is None:
                return
            stack = layout.getFragmentStack()
            if stack is None:
                return
            for index in range(min(int(stack.size()), 20)):
                candidate = stack.get(index)
                if str(candidate.getClass().getName()) == "org.telegram.ui.MainTabsActivity":
                    self._style_main_nav(candidate)
                    return
        except Exception as exc:
            self._warn_once("Поиск главной навигации", exc)

    def _install_main_nav_hooks(self):
        plugin = self

        class MainNavHook(MethodHook):
            def after_hooked_method(self, param):
                native = plugin.field(param.thisObject, "tabsViewBackground")
                plugin._styled_glass.pop(_identity(native), None)
                plugin._style_main_nav(param.thisObject)

        class MainNavLayoutHook(MethodHook):
            def after_hooked_method(self, param):
                if not plugin._active:
                    return
                entry = plugin._main_nav.get(_identity(param.thisObject))
                if entry is not None:
                    plugin._style_main_nav(entry["owner"])

        class MainNavDestroyHook(MethodHook):
            def after_hooked_method(self, param):
                plugin._drop_chat(param.thisObject)

        class DialogsNavHook(MethodHook):
            def after_hooked_method(self, param):
                if plugin._active:
                    plugin._discover_main_nav(param.thisObject)

        try:
            cls = find_class("org.telegram.ui.MainTabsActivity")
            if cls is None:
                self._warn_once("Главная навигация", "MainTabsActivity отсутствует в этой сборке")
                return
            for name in ("createView", "onResume", "blur3_updateColors"):
                self._hook_optional(cls, name, MainNavHook())
            self._hook_optional(cls, "onFragmentDestroy", MainNavDestroyHook())
            layout = find_class("org.telegram.ui.MainTabsLayout")
            self._hook_optional(layout, "onLayout", MainNavLayoutHook())
            dialogs = find_class("org.telegram.ui.DialogsActivity")
            self._hook_optional(dialogs, "onResume", DialogsNavHook())
            for name in ("ContactsActivity", "SettingsActivity", "ProfileActivity"):
                self._hook_optional(
                    find_class("org.telegram.ui." + name), "onFragmentDestroy", MainNavDestroyHook()
                )
        except Exception as exc:
            self._warn_once("Хуки главной навигации", exc)

    def _drop_chat(self, fragment):
        key = _identity(fragment)
        if getattr(self, "_media_glass", None):
            self._drop_media_glass(fragment)
        if self._java_stock_panels is not None:
            try:
                self._java_stock_panels.drop(fragment)
            except Exception as exc:
                self._warn_once("Освобождение штатных панелей", exc)
        if self._java_bot_menus is not None:
            try:
                self._java_bot_menus.drop(fragment)
            except Exception as exc:
                self._warn_once("Освобождение меню бота", exc)
        self._restore_emoji_materials(fragment)
        self._drop_capture_limit(key)
        self._attach_targets.remove(fragment)
        self._restore_folder_blur(fragment)
        self._restore_side_buttons(fragment)
        for source_key, viewer in list(self._photo_sources.items()):
            if _identity(viewer) == key:
                self._photo_sources.pop(source_key, None)
        self._refresh_draw_filter_targets()
        self._native_controls.pop(key, None)
        for view, owner in self._owners.values():
            if _identity(owner) == key:
                self._java_tabs_targets.remove(view)
                self._java_input_targets.remove(view)
                self._native_controls.pop(_identity(view), None)
        emoji_background = self._emoji_backgrounds.pop(key, None)
        if emoji_background is not None:
            try:
                fragment.setBackground(emoji_background["background"])
                bottom = self.field(fragment, "bottomTabContainerBackground")
                if bottom is not None:
                    bottom.setBackground(emoji_background["bottom"])
                tabs = emoji_background.get("tabs_view") or self.field(fragment, "emojiTabs")
                if tabs is not None:
                    tabs.setBackground(emoji_background["tabs"])
            except Exception as exc:
                self._warn_once("Освобождение панели эмодзи", exc)
        self._forget_home_guard(fragment)
        for nav_key, entry in list(self._main_nav.items()):
            if _identity(entry["owner"]) == key:
                self._restore_main_nav(nav_key)
        self._main_owners.pop(key, None)
        self._restore_main_search(_identity(fragment))
        self._restore_main_header(_identity(fragment))
        self._detached_fragments.pop(key, None)
        self._chat_tokens.pop(key, None)
        self._pending_chats.discard(key)
        self._pending_capsules.pop(key, None)
        self._pending_pinned.pop(key, None)
        self._pinned_retry_counts.pop(key, None)
        self._repair_times.pop(key, None)
        self._checking_capsules.discard(key)
        view_keys = {k for k, (_view, owner) in self._owners.items() if _identity(owner) == key}
        view_keys.update(k for k, owner in self._object_owners.items() if owner == key)
        for cache in (
            self._pinned_surfaces,
            self._top_surfaces,
            self._extra_surfaces,
            self._fallback_inputs,
            self._header_islands,
            self._surface_positions,
        ):
            for entry in cache.values():
                if _identity(entry.get("fragment")) == key:
                    view_keys.add(_identity(entry.get("view") or entry.get("container")))
        for k in view_keys:
            self._round_panel_clips.pop(k, None)
            if k in self._owners:
                self._panel_divider_targets.remove(self._owners[k][0])
            self._remove_view_listeners(k)
        for k, entry in list(self._pinned_surfaces.items()):
            if _identity(entry.get("fragment")) == key:
                self._restore_pinned_entry(entry)
                self._pinned_surfaces.pop(k, None)
        for cache, restore in (
            (self._top_surfaces, self._restore_top_surface),
            (self._extra_surfaces, self._restore_extra_surface),
        ):
            for k, entry in list(cache.items()):
                if _identity(entry.get("fragment")) == key:
                    restore(k)
        for k, entry in list(self._native_surfaces.items()):
            if _identity(entry[0]) in view_keys:
                self._restore_native_surface(k)
        for cache, restore in (
            (self._player_native_colors, self._restore_player_native_blur),
            (self._pinned_native_colors, self._restore_pinned_native_blur),
        ):
            for k, (view, _color) in list(cache.items()):
                if k in view_keys:
                    restore(view)
        self._restore_round_button_backgrounds(fragment)
        for k, (panel, drawable) in list(self._panel_backgrounds.items()):
            if k in view_keys:
                self._panel_blur_targets.remove(drawable)
                if self.field(panel, "backgroundDrawable") is None:
                    self._set_java_field(panel, "backgroundDrawable", drawable, "obj")
                self._panel_backgrounds.pop(k, None)
        for entry in list(self._patched_dates.values()):
            if _identity(entry.get("fragment")) == key:
                if _identity(entry["cell"]) == self._floating_date_key:
                    self._floating_date_key = 0
                    self._floating_date_holder[0] = 0
                self._unpatch_date(entry["cell"])
        for k, entry in list(self._header_islands.items()):
            if _identity(entry.get("fragment")) == key:
                self._remove_header_island(entry["container"])
        for k, entry in list(self._fallback_inputs.items()):
            if _identity(entry.get("fragment")) == key:
                try:
                    rim = self._rims.pop(k, None)
                    if rim is not None:
                        entry["view"].getOverlay().remove(rim)
                    if _identity(entry["view"].getBackground()) == _identity(entry["surface"]):
                        entry["view"].setBackground(None)
                except Exception as exc:
                    self._warn_once("Освобождение поля ввода", exc)
                self._fallback_inputs.pop(k, None)
        drawables = [
            state[0] for k, state in self._original_drawables.items() if self._drawable_owners.get(k) == key
        ]
        self._restore_materials(fragment)
        for drawable in drawables:
            self._release_drawable(drawable)
        for k, owner in list(self._object_owners.items()):
            if owner == key:
                self._object_owners.pop(k, None)
        for k in view_keys:
            if self._round_targets is not None and k in self._owners:
                self._round_targets.remove(self._owners[k][0])
            if k in self._owners:
                self._owned_views.remove(self._owners[k][0])
            self._owners.pop(k, None)
            self._glass_mode_set.discard(k)
            self._pinned_busy.discard(k)
        self._native_rebuilt = {k for k in self._native_rebuilt if k[1] not in view_keys and k[1] != key}
        for k in list(self._provider_cache):
            if k[0] == key:
                self._provider_cache.pop(k, None)
        self._known_fragments.pop(key, None)
        self._folder_owners.pop(key, None)
        self.log("Чат: ресурсы освобождены")

    def _repair_chat_capsules(self, fragment, force=False):
        if fragment is None or not self._active:
            return
        key = _identity(fragment)
        now = monotonic()
        if not force and now - self._repair_times.get(key, -1) < 1.0 / 30.0:
            return
        self._repair_times[key] = now
        if key in self._checking_capsules:
            return
        self._checking_capsules.add(key)
        try:
            panel = self.field(fragment, "topPanelLayout")
            self._remember_owner(panel, fragment)
            for name, setting in (
                ("translateButton", "glass_translate"),
                ("addProfilePictureButton", "glass_bot_photo"),
                ("topChatPanelView", "glass_report_spam"),
            ):
                view = self.field(fragment, name)
                if view is None:
                    continue
                entry = self._top_surfaces.get(_identity(view))
                if not self._enabled(setting):
                    if entry is not None:
                        self._restore_top_surface(_identity(view))
                    continue
                if int(view.getVisibility()) != 0:
                    continue
                size = (int(view.getWidth()), int(view.getHeight()))
                if size[0] <= 0 or size[1] <= 0:
                    continue
                child = self.field(view, "textView") if name == "translateButton" else None
                child_reset = child is not None and child.getBackground() is not None
                if (
                    entry is None
                    or force
                    or child_reset
                    or entry.get("layout_size") != size
                    or _identity(view.getBackground()) != _identity(entry["installed"])
                ):
                    self._install_top_surface(fragment, view, setting, child)
                    entry = self._top_surfaces.get(_identity(view))
                    if entry is not None:
                        entry["layout_size"] = size

            pinned = self.field(fragment, "pinnedMessageView")
            pinned_entry = None
            if pinned is not None:
                pinned_entry = self._pinned_surfaces.get(_identity(pinned))
                if not self._enabled("glass_pinned"):
                    if pinned_entry is not None:
                        self._restore_pinned_entry(pinned_entry)
                        self._pinned_surfaces.pop(_identity(pinned), None)
                    self._restore_pinned_native_blur(pinned)
                    pinned_entry = None
                elif (
                    int(pinned.getVisibility()) == 0
                    and int(pinned.getWidth()) > 0
                    and int(pinned.getHeight()) > 0
                ):
                    size = (int(pinned.getWidth()), int(pinned.getHeight()))
                    if (
                        pinned_entry is None
                        or force
                        or pinned_entry.get("layout_size") != size
                        or _identity(pinned.getBackground()) != _identity(pinned_entry["installed_background"])
                    ):
                        self._style_pinned_message(fragment)
                        pinned_entry = self._pinned_surfaces.get(_identity(pinned))
                        if pinned_entry is not None:
                            pinned_entry["layout_size"] = size
                    if pinned_entry is not None:
                        self._disable_pinned_native_blur(pinned)
                elif pinned_entry is not None:
                    self._restore_pinned_native_blur(pinned)

            context = self.field(fragment, "fragmentContextView")
            if context is not None:
                self._remember_owner(context, fragment)
                frame = self.field(context, "frameLayout")
                try:
                    style = int(context.getCurrentStyle())
                except Exception:
                    style = self.field(context, "currentStyle")
                if frame is not None:
                    player_entry = self._top_surfaces.get(_identity(frame))
                    player_visible = False
                    try:
                        player_visible = (
                            int(frame.getVisibility()) == 0
                            and int(context.getVisibility()) == 0
                            and float(frame.getAlpha()) > 0.001
                        )
                    except Exception:
                        player_visible = False
                    if (
                        player_visible
                        and style is not None
                        and int(style) == 0
                        and self._enabled("glass_player")
                    ):
                        size = (int(frame.getWidth()), int(frame.getHeight()))
                        if size[0] > 0 and size[1] > 0:
                            if (
                                player_entry is None
                                or force
                                or player_entry.get("layout_size") != size
                                or _identity(frame.getBackground()) != _identity(player_entry["installed"])
                            ):
                                self._style_player(context)
                                player_entry = self._top_surfaces.get(_identity(frame))
                                if player_entry is not None:
                                    player_entry["layout_size"] = size
                    elif player_entry is not None:
                        self._restore_top_surface(_identity(frame))
                        self._restore_player_native_blur(frame)
            # Не вырезаем штатный фон, пока не готовы наши капсулы.
            self._suppress_panel_background(panel)
            # Кнопки выделения могли появиться позже; обновляем их отдельно от плеера.
            self._style_forward_button(fragment)
            # Плеер может сбросить фон закрепа, поэтому закреп оформляем последним.
            if (
                pinned is not None
                and pinned_entry is not None
                and int(pinned.getVisibility()) == 0
            ):
                self._attach_pinned_surface(pinned, pinned_entry["surface"])
                self._sync_pinned_offset(
                    fragment, pinned, pinned_entry["surface"], pinned_entry.get("factory")
                )
            self._apply_joined_top_radii(fragment)
        except Exception as exc:
            self._warn_once("Восстановление капсул чата", exc)
        finally:
            self._checking_capsules.discard(key)

    def _bind_home_guard(self, owner):
        view = self.field(owner, "tabsView")
        if view is None:
            return
        key = _identity(owner)
        observer = view.getViewTreeObserver()
        previous = self._home_guards.get(key)
        if previous is not None:
            if (
                _identity(previous["view"]) == _identity(view)
                and previous["observer"].isAlive()
                and _identity(previous["observer"]) == _identity(observer)
            ):
                return
            self._forget_home_guard(owner)
        if not observer.isAlive():
            return
        plugin = self

        class MainNavPosition(dynamic_proxy(jclass("android.view.ViewTreeObserver$OnPreDrawListener"))):
            def onPreDraw(self):
                plugin._pre_draw_depth += 1
                try:
                    if plugin._enabled("glass_main_nav") and view.isAttachedToWindow() and view.isShown():
                        plugin._update_main_nav_frame(owner, view)
                except Exception as exc:
                    plugin._warn_once("Обновление главной навигации перед отрисовкой", exc)
                finally:
                    plugin._pre_draw_depth = max(0, plugin._pre_draw_depth - 1)
                return True

        entry = self._main_nav.get(_identity(view))
        if (
            self._java_runtime is not None
            and entry is not None
            and _identity(entry["surface"]) in self._native_positions
        ):
            plugin = self

            class NavRepair(dynamic_proxy(jclass("java.lang.Runnable"))):
                def run(self):
                    plugin._update_main_nav_frame(owner, view)

            listener = self._java_runtime.nav(view, NavRepair())
        else:
            listener = MainNavPosition()
        observer.addOnPreDrawListener(listener)
        self._home_guards[key] = {"owner": owner, "view": view, "observer": observer, "listener": listener}

    def _forget_home_guard(self, owner):
        entry = self._home_guards.pop(_identity(owner), None)
        if entry is not None:
            try:
                observer, listener = entry["observer"], entry["listener"]
                if self._pre_draw_depth:
                    removal_key = (_identity(observer), _identity(listener))
                    if removal_key not in self._deferred_listener_removals:
                        self._deferred_listener_removals[removal_key] = (observer, listener)

                        def remove_later(key=removal_key):
                            saved = self._deferred_listener_removals.pop(key, None)
                            if saved is not None and saved[0].isAlive():
                                saved[0].removeOnPreDrawListener(saved[1])

                        self.schedule(remove_later, 0)
                elif observer.isAlive():
                    observer.removeOnPreDrawListener(listener)
            except Exception as exc:
                self._warn_once("Удаление обработчика главной навигации", exc)

    def _style_forward_button(self, fragment):
        layout = self.field(fragment, "actionsButtonsLayout")
        self._remember_owner(layout, fragment)
        if layout is None:
            return
        buttons = []
        forward_button = None
        try:
            forward_button = layout.getForwardButton()
            buttons.append(forward_button)
        except Exception:
            pass
        forward_holder = self.field(layout, "forwardButton")
        forward_button = (
            self.field(forward_holder, "button") or self.field(forward_button, "button") or forward_button
        )
        buttons.extend(
            (
                self.field(self.field(layout, "forwardButton"), "button"),
                self.field(self.field(layout, "replyButton"), "button"),
            )
        )
        seen = set()
        for button in buttons:
            # В некоторых сборках getter отдаёт ButtonHolder вместо кнопки.
            button = self.field(button, "button") or button
            if button is None or _identity(button) in seen:
                continue
            seen.add(_identity(button))
            surface = self._native_capsule(fragment, button, "backgroundDrawable", "glass_forward", 22, 6)
            if surface is not None and self._enabled("glass_forward"):
                # Оба action-контейнера рисуют фон через View.background.
                self._snapshot_object(button, ("background",), fragment)
                button.setBackground(surface)

    def _restore_extra_surface(self, key):
        entry = self._extra_surfaces.pop(key, None)
        if entry is None:
            return
        view, field = entry["view"], entry["field"]
        if "text_keys" in entry:
            self._style_profile_tab_text(view, entry, restore=True)
        if entry.get("native_reuse"):
            self._restore_materials(drawable_key=_identity(entry["surface"]))
            self._release_drawable(entry["surface"])
            self._folder_fades.pop(_identity(entry.get("fade")), None)
            if entry.get("fade") is not None:
                entry["fade"].invalidate()
            view.invalidate()
            return
        try:
            current = self.field(view, field)
            if _identity(current) == _identity(entry["surface"]):
                self._set_java_field(view, field, entry["original"], "obj")
            self._styled_glass.pop(_identity(entry["surface"]), None)
            view.invalidate()
        except Exception as exc:
            self._warn_once("Восстановление: " + entry["setting"], exc)
        self._release_drawable(entry["surface"])

    def _cache_tabs_gate(self, view, names, stock_owner=None):
        if self._java_runtime is None:
            return
        self._java_tabs_targets.remove(view)
        try:
            objects, fields = [], []

            def watch(obj, name):
                member = self._java_field(obj, name)
                if member is None:
                    raise RuntimeError("tabs gate field: " + name)
                objects.append(obj)
                fields.append(member)

            for name in names:
                watch(view, name)
            if stock_owner is not None:
                drawable = self.field(view, "blurredBackgroundDrawable")
                watch(drawable, "source")
                watch(drawable, "liquidGlassEffect")
                # Пустое приоритетное поле тоже отслеживаем: позже в нём появится frosted source.
                found = False
                for name in ("iBlur3SourceGlassFrosted", "glassBackgroundSourceFrostedRenderNode"):
                    if self._java_field(stock_owner, name) is not None:
                        watch(stock_owner, name)
                        found = True
                if not found:
                    return
            self._java_tabs_targets.put(
                view,
                self._java_runtime.tabs(
                    jarray(jclass("java.lang.Object"))(objects),
                    jarray(jclass("java.lang.reflect.Field"))(fields),
                ),
            )
        except Exception as exc:
            self._warn_once("Фильтр вкладок через Java недоступен, используем Python", exc)

    def _topic_surface(self, fragment, view, field, radius):
        if view is None:
            return
        key = (_identity(view), field)
        if not self._enabled("glass_topics"):
            self._restore_extra_surface(key)
            return
        try:
            current = self.field(view, field)
            if current is None:
                return
            entry = self._extra_surfaces.get(key)
            if entry is not None and _identity(current) != _identity(entry["surface"]):
                self._restore_extra_surface(key)
                entry = None
            if entry is None:
                factory = self.glass_factory(fragment)
                if factory is None:
                    self._warn_once("Источник стекла тем", "Нет Blur3-источника для TopicsTabsView")
                    return
                self._snapshot_object(factory, ("isLiquidGlassEffectAllowed",), fragment)
                factory.setLiquidGlassEffectAllowed(True)
                surface = factory.create(view)
                self._track_native_position(surface, factory)
                if surface is None:
                    return
                surface.setPadding(int(dp(7)))
                surface.setBounds(current.getBounds())
                if not self.style_glass_drawable(fragment, surface, dp(radius)):
                    return
                entry = {
                    "view": view,
                    "field": field,
                    "fragment": fragment,
                    "factory": factory,
                    "surface": surface,
                    "original": current,
                    "setting": "glass_topics",
                }
                # Оба drawable рисует сам TopicsTabsView. Фон View дал бы третий слой.
                if not self._set_java_field(view, field, surface, "obj"):
                    return
                self._extra_surfaces[key] = entry
                self.log("Темы: стекло подключено; setting=glass_topics")
                view.invalidate()
            else:
                self.style_glass_drawable(fragment, entry["surface"], dp(radius))
            self._sync_surface_offset(fragment, view, entry["surface"], entry["factory"])
        except Exception as exc:
            self._warn_once("Стекло тем", exc)

    def _style_topics(self, fragment):
        view = self.field(fragment, "topicsTabs")
        if view is None:
            return
        self._remember_owner(view, fragment)
        self._topic_surface(fragment, view, "topMenuBackgroundDrawable", 18)
        self._topic_surface(fragment, view, "sideMenuBackgroundDrawable", 16)

    # Вкладки профиля и «Избранного», прокрутка медиа

    def _style_profile_tabs(self, fragment):
        if fragment is None or not self._active or getattr(self, "_profile_text_update", False):
            return
        layout = self.field(fragment, "sharedMediaLayout")
        view = self.field(layout, "scrollSlidingTextTabStrip")
        if view is None:
            return
        try:
            self._remember_owner(view, fragment)
            media = self._prepare_media_glass(fragment, layout, view)
            self._style_profile_scroll(fragment, layout, media["factory"] if media else None)
            native = self.field(view, "backgroundDrawable")
            key = (_identity(view), "backgroundDrawable")
            entry = self._extra_surfaces.get(key)
            if entry is not None and (
                not self._enabled("glass_profile_tabs")
                or _identity(entry["surface"]) != _identity(native)
            ):
                self._restore_extra_surface(key)
                entry = None
            if native is None or not self._enabled("glass_profile_tabs"):
                return
            if entry is None:
                entry = {
                    "view": view,
                    "fragment": fragment,
                    "surface": native,
                    "field": "backgroundDrawable",
                    "setting": "glass_profile_tabs",
                    "native_reuse": not bool(media),
                }
                if media:
                    entry["original"] = media["original"]
                self._extra_surfaces[key] = entry
            # Источник, координаты и форму вкладок уже задала штатная фабрика.
            self._ensure_live_style(fragment, native)
            self._style_profile_tab_text(view, entry, restore=_is_dark())
        except Exception as exc:
            self._warn_once("Стекло вкладок профиля", exc)

    def _prepare_media_glass(self, fragment, layout, view):
        if str(fragment.getClass().getName()) != "org.telegram.ui.Components.MediaActivity":
            return None
        key = _identity(fragment)
        state = self._media_glass.get(key)
        if not self._enabled("glass_profile_tabs") or (
            state is not None and (
                _identity(state["tabs"]) != _identity(view)
                or _identity(state["surface"]) != _identity(self.field(view, "backgroundDrawable"))
            )
        ):
            self._drop_media_glass(fragment)
            state = None
        if not self._enabled("glass_profile_tabs"):
            return None
        if state is not None:
            return state
        root = self.field(fragment, "fragmentView")
        original = self.field(view, "backgroundDrawable")
        if root is None or original is None:
            return None
        if int(jclass("android.os.Build$VERSION").SDK_INT) < 31:
            return None
        background = self.field(original, "source")
        source = jclass("org.telegram.ui.Components.blur3.source.BlurredBackgroundSourceRenderNode")(background)
        # Software fallback на GPU не виден. underSource прикроет пропуски захвата.
        source.setUnderSource(background)
        suppressor = jclass("org.telegram.ui.Components.blur3.DownscaleScrollableNoiseSuppressor")(False, False)
        if self.field(suppressor, "isLiquidGlassEnabled") == False:
            if not self._set_java_field(suppressor, "isLiquidGlassEnabled", True, "bool") or not self._set_java_field(
                suppressor, "k", 1, "int"
            ):
                raise RuntimeError("Не удалось включить источник стекла «Избранного»")
        source.setScrollableNoiseSuppressor(suppressor, -2)
        factory = jclass("org.telegram.ui.Components.blur3.BlurredBackgroundDrawableViewFactory")(source)
        layout.initBlurCapture(root)
        capture = self.field(layout, "iBlur3Capture")
        if capture is None:
            return None
        saved = self.field(layout, "savedMessagesContainer")
        content = self.field(self.field(saved, "chatActivity"), "contentView")
        saved_capture = (
            jclass("org.telegram.ui.ChatActivity$$ExternalSyntheticLambda247")(content)
            if content is not None
            else None
        )
        targets = jclass("java.util.ArrayList")()
        merged = jclass("java.util.ArrayList")()
        clock = jarray(jclass("java.lang.Long").TYPE)([0, 0])
        gate = jarray(jclass("java.lang.Object"))(
            [
                source, suppressor, capture, root, targets, merged, clock, factory,
                int(dp(8)), saved, content, saved_capture,
            ]
        )
        state = {
            "fragment": fragment,
            "tabs": view,
            "original": original,
            "factory": factory,
            "watcher": None,
            "gate": gate,
        }
        self._media_glass[key] = state
        try:
            self._media_capture_targets.put(root, gate)
            if saved_capture is not None:
                self._media_capture_targets.put(capture, gate)
            watcher = jclass("org.telegram.ui.Components.chat.ViewPositionWatcher")(root)
            state["watcher"] = watcher
            factory.setSourceRootView(watcher, root)
            factory.setLinkedViewsRef(jclass("me.vkryl.core.reference.ReferenceList")())
            factory.setLiquidGlassEffectAllowed(True)
            surface = factory.create(view)
            surface.setPadding(int(dp(6.666)))
            surface.setRadius(float(dp(18)))
            surface.setCallback(view)
            self._track_native_position(surface, factory)
            if not self._set_java_field(view, "backgroundDrawable", surface, "obj"):
                self._release_drawable(surface)
                raise RuntimeError("Не удалось подключить стекло «Избранного»")
            state["surface"] = surface
            self._update_capture_intervals()
            root.postInvalidateOnAnimation()
        except Exception:
            self._drop_media_glass(fragment)
            raise
        return state

    def _drop_media_glass(self, fragment=None):
        for key, state in list(self._media_glass.items()):
            if fragment is not None and key != _identity(fragment):
                continue
            self._media_capture_targets.remove(state["gate"][3])
            self._media_capture_targets.remove(state["gate"][2])
            for surface_key, entry in list(self._extra_surfaces.items()):
                if _identity(entry["fragment"]) == key and entry["setting"] == "glass_profile_tabs":
                    self._restore_extra_surface(surface_key)
            surface = state.get("surface")
            if surface is not None and _identity(self.field(state["tabs"], "backgroundDrawable")) == _identity(surface):
                self._set_java_field(state["tabs"], "backgroundDrawable", state["original"], "obj")
                self._release_drawable(surface)
                state["tabs"].invalidate()
            self._media_glass.pop(key, None)
            if state["watcher"] is not None:
                state["watcher"].shutdown()

    def _style_profile_tab_text(self, view, entry, restore=False):
        names = ("activeTextColorKey", "unactiveTextColorKey")
        current = tuple(self.field(view, name) for name in names)
        if any(value is None for value in current):
            return
        if restore:
            desired = entry.pop("text_keys", None)
            if desired is None:
                return
        else:
            entry.setdefault("text_keys", current)
            # Как у даты FastScroll; анимация вкладок сама читает эти ключи.
            desired = (Theme.key_windowBackgroundWhiteBlackText,) * 2
        if current == desired:
            return
        try:
            for name, value in zip(names, desired):
                if not self._set_java_field(view, name, int(value), "int"):
                    raise RuntimeError("Не удалось задать цвет вкладок: " + name)
            # Наш хук updateColors не должен снова войти в оформление.
            self._profile_text_update = True
            view.updateColors()
        except Exception as exc:
            self._warn_once("Цвет текста вкладок профиля", exc)
        finally:
            self._profile_text_update = False

    def _style_profile_scroll(self, fragment, layout, factory=None):
        for page in self.field(layout, "mediaPages") or ():
            try:
                listing = self.field(page, "listView")
                view = listing.getFastScroll() if listing is not None else None
                if view is None:
                    continue
                self._remember_owner(view, fragment)
                for name, padding, radius in (
                    ("blurredCircleDrawable", 4, 24),
                    ("blurredTagDrawable", 6, 14),
                ):
                    key = (_identity(view), name)
                    native = self.field(view, name)
                    entry = self._extra_surfaces.get(key)
                    if entry is not None and (
                        not self._enabled("glass_profile_tabs")
                        or _identity(entry["surface"]) != _identity(native)
                    ):
                        self._restore_extra_surface(key)
                        entry = None
                        native = self.field(view, name)
                    if not self._enabled("glass_profile_tabs"):
                        continue
                    if entry is None:
                        surface = native
                        if surface is None or factory is not None:
                            source_factory = factory or self.glass_factory(fragment)
                            if source_factory is None:
                                continue
                            surface = source_factory.create(view)
                            surface.setPadding(int(dp(padding)))
                            surface.setRadius(float(dp(radius)))
                            surface.setCallback(view)
                            self._track_native_position(surface, source_factory)
                            # Bounds ручки и даты выставит сам FastScroll при отрисовке.
                            if not self._set_java_field(view, name, surface, "obj"):
                                self._release_drawable(surface)
                                continue
                        entry = {
                            "view": view,
                            "fragment": fragment,
                            "surface": surface,
                            "field": name,
                            "original": native,
                            "setting": "glass_profile_tabs",
                            "native_reuse": surface is native,
                        }
                        self._extra_surfaces[key] = entry
                    self._ensure_live_style(fragment, entry["surface"])
                view.invalidate()
            except Exception as exc:
                self._warn_once("Стекло прокрутки медиа", exc)

    # Папки и вкладки поиска

    def _style_folders(self, fragment):
        if fragment is None or not self._active:
            return
        self._style_search_tabs(fragment)
        view = self.field(fragment, "filterTabsView")
        if view is None:
            return
        self._folder_owners[_identity(fragment)] = fragment
        self._remember_owner(view, fragment)
        key = (_identity(view), "blurredBackgroundDrawable")
        if not self._enabled("glass_folders"):
            self._restore_extra_surface(key)
            self._use_stock_folder_blur(fragment, self.field(view, "blurredBackgroundDrawable"))
            return
        self._restore_folder_blur(fragment, self.field(view, "blurredBackgroundDrawable"))
        native = self.field(view, "blurredBackgroundDrawable")
        if native is None:
            return
        entry = self._extra_surfaces.get(key)
        if entry is not None and _identity(entry["surface"]) != _identity(native):
            self._restore_extra_surface(key)
            entry = None
        if entry is None:
            entry = {
                "view": view,
                "fragment": fragment,
                "surface": native,
                "field": "blurredBackgroundDrawable",
                "setting": "glass_folders",
                "native_reuse": True,
            }
            self._extra_surfaces[key] = entry
        # За координатами полосы уже следит штатный ViewPositionWatcher.
        self.style_glass_drawable(fragment, native)
        self._sample_header_fade(fragment, native, opacity=0.35)
        fade = self.field(fragment, "topBubblesFadeView")
        if _identity(entry.get("fade")) != _identity(fade):
            self._folder_fades.pop(_identity(entry.get("fade")), None)
            entry["fade"] = fade
        if fade is not None:
            self._remember_owner(fade, fragment)
            self._folder_fades[_identity(fade)] = entry
            fade.invalidate()

    def _style_search_tabs(self, fragment):
        view = self.field(fragment, "searchTabsAndFiltersLayout")
        if view is None or not self._active:
            return
        self._folder_owners[_identity(fragment)] = fragment
        self._remember_owner(view, fragment)
        key = (_identity(view), "blurredBackgroundDrawable")
        native = self.field(view, "blurredBackgroundDrawable")
        entry = self._extra_surfaces.get(key)
        if entry is not None and (
            not self._enabled("glass_folders") or _identity(entry["surface"]) != _identity(native)
        ):
            self._restore_extra_surface(key)
            entry = None
        if native is None or not self._enabled("glass_folders"):
            if native is not None:
                self._use_stock_folder_blur(fragment, native)
            return
        self._restore_folder_blur(fragment, native)
        if entry is None:
            self._extra_surfaces[key] = {
                "view": view,
                "fragment": fragment,
                "surface": native,
                "field": "blurredBackgroundDrawable",
                "setting": "glass_folders",
                "native_reuse": True,
            }
        # Меняем только материал, не фон View, форму или подписки полосы.
        self._ensure_live_style(fragment, native)
        self._sample_header_fade(fragment, native)

    def _use_stock_folder_blur(self, fragment, drawable):
        source = self.field(fragment, "iBlur3SourceGlassFrosted") or self.field(
            fragment, "glassBackgroundSourceFrostedRenderNode"
        )
        if drawable is None or source is None:
            return
        live = {
            _identity(self.field(self.field(fragment, name), "blurredBackgroundDrawable"))
            for name in ("filterTabsView", "searchTabsAndFiltersLayout")
        }
        for old_key, (owner, old, _source, _effect) in list(self._stock_folder_surfaces.items()):
            if _identity(owner) == _identity(fragment) and old_key not in live:
                self._restore_folder_blur(fragment, old)
        key = _identity(drawable)
        if key not in self._stock_folder_surfaces:
            self._stock_folder_surfaces[key] = (
                fragment,
                drawable,
                self.field(drawable, "source"),
                self.field(drawable, "liquidGlassEffect"),
            )
        if _identity(self.field(drawable, "source")) != _identity(source):
            self._set_java_field(drawable, "source", source, "obj")
            drawable.invalidateDisplayList()
        if self.field(drawable, "liquidGlassEffect") is not None:
            self._set_glass_effect(drawable, None)
            drawable.invalidateDisplayList()

    def _restore_folder_blur(self, fragment=None, drawable=None):
        self._java_tabs_targets.clear()
        for key, (owner, current, source, effect) in list(self._stock_folder_surfaces.items()):
            if fragment is not None and _identity(owner) != _identity(fragment):
                continue
            if drawable is not None and key != _identity(drawable):
                continue
            self._set_java_field(current, "source", source, "obj")
            self._set_glass_effect(current, effect)
            current.invalidateDisplayList()
            self._stock_folder_surfaces.pop(key, None)

    def _folder_fade_clip_begin(self, fade, canvas):
        entry = self._folder_fades.get(_identity(fade)) if self._enabled("glass_folders") else None
        if entry is None:
            return None
        view = entry["view"]
        save = None
        try:
            if not view.isShown() or view.getAlpha() <= 0.001:
                return None
            if _identity(view.getParent()) == _identity(fade.getParent()):
                x, y = float(view.getX()) - float(fade.getX()), float(view.getY()) - float(fade.getY())
            else:
                view_pos, fade_pos = jarray(jint)([0, 0]), jarray(jint)([0, 0])
                view.getLocationOnScreen(view_pos)
                fade.getLocationOnScreen(fade_pos)
                x, y = view_pos[0] - fade_pos[0], view_pos[1] - fade_pos[1]
            save = int(canvas.save())
            # Остальная часть верхнего градиента остаётся нетронутой.
            canvas.clipRect(
                x,
                y,
                x + view.getWidth(),
                y + view.getHeight(),
                jclass("android.graphics.Region$Op").DIFFERENCE,
            )
            return save
        except Exception as exc:
            if save is not None:
                canvas.restoreToCount(save)
            self._warn_once("Отсечение градиента папок", exc)
            return None

    def _bind_folder_view(self, view):
        owner = self._owner(view)
        if owner is None:
            candidates = list(self._known_fragments.values()) + list(self._folder_owners.values())
            current = get_last_fragment()
            if current is not None:
                candidates.insert(0, current)
                try:
                    visible = current.getCurrentVisibleFragment()
                    if visible is not None:
                        candidates.insert(0, visible)
                except Exception:
                    pass
            for candidate in candidates:
                strips = (
                    self.field(candidate, "filterTabsView"),
                    self.field(candidate, "searchTabsAndFiltersLayout"),
                )
                if any(strip is not None and _identity(strip) == _identity(view) for strip in strips):
                    owner = candidate
                    self._remember_owner(view, owner)
                    break
        if owner is not None:
            if _identity(self.field(owner, "searchTabsAndFiltersLayout")) == _identity(view):
                self._style_search_tabs(owner)
            else:
                self._style_folders(owner)
        else:
            self._warn_once("Владелец папок", "FilterTabsView обнаружен, владелец сборки не найден")

    def _discover_folders(self, fragment):
        if fragment is None or not self._active:
            return
        try:
            name = str(fragment.getClass().getName())
            if name == "org.telegram.ui.DialogsActivity":
                self._style_main_header(fragment, allow_archive=True)
                self._style_folders(fragment)
            elif name == "org.telegram.ui.MainTabsActivity":
                visible = fragment.getCurrentVisibleFragment()
                if (
                    visible is not None
                    and str(visible.getClass().getName()) == "org.telegram.ui.DialogsActivity"
                ):
                    self._style_main_header(visible, allow_archive=True)
                    self._style_folders(visible)
        except Exception as exc:
            self._warn_once("Поиск панели папок", exc)

    # Хуки главного экрана, медиа и дополнительных панелей

    def _install_extra_hooks(self):
        plugin = self
        # Чужие списки отсекаются Java-фильтром до входа в Python.
        self._draw_filter_targets = (HashSet(), HashSet(), HashSet())
        self._refresh_draw_filter_targets()
        photo_targets, settings_lists, emoji_opening = self._draw_filter_targets
        photo_source_frames = []

        class EmojiControlsHook(MethodHook):
            def after_hooked_method(self, param):
                plugin._style_emoji_panel(param.thisObject)

        class EmojiOpenedHook(MethodHook):
            def after_hooked_method(self, param):
                panel = param.thisObject
                if not plugin._active or int(panel.getVisibility()) != 0:
                    emoji_opening.remove(panel)
                    return
                plugin._style_emoji_panel(panel)
                emoji_opening.add(panel)
                panel.invalidate()

        class EmojiFirstFrameHook(MethodHook):
            @hook_filters(HookFilter.Condition("object.contains(this)", object=emoji_opening))
            def before_hooked_method(self, param):
                panel = param.thisObject
                emoji_opening.remove(panel)
                if not plugin._active or int(panel.getVisibility()) != 0:
                    return
                plugin._style_emoji_panel(panel)
                try:
                    # Прямой вызов работает, даже если ART встроил приватный пересчёт позиции.
                    if not (plugin._enabled("glass_emoji_tabs") or plugin._enabled("glass_emoji_buttons")):
                        return
                    for name, args in (
                        ("updateBottomTabContainerPosition", []),
                        ("invalidateBlurCaptures", [jint(7)]),
                    ):
                        cls = panel.getClass()
                        while cls is not None:
                            method = next(
                                (
                                    m
                                    for m in cls.getDeclaredMethods()
                                    if str(m.getName()) == name and len(m.getParameterTypes()) == len(args)
                                ),
                                None,
                            )
                            if method is not None:
                                method.setAccessible(True)
                                method.invoke(panel, jarray(jclass("java.lang.Object"))(args))
                                break
                            cls = cls.getSuperclass()
                    for drawable in plugin._native_controls.get(_identity(panel), {}).values():
                        drawable.invalidateDisplayList()
                    panel.invalidate()
                except Exception as exc:
                    plugin._warn_once("Захват при повторном открытии эмодзи", exc)

        class EmojiClosedHook(MethodHook):
            def after_hooked_method(self, param):
                emoji_opening.remove(param.thisObject)
                plugin._drop_chat(param.thisObject)

        class PhotoControlsHook(MethodHook):
            def after_hooked_method(self, param):
                plugin._style_photo_viewer(param.thisObject)

        class PhotoClosedHook(MethodHook):
            def after_hooked_method(self, param):
                plugin._drop_chat(param.thisObject)

        class MentionsHook(MethodHook):
            @hook_filters(
                HookFilter.Condition(
                    "if (!object[0].contains(this)) { return false; } "
                    "gate = object[1].get(this); "
                    "return gate == null || gate.needsPython();",
                    object=jarray(jclass("java.lang.Object"))(
                        [plugin._owned_views, plugin._java_tabs_targets]
                    ),
                )
            )
            def before_hooked_method(self, param):
                view = param.thisObject
                if not plugin._active:
                    return
                owner = plugin._owner(view)
                drawable = plugin.field(view, "backgroundDrawable")
                key = _identity(drawable)
                if (
                    owner is not None
                    and key in plugin._native_controls.get(_identity(owner), {})
                    and (not plugin._enabled("glass_mentions") or key in plugin._original_drawables)
                ):
                    plugin._cache_tabs_gate(view, ("backgroundDrawable", "baseFragment"))
                    return
                fragment = plugin.field(view, "baseFragment") if plugin._active else None
                if fragment is not None and _identity(
                    plugin.field(fragment, "mentionContainer")
                ) == _identity(view):
                    plugin._style_mentions(fragment)

        class MentionsColorsHook(MethodHook):
            def after_hooked_method(self, param):
                if plugin._active:
                    plugin._style_mentions(plugin.field(param.thisObject, "baseFragment"))

        class BotMenuHook(MethodHook):
            @hook_filters(
                HookFilter.Condition(
                    "return object == null || object.needsPython(this);", object=plugin._java_bot_menus
                )
            )
            def after_hooked_method(self, param):
                if plugin._active and plugin._java_bot_menus is not None:
                    plugin._style_bot_menu(
                        plugin._java_bot_menus.owner(param.thisObject, get_last_fragment())
                    )

        class NativeControlDrawHook(MethodHook):
            # Запоминаем вход: restore_all может очистить targets прямо во время draw.
            calls = IdentityHashMap()

            @hook_filters(
                HookFilter.Condition(
                    "if (object[0].isEmpty() || (object[1].isEmpty() && object[2] != null && !object[2].needsPython(this))) { return false; } "
                    "object[1].put(param, true); return true;",
                    object=jarray(jclass("java.lang.Object"))(
                        [photo_targets, calls, plugin._java_photo_gate]
                    ),
                )
            )
            def before_hooked_method(self, param):
                photo_source_frames.append(None)
                if not plugin._active:
                    return
                drawable = param.thisObject
                key = _identity(drawable)
                source = plugin.field(drawable, "source") if plugin._photo_sources else None
                if source is not None:
                    try:
                        viewer = plugin._photo_sources.get(_identity(source))
                        if viewer is not None and _identity(
                            plugin.field(viewer, "blurredBackgroundSource")
                        ) == _identity(source):
                            if key not in plugin._native_controls.get(_identity(viewer), {}):
                                plugin._style_photo_viewer(viewer)
                            if key in plugin._original_drawables:
                                photo_source_frames[-1] = viewer
                    except Exception as exc:
                        plugin._warn_once("Штатная поверхность галереи", exc)

            @hook_filters(HookFilter.Condition("object.remove(param) != null", object=calls))
            def after_hooked_method(self, param):
                if photo_source_frames:
                    photo_source_frames.pop()

        class PanelBackgroundHook(MethodHook):
            calls = IdentityHashMap()

            def __init__(self):
                self.clips = []

            @hook_filters(
                HookFilter.Condition(
                    "if (!object[0].containsKey(this)) { return false; } "
                    "object[1].put(param, true); return true;",
                    object=jarray(jclass("java.lang.Object"))(
                        [plugin._panel_blur_targets, calls]
                    ),
                )
            )
            def before_hooked_method(self, param):
                panel = plugin._panel_blur_targets.get(param.thisObject)
                self.clips.append(plugin._clip_stock_panel_background(panel, param.args[0]))

            @hook_filters(HookFilter.Condition("object.remove(param) != null", object=calls))
            def after_hooked_method(self, param):
                if self.clips:
                    save = self.clips.pop()
                    if save is not None:
                        param.args[0].restoreToCount(save)

        class PhotoBlurHook(MethodHook):
            def before_hooked_method(self, param):
                viewer = param.thisObject
                if not plugin._active or len(param.args) != 8:
                    return
                if (
                    photo_source_frames
                    and _identity(photo_source_frames[-1]) == _identity(viewer)
                    and any(
                        plugin._enabled(k)
                        for k in ("glass_photo_tools", "glass_photo_caption", "glass_photo_send")
                    )
                ):
                    # Перегрузка с семью аргументами приходит сюда с glass=False (40 dp).
                    param.args[7] = True

        class SettingsScrollHook(MethodHook):
            @hook_filters(
                HookFilter.Condition(
                    "if (!object[0].contains(this)) { return false; } "
                    "gate = object[1].get(this); "
                    "return gate == null || gate.needsPython();",
                    object=jarray(jclass("java.lang.Object"))(
                        [settings_lists, plugin._java_settings_targets]
                    ),
                )
            )
            def after_hooked_method(self, param):
                if not plugin._settings_sources:
                    return
                owner = plugin._owner(param.thisObject) if plugin._active else None
                if owner is None:
                    return
                states = [
                    state
                    for state in plugin._settings_sources.values()
                    if _identity(state["proxy"].view) == _identity(param.thisObject)
                ]
                if not states or any(state["proxy"].recording for state in states):
                    return
                for state in states:
                    proxy = state["proxy"]
                    if not proxy.failed:
                        state["drawable"].invalidateDisplayList()
                bar = plugin.field(owner, "actionBar")
                if bar is not None and plugin._is_settings_header(owner, bar):
                    bar.invalidate()

        class ActionsHook(MethodHook):
            def after_hooked_method(self, param):
                if plugin._active:
                    owner = plugin._owner(param.thisObject)
                    if owner is not None:
                        plugin._style_forward_button(owner)

        class TopicsHook(MethodHook):
            @hook_filters(
                HookFilter.Condition(
                    "if (!object[0].contains(this)) { return false; } "
                    "gate = object[1].get(this); "
                    "return gate == null || gate.needsPython();",
                    object=jarray(jclass("java.lang.Object"))(
                        [plugin._owned_views, plugin._java_tabs_targets]
                    ),
                )
            )
            def before_hooked_method(self, param):
                if plugin._active and plugin._enabled("glass_topics"):
                    view = param.thisObject
                    owner = plugin._owner(view)
                    if owner is None:
                        return
                    for name in ("topMenuBackgroundDrawable", "sideMenuBackgroundDrawable"):
                        entry = plugin._extra_surfaces.get((_identity(view), name))
                        if entry is None or _identity(plugin.field(view, name)) != _identity(
                            entry["surface"]
                        ):
                            plugin._style_topics(owner)
                            return
                    plugin._cache_tabs_gate(view, ("topMenuBackgroundDrawable", "sideMenuBackgroundDrawable"))

        class TopicsCreatedHook(MethodHook):
            def after_hooked_method(self, param):
                if plugin._active:
                    plugin._style_topics(param.thisObject)

        class ProfileTabsHook(MethodHook):
            def after_hooked_method(self, param):
                plugin._style_profile_tabs(param.thisObject)

        class MediaCaptureHook(MethodHook):
            @hook_filters(HookFilter.Condition(
                "state = object[0].get(this); if (state == null || !param.args[0].isHardwareAccelerated()) { return false; } "
                "now = System.nanoTime(); clock = state[6]; "
                "if (clock[1] > 0 && now - clock[0] < clock[1]) { "
                "this.postInvalidateDelayed(1 + (clock[1] - now + clock[0]) / 1000000L); return false; } "
                "object[0].remove(this); "
                "count = state[0].getVisiblePositions(state[4], 0, state[8]); "
                "if (count == 0) { if (clock[0] == 0) { this.postInvalidateDelayed(32); } "
                "object[0].put(this, state); return false; } "
                "count = org.telegram.messenger.utils.RectFMergeBounding.mergeOverlapping(state[4], count, state[5]); "
                "state[1].setupRenderNodes(state[5], count); "
                "if (state[1].invalidateResultRenderNodes(state[2], this.getWidth(), this.getHeight())) { "
                "state[0].invalidateDisplayListForDrawables(); state[7].invalidateAllLinkedViews(); } "
                "clock[0] = now; "
                "object[0].put(this, state); return false;",
                object=jarray(jclass("java.lang.Object"))([plugin._media_capture_targets]),
            ))
            def before_hooked_method(self, param):
                pass

        class SavedMessagesCaptureHook(MethodHook):
            @hook_filters(HookFilter.Condition(
                "state = object.get(this); if (state == null || state[9].getVisibility() != 0) { return false; } "
                "org.telegram.ui.Components.blur3.utils.Blur3Utils.captureRelativeParent("
                "state[11], param.args[0], param.args[1], state[10], state[3]); return false;",
                object=plugin._media_capture_targets,
            ))
            def after_hooked_method(self, param):
                pass

        class ProfileTabsViewHook(MethodHook):
            @hook_filters(HookFilter.Condition("object.contains(this)", object=plugin._owned_views))
            def after_hooked_method(self, param):
                plugin._style_profile_tabs(plugin._owner(param.thisObject))

        class FoldersHook(MethodHook):
            def after_hooked_method(self, param):
                if not plugin._active:
                    return
                owner = param.thisObject
                try:
                    cls_name = str(owner.getClass().getName())
                except Exception:
                    cls_name = ""
                if cls_name == "org.telegram.ui.MainTabsActivity":
                    plugin._discover_folders(owner)
                else:
                    plugin._style_main_header(owner, allow_archive=True)
                    plugin._style_folders(owner)

        class FolderViewHook(MethodHook):
            def after_hooked_method(self, param):
                if plugin._active:
                    plugin._bind_folder_view(param.thisObject)

        class SearchTabsDrawHook(MethodHook):
            @hook_filters(
                HookFilter.Condition(
                    "if (!object[0].contains(this)) { return false; } "
                    "gate = object[1].get(this); "
                    "return gate == null || gate.needsPython();",
                    object=jarray(jclass("java.lang.Object"))(
                        [plugin._owned_views, plugin._java_tabs_targets]
                    ),
                )
            )
            def before_hooked_method(self, param):
                if plugin._active:
                    view = param.thisObject
                    entry = plugin._extra_surfaces.get((_identity(view), "blurredBackgroundDrawable"))
                    if not plugin._enabled("glass_folders"):
                        native = plugin.field(view, "blurredBackgroundDrawable")
                        stock = plugin._stock_folder_surfaces.get(_identity(native))
                        if stock is not None and _identity(stock[1]) == _identity(native):
                            source = plugin.field(stock[0], "iBlur3SourceGlassFrosted") or plugin.field(
                                stock[0], "glassBackgroundSourceFrostedRenderNode"
                            )
                            if (
                                _identity(plugin.field(native, "source")) == _identity(source)
                                and plugin.field(native, "liquidGlassEffect") is None
                            ):
                                plugin._cache_tabs_gate(view, ("blurredBackgroundDrawable",), stock[0])
                                return
                    if entry is None or _identity(
                        plugin.field(view, "blurredBackgroundDrawable")
                    ) != _identity(entry["surface"]):
                        plugin._bind_folder_view(view)
                    elif plugin._enabled("glass_folders"):
                        plugin._cache_tabs_gate(view, ("blurredBackgroundDrawable",))

        class FolderDestroyHook(MethodHook):
            def after_hooked_method(self, param):
                plugin._drop_chat(param.thisObject)

        class FolderFadeHook(MethodHook):
            calls = IdentityHashMap()

            def __init__(self):
                self.saves = []

            @hook_filters(
                HookFilter.Condition(
                    "if (object[2].contains(this)) { param.setResult(null); return false; } "
                    "if (!object[0].contains(this)) { return false; } "
                    "object[1].put(param, true); return true;",
                    object=jarray(jclass("java.lang.Object"))(
                        [plugin._owned_views, calls, plugin._player_fade_targets]
                    ),
                )
            )
            def before_hooked_method(self, param):
                owner = plugin._owner(param.thisObject) if plugin._active else None
                root = plugin.field(owner, "fragmentView")
                if (
                    owner is not None
                    and plugin._main_header_clear(owner, allow_search=True)
                    and not plugin.field(root, "drawingBlur")
                ):
                    # Из-за CLAMP начало градиента растягивается в сплошную полосу над папками.
                    self.saves.append(None)
                    plugin._header_trace(owner, "верхний градиент контейнера отключён")
                    param.setResult(None)
                    return
                self.saves.append(plugin._folder_fade_clip_begin(param.thisObject, param.args[0]))

            @hook_filters(HookFilter.Condition("object.remove(param) != null", object=calls))
            def after_hooked_method(self, param):
                if self.saves:
                    save = self.saves.pop()
                    if save is not None:
                        param.args[0].restoreToCount(save)

        class MainHeaderBlurHook(MethodHook):
            calls = IdentityHashMap()

            def __init__(self):
                self.saves = []

            @hook_filters(
                HookFilter.Condition(
                    "if (!object[0].contains(this)) { return false; } "
                    "object[1].put(param, true); return true;",
                    object=jarray(jclass("java.lang.Object"))([plugin._main_header_views, calls]),
                )
            )
            def before_hooked_method(self, param):
                save = None
                owner = plugin._owner(param.thisObject) if plugin._active else None
                if owner is not None and _identity(owner) in plugin._main_headers:
                    clear = plugin._main_header_clear(owner, allow_search=True)
                    if clear and bool(param.args[4]):
                        canvas, rect = param.args[0], param.args[2]
                        try:
                            # Весь вызов рисует общую подложку, а не отдельные капсулы.
                            save = canvas.save()
                            canvas.clipOutRect(
                                int(rect.left), int(rect.top), int(rect.right), int(rect.bottom)
                            )
                            plugin._header_trace(
                                owner,
                                "прямоугольник контейнера отсечён",
                                f"rect={rect}; overload_args={len(param.args)}",
                            )
                        except Exception as exc:
                            if save is not None:
                                canvas.restoreToCount(save)
                                save = None
                            plugin._warn_once("Прямоугольное отсечение главной шапки", exc)
                    elif not clear:
                        plugin._header_trace(
                            owner,
                            "подложка сохранена для выделения/preview",
                            f"search={plugin.field(owner, 'searchAnimationProgress')}; action={plugin.field(owner, 'progressToActionMode')}",
                        )
                self.saves.append(save)

            @hook_filters(HookFilter.Condition("object.remove(param) != null", object=calls))
            def after_hooked_method(self, param):
                if self.saves:
                    save = self.saves.pop()
                    if save is not None:
                        param.args[0].restoreToCount(save)

        class MainSearchDrawHook(MethodHook):
            calls = IdentityHashMap()

            def __init__(self):
                self.saved = []

            @hook_filters(
                HookFilter.Condition(
                    "if (!object[0].contains(this)) { return false; } "
                    "object[1].put(param, true); return true;",
                    object=jarray(jclass("java.lang.Object"))([plugin._owned_views, calls]),
                )
            )
            def before_hooked_method(self, param):
                view, states = param.thisObject, []
                self.saved.append(states)
                owner = plugin._owner(view) if plugin._active else None
                if (
                    owner is not None
                    and plugin._enabled("glass_main_search")
                    and not plugin.field(owner, "inPreviewMode")
                    and float(plugin.field(owner, "progressToActionMode") or 0) <= 0
                ):
                    search = plugin._main_searches.get(_identity(owner))
                    current = plugin.field(view, "blurredBackgroundDrawable")
                    cached = plugin._styled_glass.get(_identity(current))
                    if (
                        search is None
                        or not search.get("ready")
                        or _identity(search["view"]) != _identity(view)
                        or _identity(search["drawable"]) != _identity(current)
                        or cached is None
                        or cached[1][0] != _is_dark()
                        or _identity(plugin.field(current, "colorProvider")) != _identity(cached[2])
                    ):
                        plugin._style_main_search(owner)
                        search = plugin._main_searches.get(_identity(owner))
                    elif not plugin._round_video_active:
                        plugin._sample_header_fade(owner, current, sample=([], ()))
                        plugin._sync_surface_offset(owner, view, current, plugin.glass_factory(owner))
                    if (
                        search is not None
                        and search.get("ready")
                        and _identity(search["view"]) == _identity(view)
                    ):
                        bg = plugin.field(view, "bg")
                        if bg is not None:
                            states.append((bg, int(bg.getAlpha())))
                            bg.setAlpha(0)
                        drawable = search["drawable"]
                        # RenderNode хранится по ссылке: сброс alpha после draw скроет и записанный слой.
                        if int(drawable.getAlpha()) != 255:
                            drawable.setAlpha(255)

            @hook_filters(HookFilter.Condition("object.remove(param) != null", object=calls))
            def after_hooked_method(self, param):
                if self.saved:
                    for drawable, alpha in self.saved.pop():
                        drawable.setAlpha(alpha)

        class HeaderRootDrawHook(MethodHook):
            calls = IdentityHashMap()

            def __init__(self):
                self.saved = []

            @hook_filters(
                HookFilter.Condition(
                    "if (!object[0].contains(this)) { return false; } "
                    "object[1].put(param, true); return true;",
                    object=jarray(jclass("java.lang.Object"))([plugin._main_header_views, calls]),
                )
            )
            def before_hooked_method(self, param):
                plugin._diag_draw(0)
                states = []
                owner = plugin._owner(param.thisObject) if plugin._active else None
                if (
                    owner is not None
                    and _identity(owner) in plugin._main_headers
                    and _identity(param.thisObject) == _identity(plugin.field(owner, "fragmentView"))
                ):
                    try:
                        # При кружке берём готовый градиент, шапку повторно не обходим.
                        if not plugin._round_video_active:
                            plugin._main_top_fade(owner)
                            folders = plugin.field(owner, "filterTabsView")
                            surface = plugin._extra_surfaces.get(
                                (_identity(folders), "blurredBackgroundDrawable")
                            )
                            if surface is not None and plugin._enabled("glass_folders"):
                                plugin._sample_header_fade(owner, surface["surface"], opacity=0.35)
                    except Exception as exc:
                        plugin._warn_once("Верхний градиент главного экрана", exc)
                if owner is not None and plugin._main_header_clear(owner, allow_search=True):
                    # Форк может рисовать обычный прямоугольник тем же paint, минуя blur.
                    paint = plugin.field(owner, "actionBarDefaultPaint")
                    if paint is not None:
                        states.append((paint, int(paint.getAlpha())))
                        paint.setAlpha(0)
                        plugin._header_trace(owner, "сплошная заливка контейнера отключена")
                self.saved.append(states)

            @hook_filters(HookFilter.Condition("object.remove(param) != null", object=calls))
            def after_hooked_method(self, param):
                if self.saved:
                    for paint, alpha in self.saved.pop():
                        paint.setAlpha(alpha)
                if plugin._active and plugin._logging_enabled:
                    owner = plugin._owner(param.thisObject)
                    entry = plugin._main_headers.get(_identity(owner))
                    if (
                        entry is not None
                        and entry.get("ready")
                        and not entry.get("glass_frame_logged")
                        and getattr(param, "args", None)
                    ):
                        try:
                            canvas = param.args[0]
                            hardware = canvas.isHardwareAccelerated()
                            entry["glass_frame_logged"] = True
                            plugin.log(
                                f"Главная: снимок стекла в конце кадра; hardware={hardware}\n"
                                + plugin._glass_diagnostics()
                            )
                        except Exception as exc:
                            plugin._warn_once("Диагностика кадра стекла", exc)

        class HeaderShadowHook(MethodHook):
            # Форк рисует тень через forcedDividerPaint; нужен View фрагмента, а не фрагмент.
            @hook_filters(
                HookFilter.Condition(
                    "if (object.contains(this.getFragmentView()) && !this.isInPreviewMode() "
                    "&& this.getActionBar() != null && this.getActionBar().getActionModeFactor() <= 0) { "
                    "param.setResult(null); } return false;",
                    object=plugin._main_header_views,
                )
            )
            def before_hooked_method(self, param):
                pass

        class HeaderFadeDrawHook(MethodHook):
            @hook_filters(
                HookFilter.Condition(
                    "return object[0].contains(this) && object[1][0] == 0;",
                    object=jarray(jclass("java.lang.Object"))(
                        [plugin._main_header_views, plugin._round_capture_gate]
                    ),
                )
            )
            def before_hooked_method(self, param):
                plugin._diag_draw(1)
                owner = plugin._owner(param.thisObject) if plugin._active else None
                entry = plugin._main_headers.get(_identity(owner))
                if entry is None or _identity(entry.get("fade_view")) != _identity(param.thisObject):
                    return
                sample = plugin._header_fade_sample(owner)
                for drawable in entry["drawables"]:
                    plugin._sample_header_fade(owner, drawable, sample)

        # clipRect самого ContentView не зависит от clipChildren. Меняем только прямых детей.
        class HeaderListDrawHook(MethodHook):
            calls = IdentityHashMap()
            java_calls = IdentityHashMap()

            def __init__(self):
                self.contexts = []

            @hook_filters(
                HookFilter.Condition(
                    "if (!object[0].contains(this)) { return false; } "
                    "native = object[3].get(this); "
                    "if (native != null) { context = native.before(param.args); if (context != null) { "
                        "if (context[0]) { param.setResult(true); } object[4].put(param, new Object[] {native, context}); return false; } } "
                     "if (object[5][0] != 0) { return false; } "
                     "state = object[2].get(this); "
                    "if (state != null) { child = param.args[1]; owner = state[0]; "
                    "match = child == state[1].get(owner) || child == state[2].get(owner) || child == state[4]; "
                    "pages = state[3].get(owner); if (!match && pages != null) { "
                    "foreach (page : pages) { if (page == child) { match = true; } } } "
                    "if (!match) { return false; } } object[1].put(param, true); return true;",
                    object=jarray(jclass("java.lang.Object"))(
                        [
                            plugin._main_header_views,
                            calls,
                            plugin._header_list_targets,
                            plugin._java_list_targets,
                            java_calls,
                            plugin._round_capture_gate,
                        ]
                    ),
                )
            )
            def before_hooked_method(self, param):
                root = param.thisObject
                context = [None, None, None]
                self.contexts.append(context)
                owner = plugin._owner(root) if plugin._active else None
                entry = plugin._main_headers.get(_identity(owner))
                if (
                    entry is not None
                    and _identity(entry.get("fade_view")) == _identity(param.args[1])
                    and plugin.field(root, "drawingBlur")
                ):
                    param.setResult(True)
                    return
                if owner is None or not plugin._main_header_clear(owner, allow_search=True):
                    return
                bar = plugin._main_headers[_identity(owner)]["bar"]
                if _identity(bar) == _identity(param.args[1]) and bar.getBackground() is not None:
                    # background рисуется до dispatchDraw, поэтому убираем его на входе в draw.
                    bar.setBackground(None)
                    plugin._header_trace(owner, "фон View верхней панели удалён до draw")
                fade = plugin.field(owner, "topBubblesFadeView")
                if (
                    fade is not None
                    and _identity(fade) == _identity(param.args[1])
                    and not plugin.field(root, "drawingBlur")
                ):
                    plugin._header_trace(owner, "верхний градиент пропущен при drawChild")
                    param.setResult(True)
                    return
                # При закрытии поиска список виден ещё до нулевого searchAnimationProgress.
                if plugin.field(owner, "searchIsShowed"):
                    return
                try:
                    pages = plugin.field(owner, "viewPages")
                    if pages is None or not any(
                        _identity(page) == _identity(param.args[1]) for page in pages if page is not None
                    ):
                        return
                    flag = plugin._header_blur_flag
                    if flag is None:
                        plugin._header_trace(
                            owner, "отсечение списка сохранено", "Не найден флаг drawingBlur"
                        )
                        return
                    drawing_blur = bool(flag.getBoolean(None))
                    slide = plugin.field(owner, "slideFragmentProgress")
                    right = plugin.field(owner, "rightSlidingDialogContainer")
                    if not drawing_blur and (right is None or not right.hasFragment()):
                        if slide is not None and float(slide) != 1.0:
                            lite = plugin.field(owner, "slideFragmentLite")
                            amplitude = plugin.field(owner, "slideAmplitudeDp")
                            scroll = plugin.field(owner, "scrollYOffset")
                            # shortcut: неизвестную схему анимации форка не меняем, добавить при наличии его исходников.
                            if lite is None or amplitude is None or scroll is None:
                                plugin._header_trace(
                                    owner, "анимация списка сохранена", "Неизвестная схема slideFragment"
                                )
                                return
                            progress = 1.0 - float(slide)
                            canvas = param.args[0]
                            pivot = (
                                -float(root.getY()) + float(scroll) + float(root.getActionBarFullHeight())
                                if not lite
                                else 0.0
                            )
                            context[2] = canvas.save()
                            canvas.translate(
                                -float(AndroidUtilities.dp(float(amplitude) if lite else 4.0)) * progress, 0.0
                            )
                            if not lite:
                                scale = 1.0 - 0.05 * progress
                                canvas.scale(scale, scale, 0.0, pivot)
                        # Здесь нет штатного clip; ART мог встроить высоту и обойти наш хук.
                        context[:2] = [flag, drawing_blur]
                        flag.setBoolean(None, True)
                        plugin._header_trace(
                            owner,
                            "список рисуется за капсулами",
                            "native drawingBlur branch; layout/Blur3 unchanged",
                        )
                except Exception as exc:
                    if context[0] is not None:
                        context[0].setBoolean(None, context[1])
                    if context[2] is not None:
                        param.args[0].restoreToCount(context[2])
                    context[:] = [None, None, None]
                    plugin._warn_once("Отсечение списка под главной шапкой", exc)

            # В MVEL нет try/finally, поэтому флаг и Canvas восстанавливаем в Java.
            @hook_filters(
                HookFilter.Condition(
                    "frame = object[1].remove(param); if (frame != null) { frame[0].after(param.args, frame[1]); } "
                    "return object[0].remove(param) != null;",
                    object=jarray(jclass("java.lang.Object"))([calls, java_calls]),
                )
            )
            def after_hooked_method(self, param):
                if self.contexts:
                    flag, old, save = self.contexts.pop()
                    try:
                        if flag is not None:
                            flag.setBoolean(None, old)
                    finally:
                        if save is not None:
                            param.args[0].restoreToCount(save)

        class HeaderMenuHook(MethodHook):
            def before_hooked_method(self, param):
                if not plugin._active:
                    return
                menu = param.thisObject
                owner = plugin._owner(plugin.field(menu, "parentActionBar"))
                entry = plugin._main_headers.get(_identity(owner))
                if entry is not None:
                    plugin._remember_header_menu(entry, menu)
                    menu.setGlassMode(True)

        class HeaderBarBlurHook(MethodHook):
            calls = IdentityHashMap()

            def __init__(self):
                self.saved = []

            @hook_filters(
                HookFilter.Condition(
                    "if (!object[0].contains(this)) { return false; } "
                    "object[1].put(param, true); return true;",
                    object=jarray(jclass("java.lang.Object"))([plugin._main_header_views, calls]),
                )
            )
            def before_hooked_method(self, param):
                bar, old, fields = param.thisObject, None, []
                self.saved.append([old, fields])
                owner = plugin._owner(bar) if plugin._active else None
                if owner is not None and plugin._main_header_clear(owner, allow_search=True):
                    old = plugin.field(bar, "blurredBackground")
                    self.saved[-1][0] = old
                    if bar.getBackground() is not None:
                        bar.setBackground(None)
                    plugin._set_java_field(bar, "blurredBackground", False, "bool")
                    if plugin.field(owner, "searchIsShowed"):
                        # Возвращаем стекло до конца анимации закрытия поиска.
                        for name in ("glassDrawable", "glassDrawableBack", "glassDrawableMenu"):
                            drawable = plugin.field(bar, name)
                            if drawable is not None:
                                fields.append((name, drawable))
                                plugin._set_java_field(bar, name, None, "obj")
                    elif plugin._draw_main_title(owner, bar, param.args[0]):
                        drawable = plugin.field(bar, "glassDrawable")
                        fields.append(("glassDrawable", drawable))
                        plugin._set_java_field(bar, "glassDrawable", None, "obj")
                    plugin._header_trace(
                        owner, "прямоугольник ActionBar отключён", f"blurredBackground={old}"
                    )

            @hook_filters(HookFilter.Condition("object.remove(param) != null", object=calls))
            def after_hooked_method(self, param):
                if self.saved:
                    old, fields = self.saved.pop()
                    for name, drawable in fields:
                        plugin._set_java_field(param.thisObject, name, drawable, "obj")
                    if old is not None:
                        plugin._set_java_field(param.thisObject, "blurredBackground", bool(old), "bool")

        story_frames = []

        class StoriesDrawHook(MethodHook):
            calls = IdentityHashMap()

            @hook_filters(
                HookFilter.Condition(
                    "if (!object[0].contains(this)) { return false; } "
                    "object[1].put(param, true); return true;",
                    object=jarray(jclass("java.lang.Object"))([plugin._main_header_views, calls]),
                )
            )
            def before_hooked_method(self, param):
                story_frames.append(None)
                stories = param.thisObject
                owner = plugin._owner(stories) if plugin._active else None
                if (
                    owner is None
                    or not plugin._main_header_clear(owner, allow_search=True)
                    or plugin.field(owner, "searchIsShowed")
                ):
                    return
                try:
                    canvas = param.args[0]
                    hardware = bool(canvas.isHardwareAccelerated())
                    entry = plugin._main_headers[_identity(owner)]
                    width, height = int(stories.getWidth()), int(stories.getHeight())
                    if width <= 0 or height <= 0:
                        return
                    node = entry.get("story_content" if hardware else "story_picture")
                    if node is None:
                        node = (
                            jclass("android.graphics.RenderNode")("TeleGlass stories content")
                            if hardware
                            else jclass("android.graphics.Picture")()
                        )
                        if hardware:
                            node.setClipToBounds(False)
                        entry["story_content" if hardware else "story_picture"] = node
                    if hardware:
                        node.setPosition(0, 0, width, height)
                    recording = node.beginRecording(width, height)
                    story_frames[-1] = (owner, stories, canvas, node, hardware, width, height)
                    # Дочерние display lists могут переиспользоваться без вызова dispatchDraw.
                    param.args[0] = recording
                except Exception as exc:
                    plugin._warn_once("Контекст отрисовки историй", exc)

            @hook_filters(HookFilter.Condition("object.remove(param) != null", object=calls))
            def after_hooked_method(self, param):
                if story_frames:
                    frame = story_frames.pop()
                    if frame is None:
                        return
                    owner, stories, canvas, node, hardware, width, height = frame
                    try:
                        node.endRecording()
                    finally:
                        param.args[0] = canvas
                    save = canvas.save()
                    try:
                        clip_top = plugin.field(stories, "clipTop") or 0
                        if clip_top > 0:
                            canvas.clipRect(0, int(clip_top), width, height)
                        fit = None
                        try:
                            fit = plugin._draw_stories_title(owner, stories, canvas)
                        except Exception as exc:
                            plugin._warn_once("Стекло заголовка историй", exc)
                        if fit is not None and fit[0] < 1.0:
                            # Сжимаем содержимое вместе с капсулой: текст и аватары не обрезаются.
                            canvas.scale(fit[0], 1.0, fit[1], 0.0)
                        # Координаты уже готовы; рисуем стекло раньше аватаров и текста.
                        if hardware:
                            canvas.drawRenderNode(node)
                        else:
                            canvas.drawPicture(node)
                    finally:
                        canvas.restoreToCount(save)

        class HeaderColorsHook(MethodHook):
            def after_hooked_method(self, param):
                owner = plugin._owner(param.thisObject) if plugin._active else None
                state = plugin._capture_states.get(_identity(owner))
                if state is not None:
                    state["clock"][0] = 0
                for state in plugin._settings_sources.values():
                    if _identity(state["proxy"].fragment) == _identity(owner):
                        state["proxy"].capture_signature = None
                if _identity(owner) not in plugin._main_headers:
                    return
                # Отдельная капсула историй не входит в ActionBar.updateColors().
                plugin._style_main_header(owner, allow_archive=True)
                stories = plugin.field(owner, "dialogStoriesCell")
                if stories is not None:
                    stories.invalidate()

        class AttachHook(MethodHook):
            @hook_filters(
                HookFilter.Condition(
                    "state = object.get(this); if (state == null) { return true; } "
                    "if (state[0] != null && state[0].getBackground() != state[1]) { return true; } "
                    "for (i = 2; i < state.length; i += 3) { "
                    "if (state[i + 1].get(state[i]) != state[i + 2]) { return true; } } return false;",
                    object=plugin._attach_targets,
                )
            )
            def before_hooked_method(self, param):
                plugin._style_attach_alert(param.thisObject)

        class AttachShownHook(MethodHook):
            def after_hooked_method(self, param):
                plugin._style_attach_alert(param.thisObject)

        class AttachClosedHook(MethodHook):
            def after_hooked_method(self, param):
                plugin._drop_chat(param.thisObject)

        class RoundPlayHook(MethodHook):
            def after_hooked_method(self, param):
                hint = None
                try:
                    # У форков MessageObject стоит на разных позициях в аргументах playMessage.
                    for value in param.args:
                        try:
                            if value is not None and bool(value.isRoundVideo()):
                                hint = value
                                break
                        except Exception:
                            pass
                except Exception:
                    pass
                plugin._round_start(param.thisObject, message_hint=hint)

        class RoundPlaybackHook(MethodHook):
            def after_hooked_method(self, param):
                plugin._round_start(param.thisObject)

        self._header_blur_hook = MainHeaderBlurHook()
        self._header_root_draw_hook = HeaderRootDrawHook()
        self._header_list_draw_hook = HeaderListDrawHook()
        for name, methods, hook in (
            ("org.telegram.ui.Components.MentionsContainerView", ("dispatchDraw",), MentionsHook()),
            (
                "org.telegram.ui.bots.BotCommandsMenuContainer",
                ("show", "setBackgroundDrawable", "updateColors", "onMeasure"),
                BotMenuHook(),
            ),
            (
                "org.telegram.ui.Components.MentionsContainerView",
                ("updateColors", "onAttachedToWindow", "onLayout"),
                MentionsColorsHook(),
            ),
            ("androidx.recyclerview.widget.RecyclerView", ("dispatchOnScrolled",), SettingsScrollHook()),
            (
                "org.telegram.ui.Components.EmojiView",
                ("setBlurredBackgroundDrawableFactory", "updateColors", "onAttachedToWindow", "onLayout"),
                EmojiControlsHook(),
            ),
            ("org.telegram.ui.Components.EmojiView", ("onOpen", "setVisibility"), EmojiOpenedHook()),
            ("org.telegram.ui.Components.EmojiView", ("dispatchDraw",), EmojiFirstFrameHook()),
            ("org.telegram.ui.Components.EmojiView", ("onDetachedFromWindow",), EmojiClosedHook()),
            (
                "org.telegram.ui.PhotoViewer",
                ("setParentActivity", "invalidateAllGlassAttachedViews"),
                PhotoControlsHook(),
            ),
            ("org.telegram.ui.PhotoViewer", ("drawCaptionBlur",), PhotoBlurHook()),
            ("org.telegram.ui.PhotoViewer", ("onPhotoClosed", "destroyPhotoViewer"), PhotoClosedHook()),
            (
                "org.telegram.ui.Components.blur3.drawable.BlurredBackgroundDrawableRenderNode",
                ("draw",),
                PanelBackgroundHook(),
            ),
            (
                "org.telegram.ui.Components.blur3.drawable.BlurredBackgroundDrawableRenderNode",
                ("draw",),
                NativeControlDrawHook(),
            ),
            (
                "org.telegram.ui.Components.chat.layouts.ChatActivityActionsButtonsLayout",
                (
                    "onMeasure",
                    "updateColors",
                    "showForwardButton",
                    "setForwardButtonEnabled",
                    "showReplyButton",
                    "setReplyButtonEnabled",
                ),
                ActionsHook(),
            ),
            ("org.telegram.ui.Components.TopicsTabsView", ("dispatchDraw",), TopicsHook()),
            ("org.telegram.ui.ChatActivity", ("createTopicsTabs",), TopicsCreatedHook()),
            ("org.telegram.ui.ProfileActivity", ("createView", "onResume"), ProfileTabsHook()),
            ("org.telegram.ui.Components.MediaActivity", ("createView", "onResume"), ProfileTabsHook()),
            ("org.telegram.ui.Components.MediaActivity", ("onFragmentDestroy",), FolderDestroyHook()),
            ("org.telegram.ui.Components.SizeNotifierFrameLayout", ("dispatchDraw",), MediaCaptureHook()),
            ("org.telegram.ui.Components.SharedMediaLayout$$ExternalSyntheticLambda12", ("capture",), SavedMessagesCaptureHook()),
            (
                "org.telegram.ui.Components.ScrollSlidingTextTabStrip",
                ("setBlurredBackground", "updateColors"),
                ProfileTabsViewHook(),
            ),
            (
                "org.telegram.ui.Components.RecyclerListView$FastScroll",
                ("applyBlurDrawables", "updateColors"),
                ProfileTabsViewHook(),
            ),
            ("org.telegram.ui.DialogsActivity", ("createView", "onResume", "updateColors"), FoldersHook()),
            ("org.telegram.ui.MainTabsActivity", ("onResume",), FoldersHook()),
            (
                "org.telegram.ui.Components.FilterTabsView",
                ("setBlurredBackground", "updateColors", "onLayout"),
                FolderViewHook(),
            ),
            (
                "org.telegram.ui.SearchTabsAndFiltersLayout",
                ("setBlurredBackground", "updateColors", "onSizeChanged"),
                FolderViewHook(),
            ),
            ("org.telegram.ui.SearchTabsAndFiltersLayout", ("dispatchDraw",), SearchTabsDrawHook()),
            ("org.telegram.ui.Components.DialogsActivityTopBubblesFadeView", ("onDraw",), FolderFadeHook()),
            ("org.telegram.ui.DialogsActivity", ("onFragmentDestroy",), FolderDestroyHook()),
            ("org.telegram.ui.Components.FragmentSearchField", ("dispatchDraw",), MainSearchDrawHook()),
            ("org.telegram.ui.DialogsActivity", ("drawHeaderShadow",), HeaderShadowHook()),
            (
                "org.telegram.ui.Components.chat.layouts.ChatActivityFadeView",
                ("onDraw",),
                HeaderFadeDrawHook(),
            ),
            ("org.telegram.ui.ActionBar.ActionBarMenu", ("onMeasure",), HeaderMenuHook()),
            ("org.telegram.ui.ActionBar.ActionBar", ("dispatchDraw",), HeaderBarBlurHook()),
            ("org.telegram.ui.ActionBar.ActionBar", ("updateColors",), HeaderColorsHook()),
            ("org.telegram.ui.Stories.DialogStoriesCell", ("dispatchDraw",), StoriesDrawHook()),
            ("org.telegram.ui.Components.RecyclerListView", ("dispatchDraw",), SettingsScrollHook()),
            ("org.telegram.ui.Components.ChatAttachAlert", ("blur3_InvalidateBlur",), AttachHook()),
            ("org.telegram.ui.Components.ChatAttachAlert", ("show", "checkColors"), AttachShownHook()),
            ("org.telegram.ui.Components.ChatAttachAlert", ("removeFromRoot",), AttachClosedHook()),
            (
                "org.telegram.messenger.MediaController",
                ("playMessage",),
                RoundPlayHook(),
            ),
            (
                "org.telegram.messenger.MediaController",
                (
                    "pauseMessage",
                    "resumeAudio",
                    "cleanupPlayer",
                    "startProgressTimer",
                    "pauseByRewind",
                    "resumeByRewind",
                ),
                RoundPlaybackHook(),
            ),
        ):
            try:
                cls = find_class(name)
                for method in methods:
                    self._hook_optional(cls, method, hook)
            except Exception as exc:
                self._warn_once("Дополнительные хуки: " + name, exc)

    def _set_capsule_background(self, view, background):
        if self._java_runtime is not None:
            self._java_runtime.capsuleBackground(view, background)
            return
        padding = None
        if hasattr(view, "getPaddingLeft"):
            padding = (
                int(view.getPaddingLeft()),
                int(view.getPaddingTop()),
                int(view.getPaddingRight()),
                int(view.getPaddingBottom()),
            )
        view.setBackground(background)
        if padding is not None:
            view.setPadding(*padding)

    def _restore_top_surface(self, key):
        entry = self._top_surfaces.pop(key, None)
        if entry is None:
            return
        try:
            view = entry["view"]
            if entry.get("role") == "player":
                fade = entry.get("player_fade")
                if fade is not None:
                    self._player_fade_targets.remove(fade)
                    fade.invalidate()
                self._restore_player_native_blur(view)
                if entry.get("player_draw_blur") is not None:
                    self._set_java_field(view, "drawBlur", entry["player_draw_blur"], "bool")
            self._unwatch_surface(view)
            if _identity(view.getBackground()) == _identity(entry["installed"]):
                view.setBackground(entry["original"])
                view.setPadding(*entry["padding"])
            for child, original in entry.get("cleared", []):
                if child.getBackground() is None:
                    self._set_capsule_background(child, original)
            view.invalidate()
        except Exception as exc:
            self._warn_once("Восстановление капсулы", exc)
        self._release_drawable(entry["surface"])

    # Верхний стек чата: закреп, плеер, перевод

    def _install_top_surface(self, fragment, view, setting, clear_child=None, role=None):
        if view is None:
            return
        role = role or setting.replace("glass_", "")
        key = _identity(view)
        if not self._enabled(setting):
            self._restore_top_surface(key)
            return
        try:
            entry = self._top_surfaces.get(key)
            pinned = self.field(fragment, "pinnedMessageView")
            pinned_entry = self._pinned_surfaces.get(_identity(pinned)) if pinned is not None else None
            if (
                entry is not None
                and role == "player"
                and (
                    entry.get("role") != "player"
                    or (
                        pinned_entry is not None
                        and _identity(entry.get("surface")) == _identity(pinned_entry.get("surface"))
                    )
                )
            ):
                self._restore_top_surface(key)
                entry = None
            height = int(view.getHeight() or view.getMeasuredHeight())
            if height <= 0 or int(view.getMeasuredWidth() or view.getWidth()) <= 0:
                return  # До измерения рано; повторим из onLayout.
            if entry is None:
                factory = self.glass_factory(fragment)
                if factory is None:
                    self._warn_once("Фабрика капсул", "В сборке нет доступной Blur3-фабрики")
                    return
                self._snapshot_object(factory, ("isLiquidGlassEffectAllowed",), fragment)
                factory.setLiquidGlassEffectAllowed(True)
                surface = factory.create(view)
                # У перевода и панели контакта задаём смещение явно, до draw и при анимации.
                if setting not in ("glass_translate", "glass_report_spam"):
                    self._track_native_position(surface, factory)
                if surface is None:
                    return
                surface.setPadding(0)
                variant = "pinned" if role == "player" else ""
                if not self.style_glass_drawable(
                    fragment, surface, self._top_capsule_radius(fragment, view), variant=variant
                ):
                    return
                # Лишний inset даст щель между соседними капсулами.
                installed = surface
                entry = {
                    "view": view,
                    "surface": surface,
                    "installed": installed,
                    "original": view.getBackground(),
                    "cleared": [],
                    "fragment": fragment,
                    "owner_key": _identity(fragment),
                    "factory": factory,
                    "role": role,
                    "padding": (
                        int(view.getPaddingLeft()),
                        int(view.getPaddingTop()),
                        int(view.getPaddingRight()),
                        int(view.getPaddingBottom()),
                    ),
                }
                self._top_surfaces[key] = entry
                self.log(f"Верхняя панель: капсула создана; role={entry['role']}")
            variant = "pinned" if role == "player" else ""
            self.style_glass_drawable(
                fragment, entry["surface"], self._top_capsule_radius(fragment, view), variant=variant
            )
            self._set_top_surface_radii(fragment, view, entry["surface"])
            # Анимации и положение AnimatedLinearLayout остаются штатными.
            if _identity(view.getBackground()) != _identity(entry["installed"]):
                current = view.getBackground()
                # Запоминаем новый фон Telegram, но не наше же стекло.
                if (
                    _identity(current) not in self._original_drawables
                    and _identity(current) != _identity(entry["surface"])
                ):
                    entry["original"] = current
                padding = (
                    int(view.getPaddingLeft()),
                    int(view.getPaddingTop()),
                    int(view.getPaddingRight()),
                    int(view.getPaddingBottom()),
                )
                view.setBackground(entry["installed"])
                view.setPadding(*padding)
            if setting in ("glass_translate", "glass_bot_photo", "glass_report_spam"):
                self._watch_surface(fragment, view, entry["surface"], entry["factory"])
            if clear_child is not None:
                bg = clear_child.getBackground()
                if bg is not None:
                    entry["cleared"] = [
                        (child, original)
                        for child, original in entry["cleared"]
                        if _identity(child) != _identity(clear_child)
                    ]
                    entry["cleared"].append((clear_child, bg))
                    self._set_capsule_background(clear_child, None)
            self._apply_joined_top_radii(fragment)
        except Exception as exc:
            self._warn_once(setting, exc)

    def _top_capsule_radius(self, fragment, view):
        if fragment is None or view is None:
            return dp(18)
        candidates = [
            self.field(fragment, "pinnedMessageView"),
            self.field(fragment, "translateButton"),
            self.field(fragment, "addProfilePictureButton"),
        ]
        context = self.field(fragment, "fragmentContextView")
        candidates.append(self.field(context, "frameLayout"))
        visible = [v for v in candidates if v is not None and v is not view]
        try:
            if int(view.getVisibility()) == 0 and any(int(v.getVisibility()) == 0 for v in visible):
                return 0.0
        except Exception:
            pass
        return min(dp(18), max(0.0, (float(view.getHeight() or view.getMeasuredHeight()) - dp(6)) / 2.0))

    def _visible_lower_capsules(self, fragment):
        context = self.field(fragment, "fragmentContextView")
        frame = self.field(context, "frameLayout")
        lower = []
        # Плеер стоит между закрепом и переводом, хотя его frame вложен в context.
        if (
            context is not None
            and frame is not None
            and int(context.getVisibility()) == 0
            and int(frame.getVisibility()) == 0
            and float(frame.getAlpha()) > 0.001
        ):
            lower.append(frame)
        for name in ("translateButton", "addProfilePictureButton"):
            view = self.field(fragment, name)
            if view is not None and int(view.getVisibility()) == 0:
                lower.append(view)
        return lower

    def _set_top_surface_radii(self, fragment, view, drawable):
        radius = min(dp(18), max(0.0, (float(view.getHeight() or view.getMeasuredHeight()) - dp(6)) / 2.0))
        try:
            pinned = self.field(fragment, "pinnedMessageView")
            has_pinned = pinned is not None and int(pinned.getVisibility()) == 0
            lower_views = self._visible_lower_capsules(fragment)
            lower = has_pinned and any(_identity(view) == _identity(v) for v in lower_views)
            bottom = radius if not lower or _identity(view) == _identity(lower_views[-1]) else 0.0
            self._set_surface_radii(
                drawable, 0.0 if lower else radius, 0.0 if lower else radius, bottom, bottom
            )
        except Exception as exc:
            self._warn_once("Радиусы капсулы", exc)

    def _apply_joined_top_radii(self, fragment):
        pinned = self.field(fragment, "pinnedMessageView")
        try:
            pinned_visible = (
                pinned is not None and int(pinned.getVisibility()) == 0 and self._enabled("glass_pinned")
            )
            pinned_entry = self._pinned_surfaces.get(_identity(pinned)) if pinned is not None else None
            pinned_visible = pinned_visible and pinned_entry is not None
            lower = self._visible_lower_capsules(fragment)
            panel = self.field(fragment, "topPanelLayout")
            if panel is not None:
                installed = int(pinned_visible) + sum(_identity(view) in self._top_surfaces for view in lower)
                if installed > 1:
                    self._panel_divider_targets.add(panel)
                else:
                    self._panel_divider_targets.remove(panel)

            # Blur3 ждёт углы в порядке TL, TR, BR, BL. updateColors может их сбросить.
            if pinned_entry is not None:
                radius = min(float(pinned.getHeight() or dp(48)) / 2.0, dp(24))
                has_lower = pinned_visible and bool(lower) and _identity(lower[0]) in self._top_surfaces
                pinned_surface = pinned_entry["surface"]
                self._set_surface_radii(
                    pinned_surface, radius, radius, 0.0 if has_lower else radius, 0.0 if has_lower else radius
                )
                self._set_joined_surface_edges(pinned_surface, seam="bottom" if has_lower else "none")

            for index, view in enumerate(lower):
                if view is None or int(view.getVisibility()) != 0:
                    continue
                entry = self._top_surfaces.get(_identity(view))
                if entry is None:
                    continue
                height = float(view.getHeight() or view.getMeasuredHeight() or dp(48))
                radius = min(height / 2.0, dp(24))
                surface = entry["surface"]
                joined_top = (
                    pinned_visible if index == 0 else _identity(lower[index - 1]) in self._top_surfaces
                )
                joined_bottom = index + 1 < len(lower) and _identity(lower[index + 1]) in self._top_surfaces
                bottom = 0.0 if joined_bottom else radius
                top = 0.0 if joined_top else radius
                self._set_surface_radii(surface, top, top, bottom, bottom)
                self._set_joined_surface_edges(
                    surface,
                    seam=(
                        "both"
                        if joined_top and joined_bottom
                        else "top" if joined_top else "bottom" if joined_bottom else "none"
                    ),
                )
        except Exception as exc:
            self._warn_once("Радиусы соединённых капсул", exc)

    def _set_surface_radii(self, drawable, top_left, top_right, bottom_right, bottom_left):
        radii = self.field(self.field(drawable, "boundProps"), "radii")
        expected = (
            top_left,
            top_left,
            top_right,
            top_right,
            bottom_right,
            bottom_right,
            bottom_left,
            bottom_left,
        )
        if (
            radii is not None
            and len(radii) == 8
            and all(abs(float(a) - b) < 0.001 for a, b in zip(radii, expected))
        ):
            return
        # setRadius пересобирает пути и display list даже при прежних значениях.
        drawable.setRadius(top_left, top_right, bottom_right, bottom_left)
        drawable.invalidateSelf()

    def _set_joined_surface_edges(self, drawable, seam="both"):
        """Убираем кант только на стыке, сохраняя внешний контур капсулы."""
        try:
            # Даже с прямыми углами между drawable остаётся кант.
            props = self.field(drawable, "boundProps")
            changed = False
            top = float(dp(RIM_WIDTH_TOP_DP)) * self._outline_width_factor()
            bottom = float(dp(RIM_WIDTH_BOTTOM_DP)) * self._outline_width_factor()
            if seam == "both":
                top = bottom = 0.0
            elif seam == "top":
                top = 0.0
            elif seam == "bottom":
                bottom = 0.0
            elif seam != "none":
                raise ValueError("unknown capsule seam: " + str(seam))
            if (
                abs(float(self.field(props, "strokeWidthTop") or 0) - top) > 0.001
                or abs(float(self.field(props, "strokeWidthBottom") or 0) - bottom) > 0.001
            ):
                drawable.setStrokeWidth(top, bottom)
                # Blur3 переносит strokeWidth в Paint только при onBoundPropsChanged.
                radii = self.field(props, "radii")
                if radii is not None and len(radii) == 8:
                    drawable.setRadius(float(radii[0]), float(radii[2]), float(radii[4]), float(radii[6]))
                changed = True
            expected_shadow = 0.0 if self._perf.get("no_shadow", True) else float(SHADOW_ALPHA)
            if seam != "none":
                expected_shadow = 0.0
            if abs(float(self.field(drawable, "shadowAlpha") or 0) - expected_shadow) > 0.001:
                drawable.setShadowAlpha(expected_shadow)
                changed = True
            if changed:
                drawable.invalidateSelf()
        except Exception as exc:
            self._warn_once("Стыки соединённых капсул", exc)

    def _style_player(self, context_view):
        if context_view is None or not self._active:
            return
        self._watch_player_layout(context_view)
        frame = self.field(context_view, "frameLayout")
        if frame is None:
            return
        fragment = self.field(context_view, "fragment") or self._owner(context_view)
        self._remember_owner(context_view, fragment)
        try:
            style = int(context_view.getCurrentStyle())
        except Exception:
            style = self.field(context_view, "currentStyle")
        # Стиль 0 — музыка, голосовые и кружки; звонки и геолокацию не трогаем.
        if not self._enabled("glass_player") or style is None or int(style) != 0:
            self._restore_player_native_blur(frame)
            self._restore_top_surface(_identity(frame))
            return
        if self.glass_factory(fragment) is None:
            return
        try:
            if (
                int(frame.getVisibility()) != 0
                or int(context_view.getVisibility()) != 0
                or float(frame.getAlpha()) <= 0.001
            ):
                self._restore_player_native_blur(frame)
                self._restore_top_surface(_identity(frame))
                return
        except Exception:
            pass
        self._install_top_surface(
            fragment, frame, "glass_player", self.field(context_view, "selector"), role="player"
        )
        entry = self._top_surfaces.get(_identity(frame))
        if entry is not None:
            entry["player_context"] = context_view
            # Это фейд под плеером, не верхний fade_view шапки.
            fade = self.field(fragment, "topBubblesFadeView")
            if _identity(entry.get("player_fade")) != _identity(fade):
                old_fade = entry.get("player_fade")
                if old_fade is not None:
                    self._player_fade_targets.remove(old_fade)
                    old_fade.invalidate()
                entry["player_fade"] = fade
                if fade is not None:
                    self._player_fade_targets.add(fade)
                    fade.invalidate()
            self._disable_player_native_blur(frame)
            entry["player_size"] = (int(frame.getMeasuredWidth()), int(frame.getMeasuredHeight()))

    def _disable_player_native_blur(self, frame):
        """Не даём штатной заливке рисоваться поверх стекла плеера."""
        if frame is None:
            return
        key = _identity(frame)
        surface = self._top_surfaces.get(key)
        if surface is not None:
            if "player_draw_blur" not in surface:
                surface["player_draw_blur"] = self.field(frame, "drawBlur")
            if self.field(frame, "drawBlur") is True:
                self._set_java_field(frame, "drawBlur", False, "bool")
            context = surface.get("player_context")
            owner = surface.get("fragment")
            # MiniPlayer меняет selector и оттенок независимо от FragmentContextView.updateStyle.
            for target in (
                context,
                self.field(owner, "fragmentContextViewWrapper"),
                self.field(context, "selector"),
            ):
                if target is None:
                    continue
                background = target.getBackground()
                if background is not None:
                    surface["cleared"] = [
                        (view, original)
                        for view, original in surface.get("cleared", [])
                        if _identity(view) != _identity(target)
                    ]
                    surface["cleared"].append((target, background))
                    self._set_capsule_background(target, None)
        if key not in self._player_native_colors or self.field(frame, "backgroundColor") not in (None, 0):
            self._player_native_colors[key] = (frame, self.field(frame, "backgroundColor"))
        if key not in self._player_native_backgrounds:
            surface = self._top_surfaces.get(key)
            original = (
                surface.get("original")
                if surface is not None
                and _identity(frame.getBackground()) == _identity(surface.get("installed"))
                else frame.getBackground()
            )
            self._player_native_backgrounds[key] = (frame, original)
        if key not in self._player_native_tags or self.field(frame, "tag") is not None:
            self._player_native_tags[key] = (frame, self.field(frame, "tag"))
        try:
            if self.field(frame, "backgroundColor") != 0:
                self._set_java_field(frame, "backgroundColor", 0, "int")
                frame.invalidate()
            if self.field(frame, "tag") is not None:
                self._set_java_field(frame, "tag", None, "obj")
        except Exception:
            pass

    def _restore_player_native_blur(self, frame):
        if frame is None:
            return
        entry = self._player_native_colors.pop(_identity(frame), None)
        if entry is not None:
            try:
                self._set_java_field(frame, "backgroundColor", entry[1], "int")
                frame.invalidate()
            except Exception:
                pass
        background = self._player_native_backgrounds.pop(_identity(frame), None)
        if background is not None:
            try:
                if frame.getBackground() is None:
                    frame.setBackground(background[1])
                    frame.invalidate()
            except Exception:
                pass
        tag = self._player_native_tags.pop(_identity(frame), None)
        if tag is not None:
            try:
                self._set_java_field(frame, "tag", tag[1], "obj")
            except Exception:
                pass

    def _panel_surfaces(self, owner):
        owner_key = _identity(owner)
        # Ключ владельца хранится в самой записи и удаляется вместе с ней.
        return tuple(
            entry
            for entry in chain(self._pinned_surfaces.values(), self._top_surfaces.values())
            if (entry["owner_key"] if "owner_key" in entry else _identity(entry.get("fragment"))) == owner_key
        )

    def _panel_clip_begin(self, panel, canvas):
        if not self._active:
            return None
        owner = self._owner(panel)
        if owner is None:
            return None
        # При кружке пропускаем тяжёлый repair, но оставляем отсечение.
        if not self._round_video_active:
            self._repair_chat_capsules(owner)
        save = None
        try:
            # Форки рисуют разделители не только через Theme.dividerPaint.
            op = jclass("android.graphics.Region$Op").DIFFERENCE
            save = int(canvas.save())
            panel_position = None
            # Вырезаем только строки на стыках, не фон и содержимое капсул.
            width, padding_top = float(panel.getWidth()), float(panel.getPaddingTop())
            for entry in self._panel_surfaces(owner):
                view = entry["view"]
                if int(view.getVisibility()) != 0 or _identity(view.getBackground()) != _identity(
                    entry["surface"]
                ):
                    continue
                position = self._source_position(owner, view, None)
                if panel_position is None:
                    panel_position = self._source_position(owner, panel, None)
                if position is None or panel_position is None:
                    continue
                top = position[1] - panel_position[1]
                if top > padding_top + 1:
                    canvas.clipRect(0.0, top - 1.0, width, top + 1.0, op)
            return save
        except Exception:
            if save is not None:
                canvas.restoreToCount(save)
            return None

    def _bind_runtime_panel(self, panel):
        if panel is None:
            return
        try:
            cls = panel.getClass()
            name = str(cls.getName())
            if name in self._runtime_panels:
                return
            self._runtime_panels.add(name)
            # Хук базового класса уже есть; добавляем только переопределения форков.
            if name == "org.telegram.ui.Components.ChatActivityTopPanelLayout":
                return
            plugin = self

            class ActualPanelHook(MethodHook):
                calls = IdentityHashMap()

                def __init__(self):
                    self.saves = []

                @hook_filters(
                    HookFilter.Condition(
                        "if (object[2][0] != 0 || !object[0].contains(this)) { return false; } "
                        "object[1].put(param, true); return true;",
                        object=jarray(jclass("java.lang.Object"))(
                            [plugin._owned_views, calls, plugin._round_capture_gate]
                        ),
                    )
                )
                def before_hooked_method(self, param):
                    self.saves.append(plugin._panel_clip_begin(param.thisObject, param.args[0]))

                @hook_filters(HookFilter.Condition("object.remove(param) != null", object=calls))
                def after_hooked_method(self, param):
                    if self.saves:
                        save = self.saves.pop()
                        if save is not None:
                            param.args[0].restoreToCount(save)

            self._hook_optional(cls, "dispatchDraw", ActualPanelHook())
            if self._panel_dividers_hook is not None:
                self._hook_optional(cls, "dispatchDraw", self._panel_dividers_hook)

            class ActualPanelLayout(MethodHook):
                def after_hooked_method(self, param):
                    if plugin._round_video_active:
                        return
                    owner = plugin._owner(param.thisObject)
                    if owner is not None:
                        plugin._repair_chat_capsules(owner)

            self._hook_optional(cls, "onLayout", ActualPanelLayout())
        except Exception as exc:
            self._warn_once("Хуки верхней панели", exc)

    def _suppress_panel_background(self, panel):
        if panel is None:
            return
        if self._java_stock_panels is not None:
            try:
                self._java_stock_panels.bind(self._owner(panel), panel, self._native_liquid_glass)
            except Exception as exc:
                self._warn_once("Материал штатной панели", exc)
        key = _identity(panel)
        original = self.field(panel, "backgroundDrawable")
        previous = self._panel_backgrounds.get(key)
        if previous is not None and _identity(previous[1]) == _identity(original):
            return
        if previous is not None:
            self._panel_blur_targets.remove(previous[1])
            self._panel_backgrounds.pop(key, None)
        # У отключённых и неизвестных нам строк должен остаться общий штатный фон.
        if original is not None:
            self._panel_backgrounds[key] = (panel, original)
            self._panel_blur_targets.put(original, panel)

    def _clip_stock_panel_background(self, panel, canvas):
        if not self._active:
            return None
        owner = self._owner(panel)
        if owner is None:
            return None
        save = None
        try:
            # Вырезаем только реально установленные капсулы, не весь общий фон.
            op = jclass("android.graphics.Region$Op").DIFFERENCE
            panel_key = _identity(panel)
            now = monotonic()
            cached = self._round_panel_clips.get(panel_key)
            refresh = not self._round_video_active or cached is None or now >= cached[0]
            if self._round_video_active and not refresh:
                save = int(canvas.save())
                for x, y, width, height in cached[1]:
                    canvas.clipRect(float(x), float(y), float(x + width), float(y + height), op)
                return save
            clips = []
            for entry in self._panel_surfaces(owner):
                view = entry["view"]
                if (
                    int(view.getVisibility()) != 0
                    or float(view.getAlpha()) <= 0.001
                    or _identity(view.getBackground()) != _identity(entry["surface"])
                ):
                    continue
                current = view
                x, y = 0.0, 0.0
                for _ in range(16):
                    if current is None or _identity(current) == panel_key:
                        break
                    if int(current.getVisibility()) != 0 or float(current.getAlpha()) <= 0.001:
                        break
                    x += float(current.getX())
                    y += float(current.getY())
                    current = current.getParent()
                if current is None or _identity(current) != panel_key:
                    continue
                width, height = int(view.getWidth()), int(view.getHeight())
                if width <= 0 or height <= 0:
                    continue
                if entry.get("role") == "player":
                    context = entry.get("player_context")
                    if context is not None:
                        y -= float(view.getY())
                        height = max(height, int(context.getHeight()))
                    # Общая подложка выступает за контент на 7dp с каждой стороны.
                    x, width = -float(dp(7)), int(panel.getWidth()) + int(dp(14))
                if self._round_video_active:
                    clips.append((x, y, width, height))
                if save is None:
                    save = int(canvas.save())
                canvas.clipRect(float(x), float(y), float(x + width), float(y + height), op)
            if self._round_video_active:
                self._round_panel_clips[panel_key] = (
                    now + 1.0 / max(1, self._perf.get("round_fps", 30)),
                    clips,
                )
            return save
        except Exception as exc:
            if save is not None:
                canvas.restoreToCount(save)
            self._warn_once("Отсечение фона штатной панели", exc)
            return None

    def _style_top_capsules(self, fragment):
        panel = self.field(fragment, "topPanelLayout")
        self._remember_owner(panel, fragment)
        self._bind_runtime_panel(panel)
        self._suppress_panel_background(panel)
        translate = self.field(fragment, "translateButton")
        self._install_top_surface(fragment, translate, "glass_translate", self.field(translate, "textView"))
        self._install_top_surface(
            fragment, self.field(fragment, "addProfilePictureButton"), "glass_bot_photo"
        )
        self._install_top_surface(fragment, self.field(fragment, "topChatPanelView"), "glass_report_spam")
        context_view = self.field(fragment, "fragmentContextView")
        if context_view is None:
            try:
                context_view = fragment.getFragmentContextView()
            except Exception:
                pass
        self._remember_owner(context_view, fragment)
        self._style_player(context_view)

    def _restore_native_surface(self, key):
        entry = self._native_surfaces.pop(key, None)
        if entry is None:
            return
        view, field, original, installed = entry
        self._unwatch_surface(view)
        try:
            current = (
                self._java_field(view, field).get(view) if field == "background" else self.field(view, field)
            )
            if _identity(current) == _identity(installed):
                if field == "backgroundDrawable" and hasattr(view, "setBlurredBackgroundDrawable"):
                    view.setBlurredBackgroundDrawable(original)
                else:
                    self._set_java_field(view, field, original, "obj")
                view.invalidate()
        except Exception as exc:
            self._warn_once("Восстановление штатной капсулы", exc)
        if field == "background":
            installed.setCallback(None)
        self._release_drawable(installed)

    # Кнопки и нижняя панель чата

    def _use_stock_header_blur(self, fragment, view, field):
        if view is None:
            return
        drawable = self.field(view, field)
        if drawable is None:
            self._restore_side_buttons(view=view, field=field)
            return
        source = self.field(fragment, "glassBackgroundSourceFrostedRenderNode") or self.field(
            fragment, "iBlur3SourceGlassFrosted"
        )
        provider = None
        if source is None:
            # В настройках один source: штатный код пишет в него канал -2 вместо обычного -3.
            previous = self._stock_side_surfaces.get((_identity(view), field))
            if previous is not None and _identity(previous[3]) == _identity(drawable):
                source = self.field(drawable, "source")
                provider = self.field(drawable, "colorProvider")
            else:
                original = self.field(drawable, "source")
                suppressor = self.field(fragment, "scrollableViewNoiseSuppressor")
                if original is None or suppressor is None:
                    return
                plugin = self
                native_provider = self.field(drawable, "colorProvider")
                if native_provider is None:
                    return

                class StockSettingsColors(
                    dynamic_proxy(
                        jclass(
                            "org.telegram.ui.Components.blur3.drawable.color.BlurredBackgroundColorProvider"
                        )
                    )
                ):
                    def getBackgroundColor(self):
                        # Обычное размытие нужно только расчёту этой заливки, не другим потокам и капсулам.
                        old = getattr(plugin._stock_header_flags, "plain", False)
                        plugin._stock_header_flags.plain = True
                        try:
                            return native_provider.getBackgroundColor()
                        finally:
                            plugin._stock_header_flags.plain = old

                    def getShadowColor(self):
                        return native_provider.getShadowColor()

                    def getStrokeColorTop(self):
                        return native_provider.getStrokeColorTop()

                    def getStrokeColorBottom(self):
                        return native_provider.getStrokeColorBottom()

                    def getStrokeColorFull(self):
                        return native_provider.getStrokeColorFull()

                provider = StockSettingsColors()

                class StockSettingsSource(
                    dynamic_proxy(jclass("org.telegram.ui.Components.blur3.source.BlurredBackgroundSource"))
                ):
                    def createDrawable(self):
                        return original.createDrawable()

                    def dispatchOnDrawablesRelativePositionChange(self):
                        original.dispatchOnDrawablesRelativePositionChange()

                    def draw(self, canvas, left, top, right, bottom):
                        save = canvas.save()
                        try:
                            canvas.clipRect(float(left), float(top), float(right), float(bottom))
                            canvas.drawColor(jint(fragment.getThemedColor(Theme.key_windowBackgroundGray)))
                            suppressor.draw(canvas, -3)
                        except Exception as exc:
                            plugin._warn_once("Штатное размытие настроек", exc)
                            original.draw(canvas, left, top, right, bottom)
                        finally:
                            canvas.restoreToCount(save)

                source = StockSettingsSource()
        self._restore_side_button(fragment, view, field, source, provider)

    def _restore_side_button(self, fragment, view, field, stock_source=None, stock_provider=None):
        # Общий LiteMode-хук включает стекло и у новых штатных кнопок.
        drawable = self.field(view, field)
        frosted = (
            stock_source
            or self.field(fragment, "glassBackgroundSourceFrostedRenderNode")
            or self.field(fragment, "iBlur3SourceGlassFrosted")
        )
        if drawable is None or frosted is None:
            return
        key = (_identity(view), field)
        previous = self._stock_side_surfaces.get(key)
        if previous is not None and _identity(previous[3]) != _identity(drawable):
            self._restore_side_buttons(view=view, field=field)
        source = self.field(drawable, "source")
        effect = self.field(drawable, "liquidGlassEffect")
        if (
            _identity(source) == _identity(frosted)
            and effect is None
            and (
                stock_provider is None
                or _identity(self.field(drawable, "colorProvider")) == _identity(stock_provider)
            )
        ):
            return
        if key not in self._stock_side_surfaces:
            self._stock_side_surfaces[key] = (
                fragment,
                view,
                field,
                drawable,
                source,
                effect,
                self.field(drawable, "colorProvider"),
            )
        if not self._set_java_field(drawable, "source", frosted, "obj"):
            raise RuntimeError("Не удалось вернуть штатное размытие кнопки")
        if effect is not None:
            self._set_glass_effect(drawable, None)
        if stock_provider is not None:
            drawable.setColorProvider(stock_provider)
        drawable.invalidateDisplayList()
        view.invalidate()

    def _restore_side_buttons(self, fragment=None, view=None, field=None):
        for key, (owner, button, name, drawable, source, effect, provider) in list(
            self._stock_side_surfaces.items()
        ):
            if fragment is not None and _identity(owner) != _identity(fragment):
                continue
            if view is not None and (_identity(button) != _identity(view) or name != field):
                continue
            if not self._set_java_field(drawable, "source", source, "obj"):
                self._warn_once("Восстановление источника боковой кнопки", "Не удалось восстановить источник кнопки")
            self._set_glass_effect(drawable, effect)
            if _identity(self.field(drawable, "colorProvider")) != _identity(provider):
                drawable.setColorProvider(provider)
            drawable.invalidateDisplayList()
            self._stock_side_surfaces.pop(key, None)

    def _restore_round_button_backgrounds(self, fragment=None, button=None):
        for key, (saved_button, original, skip_draw) in list(self._round_button_backgrounds.items()):
            if fragment is not None and _identity(self._owner(saved_button)) != _identity(fragment):
                continue
            if button is not None and _identity(saved_button) != _identity(button):
                continue
            try:
                if _identity(saved_button.getBackground()) != _identity(original):
                    saved_button.setBackground(original)
                    saved_button.invalidate()
                saved_button.setWillNotDraw(skip_draw)
            except Exception as exc:
                self._warn_once("Восстановление фона круглой кнопки", exc)
            self._round_button_backgrounds.pop(key, None)

    def _hide_capsule_view_background(self, button):
        if button is None:
            return
        key = _identity(button)
        saved = self._round_button_backgrounds.get(key)
        if saved is None:
            saved = (button, button.getBackground(), bool(button.willNotDraw()))
            self._round_button_backgrounds[key] = saved
        if button.getBackground() is not None:
            button.setBackground(None)
        if button.willNotDraw():
            button.setWillNotDraw(False)

    def _native_capsule(self, fragment, view, field, setting, radius, padding, factory=None):
        if view is None:
            return None
        self._remember_owner(view, fragment)
        key = (_identity(view), field)
        if not self._enabled(setting):
            self._restore_native_surface(key)
            if self._active and setting in ("glass_side", "glass_forward"):
                try:
                    self._restore_side_button(fragment, view, field)
                except Exception as exc:
                    self._warn_once("Восстановление боковой кнопки", exc)
            return None
        try:
            factory = factory if factory is not None else self.glass_factory(fragment)
            if setting in ("glass_side", "glass_forward"):
                self._restore_side_buttons(view=view, field=field)
            original = (
                self._java_field(view, field).get(view) if field == "background" else self.field(view, field)
            )
            if original is None:
                return None
            entry = self._native_surfaces.get(key)
            if entry is not None and _identity(original) != _identity(entry[3]):
                self._unwatch_surface(view)
                self._native_surfaces.pop(key, None)
                if field == "background":
                    entry[3].setCallback(None)
                self._release_drawable(entry[3])
                entry = None
            if entry is None:
                if factory is None:
                    return None
                if _identity(factory) == _identity(self.glass_factory(fragment)):
                    self._snapshot_object(factory, ("isLiquidGlassEffectAllowed",), fragment)
                factory.setLiquidGlassEffectAllowed(True)
                surface = factory.create(view)
                # pre-draw мог уже пройти, поэтому новому фону задаём координаты сразу.
                surface.setPadding(int(dp(padding)))
                try:
                    width, height = int(view.getWidth()), int(view.getHeight())
                except Exception:
                    width = height = 0
                if width > 0 and height > 0:
                    surface.setBounds(0, 0, width, height)
                else:
                    surface.setBounds(original.getBounds())
                if not self.style_glass_drawable(fragment, surface, dp(radius)):
                    return None
                if field == "backgroundDrawable" and hasattr(view, "setBlurredBackgroundDrawable"):
                    view.setBlurredBackgroundDrawable(surface)
                elif not self._set_java_field(view, field, surface, "obj"):
                    return None
                if field == "background":
                    surface.setCallback(view)
                entry = (view, field, original, surface)
                self._native_surfaces[key] = entry
                self.log(f"Кнопка: стекло подключено; setting={setting}; field={field}")
                view.invalidate()
            else:
                self.style_glass_drawable(fragment, entry[3], dp(radius))
            try:
                width, height = int(view.getWidth()), int(view.getHeight())
            except Exception:
                width = height = 0
            if width > 0 and height > 0 and field != "background":
                entry[3].setBounds(0, 0, width, height)
            if field in ("backgroundDrawable", "background"):
                self._watch_surface(fragment, view, entry[3], factory)
            else:
                self._sync_surface_offset(fragment, view, entry[3], factory)
            root = self.field(factory, "parent")
            if root is not None and not self._round_positions.containsKey(view):
                member = self._java_field(view, field)
                if member is not None:
                    self._round_positions.put(
                        view,
                        jarray(jclass("java.lang.Object"))(
                            [root, jclass("android.graphics.PointF")(), member, entry[3]]
                        ),
                    )
            return entry[3]
        except Exception as exc:
            self._warn_once(setting, exc)
            return None

    def _style_bulletin(self, layout):
        if not self._active:
            return
        try:
            bulletin = layout.getBulletin()
            fragment = self._owner(layout) or self.field(bulletin, "containerFragment") or get_last_fragment()
            if fragment is None:
                return
            member = self._java_field(layout, "background")
            if member is None:
                return
            tracked = self._surface_positions.get(_identity(layout))
            factory = tracked["factory"] if tracked is not None else self.glass_factory(fragment)
            if factory is None:
                source = self.field(fragment, "iBlur3SourceGlass") or self.field(
                    fragment, "iBlur3SourceColor"
                )
                root = self.field(fragment, "fragmentView")
                if source is None or root is None:
                    return
                factory = jclass("org.telegram.ui.Components.blur3.BlurredBackgroundDrawableViewFactory")(
                    source
                )
                factory.setSourceRootView(
                    jclass("org.telegram.ui.Components.chat.ViewPositionWatcher")(root), root
                )
            if self._source_position(fragment, layout, factory) is None:
                return
            height = (
                int(layout.getMeasuredBackgroundHeight())
                - int(layout.getPaddingTop())
                - int(layout.getPaddingBottom())
            )
            radius = max(float(dp(24)), height / 2.0)
            surface = self._native_capsule(fragment, layout, "background", None, radius / dp(1), 0, factory)
            if surface is not None:
                if self._is_settings_header(fragment, self.field(fragment, "actionBar")):
                    self._sample_settings_list(fragment, surface)
                if self._java_runtime is not None and self._java_bulletin_targets.get(layout) is None:
                    try:
                        self._java_bulletin_targets.put(
                            layout,
                            self._java_runtime.bulletin(layout, surface, self._java_field(surface, "source")),
                        )
                    except Exception as exc:
                        self._warn_once("Захват уведомления через Java недоступен, используем Python", exc)
                surface.invalidateDisplayList()
        except Exception as exc:
            self._warn_once("Стекло уведомления", exc)

    def _drop_bulletin(self, layout):
        self._restore_native_surface((_identity(layout), "background"))
        self._owners.pop(_identity(layout), None)
        self._owned_views.remove(layout)

    def _update_bulletin_capture(self, layout):
        state = self._surface_positions.get(_identity(layout)) if self._active else None
        if state is None:
            return
        try:
            surface = state["surface"]
            if not surface.hasDisplayList():
                return
            bounds = surface.getBounds()
            signature = (
                bounds.left,
                bounds.top,
                bounds.right,
                bounds.bottom,
                float(surface.getSourceOffsetX()),
                float(surface.getSourceOffsetY()),
            )
            if state.get("bulletin_capture") != signature:
                # Blur3 нужен готовый display list. На первом показе регистрируемся после draw.
                source = self.field(surface, "source")
                source.dispatchOnDrawablesRelativePositionChange()
                state["bulletin_capture"] = signature
                surface.invalidateDisplayList()
                layout.invalidate()
        except Exception as exc:
            self._warn_once("Границы захвата уведомления", exc)

    def _style_bottom_overlay(self, fragment):
        overlay = self.field(fragment, "bottomChannelButtonsLayout")
        self._remember_owner(self.field(fragment, "chatInputViewsContainer"), fragment)
        self._remember_owner(overlay, fragment)
        if overlay is not None:
            # Вторая заливка поверх фона кнопок затемняет стекло.
            self._snapshot_object(overlay, ("containerDrawable",), fragment)
            self._suppress_bottom_overlay_background(overlay, fragment)
            holders = self.field(overlay, "buttonHolders")
            if holders is not None:
                for holder in holders:
                    button = self.field(holder, "button")
                    if button is not None:
                        surface = self._native_capsule(
                            fragment, button, "backgroundDrawable", "glass_bottom", 22, 6
                        )
                        if surface is not None:
                            self._hide_capsule_view_background(button)
                        else:
                            self._restore_round_button_backgrounds(button=button)

    def _suppress_bottom_overlay_background(self, overlay, fragment):
        if overlay is None or not self._enabled("glass_bottom"):
            return
        # После updateColors поле containerDrawable может снова оказаться пустым.
        drawable = self._native_capsule(fragment, overlay, "containerDrawable", "glass_bottom", 22, 6)
        if drawable is not None:
            # Общей капсуле нужен только контур, заливка уже есть у кнопок.
            self.style_glass_drawable(fragment, drawable, dp(22), variant="bottom_container")
            try:
                overlay.invalidate()
            except Exception:
                pass

    def _style_side_capsules(self, fragment):
        layout = self.field(fragment, "sideControlsButtonsLayout")
        self._remember_owner(layout, fragment)
        holders = self.field(layout, "buttonHolders")
        if holders is None:
            return
        for holder in holders:
            button = self.field(holder, "button")
            actual = self.field(button, "buttonView")
            if actual is not None:
                self._remember_owner(actual, fragment)
                self._repair_round_button(actual, fragment)

    def _repair_round_button(self, button, fragment):
        if button is None or fragment is None or not self._active:
            return
        self._remember_owner(button, fragment)
        actions = self.field(fragment, "actionsButtonsLayout")
        setting = (
            "glass_forward"
            if any(
                _identity(button) == _identity(self.field(self.field(actions, name), "button"))
                for name in ("forwardButton", "replyButton")
            )
            else "glass_side"
        )
        # Форки хранят материал в разных полях и могут заменять их по отдельности.
        for field in ("backgroundDrawable", "blurredBackgroundDrawable", "glassDrawable"):
            if self.field(button, field) is not None:
                self._native_capsule(fragment, button, field, setting, 22, 6)
        if not self._enabled(setting):
            self._restore_round_button_backgrounds(fragment, button)
            self._round_targets.remove(button)
            return
        if not any(
            (_identity(button), field) in self._native_surfaces
            for field in ("backgroundDrawable", "blurredBackgroundDrawable", "glassDrawable")
        ):
            return  # При неудачной установке стекла оставляем штатную подложку.
        # Собственный inset-фон кнопки поверх backgroundDrawable затемняет стекло.
        key = _identity(button)
        saved = self._round_button_backgrounds.get(key)
        if saved is None:
            saved = (button, button.getBackground(), bool(button.willNotDraw()))
            self._round_button_backgrounds[key] = saved
        elif button.getBackground() is not None and _identity(button.getBackground()) != _identity(saved[1]):
            # updateColors() мог заменить штатный фон; сохраняем последнюю версию.
            saved = (button, button.getBackground(), saved[2])
            self._round_button_backgrounds[key] = saved
        if button.getBackground() is not None:
            button.setBackground(None)
        # Без View-background FrameLayout пропускает draw(), где рисуется капсула.
        if button.willNotDraw():
            button.setWillNotDraw(False)
        if self._round_targets is not None:
            try:
                pairs = []
                for name in ("backgroundDrawable", "blurredBackgroundDrawable", "glassDrawable"):
                    member = self._java_field(button, name)
                    if member is not None:
                        pairs.extend((member, member.get(button)))
                if pairs:
                    self._round_targets.put(button, jarray(jclass("java.lang.Object"))(pairs))
                    root = self.field(self.glass_factory(fragment), "parent")
                    if root is not None:
                        self._round_positions.put(
                            button,
                            jarray(jclass("java.lang.Object"))(
                                [root, jclass("android.graphics.PointF")(), *pairs]
                            ),
                        )
            except Exception as exc:
                self._warn_once("Фильтр круглых кнопок", exc)

    # Даты

    def _patch_date(self, cell, fragment=None):
        if not self._enabled("glass_dates"):
            return None
        if self._perf.get("native_dates", False) and _identity(cell) != self._floating_date_key:
            return None
        if cell is None or not self._active:
            return None
        if not self._is_date_cell(cell):
            self._unpatch_date(cell)
            return None

        key = _identity(cell)
        entry = self._patched_dates.get(key)
        if entry is None:
            self._date_cell_targets.add(cell)
            # StaticLayout сохраняет штатные размеры текста и шрифт.
            entry = {"cell": cell, "surface": None, "rim": None, "rim_sig": None, "bounds_sig": None}
            self._patched_dates[key] = entry
            now = monotonic()
            if now - self._last_date_log >= 1.0:
                self._last_date_log = now
                self.log("Дата: стекло подключено")
        if fragment is not None:
            entry["fragment"] = fragment
        return entry

    def _draw_date(self, cell, canvas, from_parent=False):
        """Заменяет только drawBackground; текст затем рисует штатный onDraw."""
        if not self._enabled("glass_dates"):
            return False
        if self._perf.get("native_dates", False) and _identity(cell) != self._floating_date_key:
            return False
        entry = self._patch_date(cell)
        if entry is None:
            return False
        layout = self.field(cell, "textLayout")
        if layout is None:
            return False

        try:
            text_w = int(self.field(cell, "textWidth") or 0)
            text_h = int(self.field(cell, "textHeight") or 0)
            if text_w <= 0 or text_h <= 0:
                return False

            # onDraw читает textPaint после drawBackground; берём paint готового layout.
            paint = layout.getPaint()
            if _identity(self.field(cell, "textPaint")) != _identity(paint):
                if not self._set_java_field(cell, "textPaint", paint, "obj"):
                    return False
            if from_parent:
                # Фон рисуется один раз внутри ячейки, уже с её alpha/clip.
                return True

            text_x = int(self.field(cell, "textX") or 0)
            text_y = int(self.field(cell, "textY") or 0)
            pad_x, pad_y = int(dp(14)), int(dp(6))
            bounds = (text_x - pad_x, text_y - pad_y, text_x + text_w + pad_x, text_y + text_h + pad_y)
            width, height = bounds[2] - bounds[0], bounds[3] - bounds[1]
            radius = height / 2.0

            fragment = entry.get("fragment") or get_last_fragment()
            floating = self.field(fragment, "floatingDateView")
            is_floating = floating is not None and _identity(floating) == _identity(cell)
            surface = entry.get("surface")
            if is_floating:
                factory = self.glass_factory(fragment)
                if factory is not None and entry.get("factory_key") != _identity(factory):
                    entry["factory_key"] = _identity(factory)
                    entry["factory"] = factory
                    surface = factory.create(cell)
                    # Закреп и перевод сдвигают дату после pre-draw; offset задаём перед draw.
                    if surface is not None and self.style_glass_drawable(fragment, surface, radius):
                        surface.setPadding(0)
                        surface.setCallback(cell)
                        entry["surface"] = surface
                    else:
                        surface = None
                        entry["surface"] = None
                if surface is not None:
                    style_key = (
                        _identity(entry.get("factory")),
                        int(radius),
                        _is_dark(),
                        self._perf.get("lens", 0),
                        bool(self._round_playing),
                    )
                    if not (self._round_playing and entry.get("round_style_key") == style_key):
                        self.style_glass_drawable(fragment, surface, radius)
                        entry["round_style_key"] = style_key
                    try:
                        cell.setBackground(None)
                    except Exception:
                        pass
                    if entry.get("bounds_sig") != bounds:
                        surface.setBounds(*bounds)
                        entry["bounds_sig"] = bounds
                    # ChatActionCell уже сдвинул Canvas, второй offset не нужен.
                    self._sync_surface_offset(fragment, cell, surface, entry.get("factory"))
                    surface.draw(canvas)

            factor = self._outline_factor()
            width_factor = self._outline_width_factor()
            # Маленьким датам нужен более тонкий контур, чем остальным капсулам.
            date_width_factor = 1.0 if self._appearance.get("outline", 3) == 3 else width_factor
            date_alpha_factor = 0.62 if self._appearance.get("outline", 3) == 3 else 1.0
            java_static_rim = not is_floating and self._java_runtime is not None
            rim_sig = (
                width,
                height,
                _is_dark(),
                surface is None,
                factor,
                date_width_factor,
                date_alpha_factor,
                java_static_rim,
            )
            if entry.get("rim_sig") != rim_sig:
                rim = self._date_materials.get(rim_sig)
                if rim is None and factor > 0:
                    if java_static_rim:
                        rim = self._java_runtime.dateRim(
                            float(radius),
                            width,
                            height,
                            float(dp(1)),
                            _is_dark(),
                            self._appearance.get("outline", 3),
                        )
                    else:
                        rim = create_glass_rim(radius, width, height, stroke_width=0.6 * date_width_factor)
                    if rim is not None:
                        if not java_static_rim:
                            rim.setAlpha(int(255 * min(1.0, factor) * date_alpha_factor))
                        self._date_materials[rim_sig] = rim
                        while len(self._date_materials) > 32:
                            self._date_materials.popitem(last=False)
                entry["rim"] = rim
                entry["rim_sig"] = rim_sig
            rim = entry.get("rim")
            if rim is not None:
                rim.setBounds(*bounds)
                rim.draw(canvas)
            drawn = surface is not None or rim is not None or factor == 0
            if drawn and is_floating and not _is_dark() and self._appearance.get("date_dark_text", True):
                try:
                    color = fragment.getThemedColor(Theme.key_windowBackgroundWhiteBlackText)
                    # int[] не требует упаковки jint в Object; общий Paint восстанавливаем после onDraw.
                    self._date_text_colors.put(
                        cell, jarray(jclass("java.lang.Object"))([paint, jarray(jint)([paint.getColor()])])
                    )
                    paint.setColor(jint(color))
                except Exception as exc:
                    # Стекло уже нарисовали; при ошибке цвета нельзя рисовать поверх штатный фон.
                    self._warn_once("Цвет плавающей даты", exc)
            return drawn
        except Exception as exc:
            if not entry.get("draw_error_logged"):
                self._warn_once("Фон даты", exc)
                entry["draw_error_logged"] = True
            # При несовместимом API остаётся штатная дата с её текстом.
            return False

    def _style_floating_date(self, fragment):
        if not self._enabled("glass_dates"):
            return
        floating = self.field(fragment, "floatingDateView")
        self._floating_date_key = _identity(floating) if floating is not None else 0
        self._floating_date_holder[0] = self._floating_date_key
        if floating is None or not self._active:
            return
        # Дочерняя View закрыла бы текст, поэтому стекло рисуется в drawBackground.
        self._patch_date(floating, fragment)
        floating.invalidate()

    def _unpatch_date(self, cell):
        if cell is None:
            return
        self._date_cell_targets.remove(cell)
        entry = self._patched_dates.pop(_identity(cell), None)
        if entry is not None:
            surface = entry.get("surface")
            if surface is not None:
                try:
                    surface.setCallback(None)
                except Exception:
                    pass
                self._release_drawable(surface)
            try:
                cell.invalidate()
            except Exception:
                pass

    def _is_date_cell(self, cell):
        if cell is None:
            return False
        try:
            if int(self.field(cell, "customDate") or 0) > 0:
                return True
        except Exception:
            pass
        msg = self.field(cell, "currentMessageObject")
        try:
            return msg is not None and bool(self.field(msg, "isDateObject"))
        except Exception:
            return False

    def _remove_header_island(self, container):
        if container is None:
            return
        key = _identity(container)
        data = self._header_islands.pop(key, None)
        if not data:
            return
        glass = data.get("glass")
        rim = self._rims.pop(_identity(glass), None) if glass is not None else None
        try:
            if glass is not None and rim is not None:
                glass.getOverlay().remove(rim)
            if glass is not None:
                parent = glass.getParent()
                if parent is not None:
                    parent.removeView(glass)
        except Exception:
            pass

    def _fallback_header_island(self, fragment, container):
        if container is None:
            return
        try:
            action_bar = self.field(fragment, "actionBar")
            if action_bar is not None:
                action_bar.setBackground(None)

            for name in ("titleTextView", "subtitleTextView"):
                text_view = self.field(container, name)
                if text_view is not None:
                    text_view.setBackground(None)

            c_w = int(container.getWidth() or 0)
            c_h = int(container.getHeight() or 0)
            if c_w <= 0 or c_h <= 0:
                return

            key = _identity(container)
            data = self._header_islands.get(key)
            if data is None or data.get("glass") is None or data["glass"].getParent() is None:
                context = container.getContext()
                glass = View(context)
                glass.setClickable(False)
                glass.setFocusable(False)
                container.addView(glass, 0, ViewGroup.LayoutParams(1, 1))
                data = {
                    "container": container,
                    "glass": glass,
                    "fragment": fragment,
                    "surface": None,
                    "rim_sig": None,
                }
                self._header_islands[key] = data

            glass = data["glass"]
            avatar = self.field(container, "avatarImageView")
            avatar_visible = avatar is not None and int(avatar.getVisibility()) == 0
            title = self.field(container, "titleTextView")
            subtitle = self.field(container, "subtitleTextView")

            title_w = 0
            if title is not None:
                try:
                    title_w = int(title.getTextWidth())
                except Exception:
                    title_w = int(title.getMeasuredWidth() or 0)
            sub_w = 0
            if subtitle is not None and int(subtitle.getVisibility()) == 0:
                try:
                    sub_w = int(subtitle.getTextWidth())
                except Exception:
                    sub_w = int(subtitle.getMeasuredWidth() or 0)
            text_w = max(title_w, sub_w, int(dp(70)))

            island_h = int(min(c_h, dp(48.0)))
            island_r = island_h / 2.0
            if avatar_visible:
                av_left = int(avatar.getLeft() or dp(6.0))
                av_right = int(avatar.getRight() or (av_left + dp(42.0)))
                island_left = max(int(dp(4.0)), av_left - int(dp(4.0)))
                island_right = av_right + text_w + int(dp(22.0))
            else:
                island_left = int(dp(8.0))
                island_right = island_left + text_w + int(dp(36.0))

            island_right = min(c_w - int(dp(8.0)), island_right)
            island_w = max(int(dp(110.0)), island_right - island_left)
            island_top = max(0, (c_h - island_h) // 2)
            island_bottom = island_top + island_h

            glass.layout(island_left, island_top, island_left + island_w, island_bottom)

            if data.get("surface") is None:
                data["surface"] = self.create_glass_surface(fragment, glass, island_r)
            else:
                self.style_glass_drawable(fragment, data["surface"], radius=island_r)

            self._apply_rim(_identity(glass), glass, island_r, island_w, island_h, (island_w, island_h), data)
        except Exception as exc:
            self._warn_once("Резервная капсула заголовка", exc)

    # Координаты Blur3 и закреп

    def _source_position(self, fragment, view, factory):
        """Локальный (0, 0) view относительно того же root, что у blur-фабрики."""
        root = self.field(factory, "parent")
        if root is None:
            parent_chat = self.field(fragment, "parentChatActivity")
            root = (
                self.field(parent_chat, "contentView")
                or self.field(fragment, "contentView")
                or self.field(fragment, "fragmentView")
            )
        if root is None:
            return None

        # Один вызов Java вместо переходов через мост для каждого родителя.
        if self._position_helper is None:
            try:
                helper = jclass("org.telegram.ui.Components.chat.ViewPositionWatcher")
                self._position_helper = helper if hasattr(helper, "computeCoordinatesInParent") else False
                if self._position_helper:
                    self._position_point = jclass("android.graphics.PointF")()
            except Exception:
                self._position_helper = False
        if self._position_helper:
            try:
                point = self._position_point
                if self._position_helper.computeCoordinatesInParent(view, root, point):
                    return float(point.x), float(point.y)
            except Exception:
                self._position_helper = False

        x, y = 0.0, 0.0
        current = view
        root_key = _identity(root)
        for _ in range(64):
            if current is None:
                break
            if _identity(current) == root_key:
                return x, y
            try:
                x += float(current.getX())
                y += float(current.getY())
                parent = current.getParent()
                if parent is None:
                    break
                x -= float(parent.getScrollX())
                y -= float(parent.getScrollY())
                current = parent
            except Exception:
                break

        # Вариант для разных окон/временного переподчинения View.
        try:
            if self._screen_positions is None:
                self._screen_positions = (jarray(jint)([0, 0]), jarray(jint)([0, 0]))
            view_pos, root_pos = self._screen_positions
            view.getLocationOnScreen(view_pos)
            root.getLocationOnScreen(root_pos)
            return float(view_pos[0] - root_pos[0]), float(view_pos[1] - root_pos[1])
        except Exception:
            return None

    def _sync_surface_offset(self, fragment, view, drawable, factory):
        if view is None or drawable is None:
            return False
        if _identity(drawable) in self._native_positions:
            return True
        position = self._source_position(fragment, view, factory)
        if position is None:
            return False
        x, y = position
        try:
            if float(drawable.getSourceOffsetX()) == x and float(drawable.getSourceOffsetY()) == y:
                return True
            # Только setter обновляет область выборки RenderNode и LiquidGlassEffect.
            drawable.setSourceOffset(float(x), float(y))
            return True
        except Exception:
            return False

    def _sync_pinned_offset(self, fragment, pinned, drawable, factory=None):
        if not self._active or not pinned.isAttachedToWindow() or not pinned.isShown():
            return
        self._sync_surface_offset(
            fragment, pinned, drawable, factory if factory is not None else self.glass_factory(fragment)
        )

    def _bind_pinned_position(self, entry):
        view = entry["view"]
        key = _identity(view)
        if _identity(entry["surface"]) in self._native_positions:
            return
        observer = view.getViewTreeObserver()
        previous = self._pinned_positions.get(key)
        if previous is not None:
            old_observer, listener = previous
            if old_observer.isAlive() and _identity(old_observer) == _identity(observer):
                return
            if old_observer.isAlive():
                old_observer.removeOnPreDrawListener(listener)
            self._pinned_positions.pop(key, None)
        if not observer.isAlive():
            return
        plugin = self

        class PinnedPosition(dynamic_proxy(jclass("android.view.ViewTreeObserver$OnPreDrawListener"))):
            def onPreDraw(self):
                plugin._pre_draw_depth += 1
                try:
                    current = plugin._pinned_surfaces.get(key)
                    if (
                        plugin._active
                        and current is not None
                        and _identity(view.getBackground()) == _identity(current["surface"])
                    ):
                        if plugin._round_video_active:
                            now = monotonic()
                            if now < current.get("round_next_position", 0.0):
                                return True
                            current["round_next_position"] = now + 1.0 / max(
                                1, plugin._perf.get("round_fps", 30)
                            )
                        plugin._sync_pinned_offset(
                            current["fragment"], view, current["surface"], current["factory"]
                        )
                        lower = plugin._visible_lower_capsules(current["fragment"])
                        joined_state = (
                            int(view.getVisibility()) == 0,
                            tuple(
                                (
                                    _identity(v),
                                    _identity(plugin._top_surfaces.get(_identity(v), {}).get("surface")),
                                )
                                for v in lower
                            ),
                        )
                        if current.get("joined_state") != joined_state:
                            plugin._apply_joined_top_radii(current["fragment"])
                            current["joined_state"] = joined_state
                except Exception as exc:
                    plugin._warn_once("Обновление закрепа перед отрисовкой", exc)
                finally:
                    plugin._pre_draw_depth = max(0, plugin._pre_draw_depth - 1)
                return True

        listener = PinnedPosition()
        observer.addOnPreDrawListener(listener)
        self._pinned_positions[key] = (observer, listener)

    def _bind_pinned_layout(self, fragment, view):
        key = _identity(view)
        if key in self._pinned_layouts:
            return
        plugin = self
        try:

            class PinnedLayout(dynamic_proxy(jclass("android.view.View$OnLayoutChangeListener"))):
                def onLayoutChange(
                    self, target, left, top, right, bottom, old_left, old_top, old_right, old_bottom
                ):
                    if not plugin._active or key in plugin._pinned_busy:
                        return
                    plugin._pinned_busy.add(key)
                    try:
                        plugin._style_pinned_message(fragment)
                    finally:
                        plugin._pinned_busy.discard(key)

            listener = PinnedLayout()
            view.addOnLayoutChangeListener(listener)
            self._pinned_layouts[key] = (view, listener)
        except Exception as exc:
            self._warn_once("Разметка закрепа", exc)

    def _bind_pinned_hooks(self, fragment, view):
        self._remember_owner(view, fragment)
        cls = view.getClass()
        key = str(cls.getName())
        if key in self._pinned_hooks:
            return
        self._pinned_hooks.add(key)
        plugin = self

        class PinnedStateHook(MethodHook):
            def after_hooked_method(self, param):
                if not plugin._active:
                    return
                owner = plugin._owner(param.thisObject)
                if owner is not None:
                    plugin._style_pinned_message(owner)
                    plugin._repair_chat_capsules(owner, True)

        for name in ("setVisibility", "onAttachedToWindow", "onLayout"):
            self._hook_optional(cls, name, PinnedStateHook())

    def _retry_pinned_message(self, fragment):
        """Первый закреп может появиться позже хуков создания ChatActivity."""
        if fragment is None or self.field(fragment, "isFinished"):
            return
        key = _identity(fragment)
        if key in self._pending_pinned:
            return
        attempt = self._pinned_retry_counts.get(key, 0)
        if attempt >= 40 or not self._active:
            return
        self._pinned_retry_counts[key] = attempt + 1
        delay = min(1000, (0, 16, 48, 100, 180, 300, 500, 800)[min(attempt, 7)] + max(0, attempt - 7) * 250)
        token = self._chat_tokens.setdefault(key, object())
        self._known_fragments[key] = fragment
        pending = object()
        self._pending_pinned[key] = pending

        def retry():
            if self._pending_pinned.get(key) is not pending:
                return
            self._pending_pinned.pop(key, None)
            if self._active and self._chat_tokens.get(key) is token:
                current = self._known_fragments.get(key)
                if current is not None:
                    if self.field(current, "isFinished"):
                        self._drop_chat(current)
                    else:
                        self._style_pinned_message(current)

        self.schedule(retry, delay)

    def _prepare_pinned(self, fragment):
        if fragment is None or not self._active:
            return
        panel = self.field(fragment, "topPanelLayout")
        self._remember_owner(panel, fragment)
        self._bind_runtime_panel(panel)

    def _style_pinned_message(self, fragment):
        if not self._enabled("glass_pinned"):
            for key, entry in list(self._pinned_surfaces.items()):
                if _identity(entry.get("fragment")) == _identity(fragment):
                    self._restore_pinned_entry(entry)
                    self._pinned_surfaces.pop(key, None)
            return
        if not self._active:
            return
        panel = self.field(fragment, "topPanelLayout")
        pinned = (
            self.field(fragment, "pinnedMessageView")
            or self.field(fragment, "pinnedMessageContainer")
            or self.field(fragment, "pinnedPanel")
            or self.field(fragment, "chatPinnedMessage")
        )
        if pinned is None:
            try:
                cls = fragment.getClass()
                while cls is not None and str(cls.getName()) != "org.telegram.ui.ChatActivity":
                    cls = cls.getSuperclass()
                if cls is None:
                    return
            except Exception:
                # Старые мосты могут не отдавать иерархию Java-классов.
                pass
            self._retry_pinned_message(fragment)
            return
        try:
            if int(pinned.getWidth()) <= 0 or int(pinned.getHeight()) <= 0:
                self._retry_pinned_message(fragment)
                return
        except Exception:
            self._retry_pinned_message(fragment)
            return
        self._bind_pinned_layout(fragment, pinned)
        self._bind_pinned_hooks(fragment, pinned)
        key = _identity(pinned)
        entry = self._pinned_surfaces.get(key)
        if entry is not None and any(
            _identity(other.get("surface")) == _identity(entry.get("surface"))
            for other_key, other in self._top_surfaces.items()
            if other_key != key
        ):
            # После переходов плеера закреп не должен получить его drawable.
            self._restore_pinned_entry(entry)
            self._pinned_surfaces.pop(key, None)
            entry = None
        if entry is not None:
            drawable = entry["surface"]

        if entry is None:
            original_background = pinned.getBackground()
            # Общий материал topPanelLayout даёт второй мутный слой под закрепом.
            factory = self.glass_factory(fragment)
            if factory is None:
                self._retry_pinned_message(fragment)
                return
            drawable = factory.create(pinned)
            # Закрепу нужен собственный pre-draw: наличие watcher не гарантирует актуальный offset.
            if drawable is None:
                self._retry_pinned_message(fragment)
                return
            drawable.setPadding(0)
            if not self.style_glass_drawable(
                fragment, drawable, min(float(pinned.getHeight() or dp(48)) / 2.0, dp(24)), variant="pinned"
            ):
                self._retry_pinned_message(fragment)
                return
            self._attach_pinned_surface(pinned, drawable)
            entry = {
                "view": pinned,
                "surface": drawable,
                "fragment": fragment,
                "factory": factory,
                "role": "pinned",
                "original_background": original_background,
                "installed_background": drawable,
            }
            self._pinned_surfaces[key] = entry
            self.log("Закреп: капсула создана")

        entry["fragment"] = fragment
        entry["owner_key"] = _identity(fragment)
        entry["factory"] = self.glass_factory(fragment)
        self._bind_pinned_position(entry)
        radius = min(float(pinned.getHeight() or dp(48)) / 2.0, dp(24))
        self.style_glass_drawable(fragment, drawable, radius, variant="pinned")
        # Нижние углы закрепа прямые, если под ним есть ещё одна капсула.
        try:
            lower = [self.field(fragment, "translateButton"), self.field(fragment, "addProfilePictureButton")]
            context = self.field(fragment, "fragmentContextView")
            frame = self.field(context, "frameLayout")
            lower.append(frame)
            has_lower = any(v is not None and int(v.getVisibility()) == 0 for v in lower)
            r = float(radius)
            self._set_surface_radii(drawable, r, r, 0.0 if has_lower else r, 0.0 if has_lower else r)
        except Exception:
            pass
        # Telegram может заменить приватные поля, не меняя View.background.
        self._attach_pinned_surface(pinned, drawable)
        self._sync_pinned_offset(fragment, pinned, drawable, entry.get("factory"))
        self._disable_pinned_native_blur(pinned)
        # Вырезаем штатный фон под закрепом только после установки его капсулы.
        self._suppress_panel_background(panel)
        pinned.invalidate()
        self._pinned_retry_counts.pop(_identity(fragment), None)
        self._pending_pinned.pop(_identity(fragment), None)
        self._apply_joined_top_radii(fragment)

    def _attach_pinned_surface(self, pinned, surface):
        """Согласуем View.background и приватные поля разных сборок клиента."""
        if pinned is None or surface is None:
            return
        changed = False
        try:
            self._snapshot_object(pinned, ("blurredBackgroundDrawable", "glassDrawable"), self._owner(pinned))
            setter = getattr(pinned, "setBlurredBackgroundDrawable", None)
            if setter is not None and _identity(self.field(pinned, "blurredBackgroundDrawable")) != _identity(
                surface
            ):
                setter(surface)
                changed = True
        except Exception:
            pass
        for name in ("blurredBackgroundDrawable", "glassDrawable"):
            try:
                if _identity(self.field(pinned, name)) != _identity(surface):
                    changed = self._set_java_field(pinned, name, surface, "obj") or changed
            except Exception:
                pass
        try:
            if _identity(pinned.getBackground()) != _identity(surface):
                pinned.setBackground(surface)
                changed = True
        except Exception:
            pass
        try:
            if changed:
                pinned.invalidate()
        except Exception:
            pass

    def _disable_pinned_native_blur(self, pinned):
        """Не даём штатной заливке перекрыть отдельное стекло закрепа."""
        if pinned is None:
            return
        key = _identity(pinned)
        if key not in self._pinned_native_colors:
            self._pinned_native_colors[key] = (pinned, self.field(pinned, "backgroundColor"))
        try:
            if self.field(pinned, "backgroundColor") != 0:
                self._set_java_field(pinned, "backgroundColor", 0, "int")
                pinned.invalidate()
        except Exception:
            pass

    def _restore_pinned_native_blur(self, pinned):
        if pinned is None:
            return
        entry = self._pinned_native_colors.pop(_identity(pinned), None)
        if entry is None:
            return
        try:
            self._set_java_field(pinned, "backgroundColor", entry[1], "int")
            pinned.invalidate()
        except Exception:
            pass

    def _restore_pinned_entry(self, entry):
        try:
            view, surface = entry["view"], entry["surface"]
            self._restore_pinned_native_blur(view)
            snapshot = self._original_objects.get(_identity(view))
            if snapshot is not None:
                for name in ("blurredBackgroundDrawable", "glassDrawable"):
                    if name in snapshot["fields"] and _identity(self.field(view, name)) == _identity(surface):
                        self._set_java_field(view, name, snapshot["fields"][name], "obj")
            current = view.getBackground()
            installed = entry.get("installed_background")
            if current is not None and installed is not None and _identity(current) == _identity(installed):
                view.setBackground(entry.get("original_background"))
            view.invalidate()
        except Exception:
            pass
        self._release_drawable(entry["surface"])

    # Установка хуков

    def install_hooks(self):
        plugin = self

        LiteMode = find_class("org.telegram.messenger.LiteMode")
        if LiteMode:
            try:
                FLAG_CHAT_BLUR = int(getattr(LiteMode, "FLAG_CHAT_BLUR", 256))
                FLAG_LIQUID_GLASS = int(getattr(LiteMode, "FLAG_LIQUID_GLASS", 1 << 18))
                needed = FLAG_CHAT_BLUR | FLAG_LIQUID_GLASS

                def force_flags(param):
                    try:
                        if (
                            getattr(self._stock_header_flags, "plain", False)
                            or (self._java_runtime is not None and self._java_runtime.stockColors())
                        ) and int(param.args[0]) == FLAG_LIQUID_GLASS:
                            param.setResult(False)
                            return
                        if self._active and (int(param.args[0]) & needed) != 0:
                            param.setResult(True)
                    except Exception:
                        pass

                java_class = LiteMode.getClass() if isinstance(LiteMode, type) else LiteMode
                for m in java_class.getDeclaredMethods():
                    if m.getName() == "isEnabled" and len(m.getParameterTypes()) == 1:
                        # Проверки анимаций строк эмодзи/стикеров не должны входить в Python.
                        self.hook_method(
                            m,
                            before=force_flags,
                            before_filters=[HookFilter.Condition(f"(param.args[0] & {needed}) != 0")],
                        )
            except Exception as exc:
                self._warn_once("Хуки LiteMode", exc)

        # Заменяем фон в штатном месте, до текста и с нативным Canvas clip.
        ChatActionCell = find_class("org.telegram.ui.Cells.ChatActionCell")
        if ChatActionCell:

            class _DateHook(MethodHook):
                def __init__(self, plugin):
                    self.plugin = plugin

                def after_hooked_method(self, param):
                    self.plugin._patch_date(param.thisObject)

            class _DateBackgroundHook(MethodHook):
                def __init__(self, plugin):
                    self.plugin = plugin

                @hook_filters(
                    HookFilter.Condition(
                        "if (!object[0].contains(this) || (object[1][0] != 0 && "
                        "java.lang.System.identityHashCode(this) != object[2][0])) { return false; } return true;",
                        object=jarray(jclass("java.lang.Object"))(
                            [
                                self._date_cell_targets,
                                self._native_dates_gate,
                                self._floating_date_holder,
                            ]
                        ),
                    )
                )
                def before_hooked_method(self, param):
                    plugin = self.plugin
                    if not plugin._enabled("glass_dates"):
                        return
                    if (
                        plugin._perf.get("native_dates", False)
                        and _identity(param.thisObject) != plugin._floating_date_key
                    ):
                        return
                    if plugin._draw_date(param.thisObject, param.args[0], bool(param.args[1])):
                        param.setResult(None)

            class _DateDetachHook(MethodHook):
                def __init__(self, plugin):
                    self.plugin = plugin

                def after_hooked_method(self, param):
                    self.plugin._unpatch_date(param.thisObject)

            class _DateTextRestoreHook(MethodHook):
                @hook_filters(
                    HookFilter.Condition(
                        "state = object.remove(this); if (state != null) { "
                        "state[0].setColor(state[1][0]); } return false;",
                        object=self._date_text_colors,
                    )
                )
                def after_hooked_method(self, param):
                    pass

            self._hook_optional(ChatActionCell, "setCustomDate", _DateHook(self))
            self._hook_optional(ChatActionCell, "setMessageObject", _DateHook(self))
            self._hook_optional(ChatActionCell, "onAttachedToWindow", _DateHook(self))
            self._hook_optional(ChatActionCell, "drawBackground", _DateBackgroundHook(self))
            self._hook_optional(ChatActionCell, "onDraw", _DateTextRestoreHook())
            self._hook_optional(ChatActionCell, "onDetachedFromWindow", _DateDetachHook(self))

        self._install_capsule_hooks()

        plugin = self

        class AdaptiveFragmentHook(MethodHook):
            def after_hooked_method(self, param):
                fragment = param.thisObject
                if plugin._active and plugin._is_settings_header(
                    fragment, plugin.field(fragment, "actionBar")
                ):
                    plugin._style_action_bar(fragment)

        class AdaptiveDestroyHook(MethodHook):
            def after_hooked_method(self, param):
                if plugin._is_settings_header(param.thisObject, plugin.field(param.thisObject, "actionBar")):
                    plugin._drop_chat(param.thisObject)

        base = find_class("org.telegram.ui.ActionBar.BaseFragment")
        for name in ("onViewCreated", "performCreateView", "onResume"):
            self._hook_optional(base, name, AdaptiveFragmentHook())
        self._hook_optional(base, "onFragmentDestroy", AdaptiveDestroyHook())

        ChatActivity = find_class("org.telegram.ui.ChatActivity")
        if ChatActivity:

            class _ChatViewHook(MethodHook):
                def __init__(self, plugin):
                    self.plugin = plugin

                def after_hooked_method(self, param):
                    try:
                        frag = param.thisObject
                        self.plugin._queue_chat(frag)
                    except Exception:
                        pass

            class _BindCapsulesHook(MethodHook):
                def __init__(self, plugin, queue_chat=False):
                    self.plugin = plugin
                    self.queue_chat = queue_chat

                def after_hooked_method(self, param):
                    frag = param.thisObject
                    panel = self.plugin.field(frag, "topPanelLayout")
                    self.plugin._remember_owner(panel, frag)
                    self.plugin._bind_runtime_panel(panel)
                    self.plugin._repair_chat_capsules(frag)
                    self.plugin._queue_capsules(frag)
                    if self.queue_chat:
                        self.plugin._queue_chat(frag)

            class _DropCapsulesHook(MethodHook):
                def __init__(self, plugin):
                    self.plugin = plugin

                def after_hooked_method(self, param):
                    self.plugin._drop_chat(param.thisObject)

            for name in ("updatePinnedMessage", "setPinnedMessage", "showPinnedMessage", "updateTopPanel"):
                self._hook_optional(ChatActivity, name, _BindCapsulesHook(self))
            self._hook_optional(ChatActivity, "onFragmentDestroy", _DropCapsulesHook(self))

            self._hook_optional(ChatActivity, "updateColors", _ChatViewHook(self))
            for name in (
                "onResume",
                "createView",
                "createPinnedMessageView",
                "createTranslateButton",
                "createAddProfilePictureButton",
                "createTopPanel",
            ):
                self._hook_optional(ChatActivity, name, _BindCapsulesHook(self, queue_chat=True))

    def _hook_optional(self, cls, name, hook):
        if cls is None:
            return
        try:
            # Для Python-обёртки Chaquopy getClass() возвращает отражаемый Java Class.
            java_class = cls.getClass() if isinstance(cls, type) else cls
            installed = 0
            for method in java_class.getDeclaredMethods():
                if str(method.getName()) == name:
                    method.setAccessible(True)
                    if self.hook_method(method, hook):
                        installed += 1
                    else:
                        self._warn_once(f"Установка хука {cls}.{name}", "SDK не подтвердил установку хука")
            if installed:
                self.log(f"Хуки: установлен; method={java_class.getName()}.{name}; overloads={installed}")
        except Exception as exc:
            self._warn_once(f"Хук {cls}.{name}", exc)

    def _install_capsule_hooks(self):
        plugin = self

        class PlayerHook(MethodHook):
            def after_hooked_method(self, param):
                was_active = plugin._round_video_active
                plugin._round_start()
                if was_active and plugin._round_video_active:
                    return
                context = param.thisObject
                plugin._style_player(context)
                owner = plugin._owner(context)
                if owner is not None:
                    plugin._repair_chat_capsules(owner, True)

        class PlayerMeasureHook(PlayerHook):
            def after_hooked_method(self, param):
                if not plugin._active:
                    return
                context = param.thisObject
                frame = plugin.field(context, "frameLayout")
                entry = plugin._top_surfaces.get(_identity(frame))
                if entry is not None:
                    try:
                        cached = plugin._styled_glass.get(_identity(entry["surface"]))
                        if (
                            int(context.getCurrentStyle()) == 0
                            and int(context.getVisibility()) == 0
                            and int(frame.getVisibility()) == 0
                            and float(frame.getAlpha()) > 0.001
                            and _identity(frame.getBackground()) == _identity(entry["installed"])
                            and entry.get("player_size")
                            == (int(frame.getMeasuredWidth()), int(frame.getMeasuredHeight()))
                            and cached is not None
                            and cached[1][0] == _is_dark()
                            and _identity(plugin.field(entry["surface"], "colorProvider"))
                            == _identity(cached[2])
                        ):
                            return
                    except Exception:
                        pass
                super().after_hooked_method(param)

        class PlayerDrawHook(MethodHook):
            @hook_filters(
                HookFilter.Condition(
                    "if (object[1][0] != 0 || !object[0].contains(this)) { return false; } return true;",
                    object=jarray(jclass("java.lang.Object"))(
                        [plugin._owned_views, plugin._round_capture_gate]
                    ),
                )
            )
            def before_hooked_method(self, param):
                plugin._diag_draw(4)
                if not plugin._active:
                    return
                context = param.thisObject
                frame = plugin.field(context, "frameLayout")
                if not plugin._enabled("glass_player"):
                    if (
                        _identity(frame) in plugin._top_surfaces
                        or _identity(frame) in plugin._player_native_colors
                    ):
                        plugin._style_player(context)
                    return
                entry = plugin._top_surfaces.get(_identity(frame)) if frame is not None else None
                # Тема может сбросить фон после checkPlayer; проверяем его перед отрисовкой.
                if entry is None or _identity(frame.getBackground()) != _identity(entry["installed"]):
                    plugin._style_player(context)
                elif entry is not None:
                    plugin._disable_player_native_blur(frame)
                    try:
                        style = int(context.getCurrentStyle())
                    except Exception:
                        style = plugin.field(context, "currentStyle")
                    if style is None or int(style) != 0:
                        plugin._restore_top_surface(_identity(frame))

        class PlayerFrameDrawHook(MethodHook):
            @hook_filters(
                HookFilter.Condition(
                    "if (object[1][0] != 0 || !object[0].contains(this)) { return false; } return true;",
                    object=jarray(jclass("java.lang.Object"))(
                        [plugin._owned_views, plugin._round_capture_gate]
                    ),
                )
            )
            def before_hooked_method(self, param):
                plugin._diag_draw(3)
                if not plugin._active:
                    return
                frame = param.thisObject
                if (
                    _identity(frame) in plugin._top_surfaces
                    or _identity(frame) in plugin._player_native_colors
                ):
                    plugin._disable_player_native_blur(frame)

        class MiniPlayerColorsHook(MethodHook):
            def after_hooked_method(self, param):
                context = plugin.field(param.thisObject, "host")
                frame = plugin.field(context, "frameLayout")
                if plugin._active and _identity(frame) in plugin._top_surfaces:
                    plugin._style_player(context)

        class RoundDrawHook(MethodHook):
            @hook_filters(
                HookFilter.Condition(
                    "if (object[0][0] == 0 || !object[1].contains(this)) { return false; } "
                    "state = object[2].get(this); if (state == null) { return true; } "
                    "for (i = 0; i < state.length; i += 2) { if (state[i].get(this) != state[i + 1]) { return true; } } return false;",
                    object=jarray(jclass("java.lang.Object"))(
                        [plugin._side_draw_enabled, plugin._owned_views, plugin._round_targets]
                    ),
                )
            )
            def before_hooked_method(self, param):
                if not plugin._active:
                    return
                button = param.thisObject
                owner = plugin._owner(button)
                if owner is not None:
                    plugin._repair_round_button(button, owner)

        class RoundPositionHook(MethodHook):
            @hook_filters(
                HookFilter.Condition(
                    "state = object.get(this); if (state == null) { return false; } "
                    "point = state[1]; "
                    "if (org.telegram.ui.Components.chat.ViewPositionWatcher.computeCoordinatesInParent(this, state[0], point)) { "
                    "for (i = 2; i < state.length; i += 2) { "
                    "drawable = state[i].get(this); "
                    "if (drawable != null && drawable == state[i + 1] "
                    "&& (drawable.getSourceOffsetX() != point.x || drawable.getSourceOffsetY() != point.y)) { "
                    "drawable.setSourceOffset(point.x, point.y); } } } return false;",
                    object=plugin._round_positions,
                )
            )
            def before_hooked_method(self, param):
                pass  # Координаты проверяются в Java; стабильный кадр не заходит в Python.

        class RoundColorsHook(MethodHook):
            def after_hooked_method(self, param):
                button = param.thisObject
                owner = plugin._owner(button) if plugin._active else None
                if owner is not None:
                    for field in ("backgroundDrawable", "blurredBackgroundDrawable", "glassDrawable"):
                        plugin._styled_glass.pop(_identity(plugin.field(button, field)), None)
                    plugin._repair_round_button(button, owner)

        class PanelHook(MethodHook):
            def after_hooked_method(self, param):
                if not plugin._active:
                    return
                owner = plugin._owner(param.thisObject)
                if owner is not None:
                    plugin._style_top_capsules(owner)
                    plugin._style_pinned_message(owner)
                    # После updateColors() заново задаём общие углы стека.
                    plugin._apply_joined_top_radii(owner)

        class PanelDividerPaintHook(MethodHook):
            calls = IdentityHashMap()

            # Разделители используют позиции аниматора, а не текущие координаты дочерних View.
            @hook_filters(
                HookFilter.Condition(
                    "if (object[0].contains(this)) { paint = object[2]; "
                    "object[1].put(param, new Object[] {paint, java.lang.Integer.valueOf(paint.getAlpha())}); "
                    "paint.setAlpha(0); } return false;",
                    object=jarray(jclass("java.lang.Object"))([plugin._panel_divider_targets, calls, Theme.dividerPaint]),
                )
            )
            def before_hooked_method(self, param):
                pass

            @hook_filters(
                HookFilter.Condition(
                    "state = object.remove(param); if (state != null) { state[0].setAlpha(state[1].intValue()); } return false;",
                    object=calls,
                )
            )
            def after_hooked_method(self, param):
                pass

        self._panel_dividers_hook = PanelDividerPaintHook()

        class PanelDividersHook(MethodHook):
            calls = IdentityHashMap()

            def __init__(self):
                self.clips = []

            @hook_filters(
                HookFilter.Condition(
                    "if (object[2][0] != 0 || !object[0].contains(this)) { return false; } "
                    "object[1].put(param, true); return true;",
                    object=jarray(jclass("java.lang.Object"))(
                        [plugin._owned_views, calls, plugin._round_capture_gate]
                    ),
                )
            )
            def before_hooked_method(self, param):
                plugin._diag_draw(2)
                self.clips.append(
                    plugin._panel_clip_begin(param.thisObject, param.args[0]) if plugin._active else None
                )
                if plugin._active and any(
                    plugin._enabled(k)
                    for k in (
                        "glass_pinned",
                        "glass_player",
                        "glass_translate",
                        "glass_bot_photo",
                        "glass_report_spam",
                    )
                ):
                    owner = plugin._owner(param.thisObject)
                    if owner is not None:
                        for field in (
                            "pinnedMessageView",
                            "translateButton",
                            "addProfilePictureButton",
                            "topChatPanelView",
                        ):
                            view = plugin.field(owner, field)
                            if view is not None:
                                entry = plugin._surface_positions.get(_identity(view))
                                if entry is not None and not (
                                    plugin._round_video_active
                                    and _identity(entry["surface"]) in plugin._native_positions
                                ):
                                    plugin._sync_surface_offset(
                                        owner, view, entry["surface"], entry["factory"]
                                    )

            @hook_filters(HookFilter.Condition("object.remove(param) != null", object=calls))
            def after_hooked_method(self, param):
                if self.clips:
                    save = self.clips.pop()
                    if save is not None:
                        param.args[0].restoreToCount(save)

        class TranslationColorsHook(MethodHook):
            def after_hooked_method(self, param):
                if plugin._active:
                    fragment = plugin.field(param.thisObject, "fragment")
                    if plugin.glass_factory(fragment) is not None:
                        plugin._install_top_surface(
                            fragment,
                            param.thisObject,
                            "glass_translate",
                            plugin.field(param.thisObject, "textView"),
                        )

        class BottomHook(MethodHook):
            def after_hooked_method(self, param):
                if not plugin._active:
                    return
                owner = plugin._owner(param.thisObject)
                if owner is not None:
                    plugin._style_bottom_overlay(owner)
                    plugin._style_side_capsules(owner)

        class BottomDrawHook(MethodHook):
            @hook_filters(
                HookFilter.Condition(
                    "return object[0][0] == 0;",
                    object=jarray(jclass("java.lang.Object"))([plugin._round_capture_gate]),
                )
            )
            def before_hooked_method(self, param):
                if not plugin._active:
                    return
                layout = param.thisObject
                owner = plugin._owner(layout) or get_last_fragment()
                if owner is not None:
                    plugin._remember_owner(layout, owner)
                    plugin._suppress_bottom_overlay_background(layout, owner)

        class SideDrawHook(MethodHook):
            @hook_filters(
                HookFilter.Condition(
                    "return object[0][0] == 0;",
                    object=jarray(jclass("java.lang.Object"))([plugin._round_capture_gate]),
                )
            )
            def before_hooked_method(self, param):
                if not plugin._active:
                    return
                layout = param.thisObject
                owner = plugin._owner(layout) or get_last_fragment()
                if owner is not None:
                    plugin._remember_owner(layout, owner)
                    plugin._style_side_capsules(owner)

        class InputBackdropHook(MethodHook):
            @hook_filters(
                HookFilter.Condition(
                    "if (object[2][0] != 0 || !object[0].contains(this)) { return false; } "
                    "gate = object[1].get(this); "
                    "return gate == null || gate.needsPython();",
                    object=jarray(jclass("java.lang.Object"))(
                        [plugin._owned_views, plugin._java_input_targets, plugin._round_capture_gate]
                    ),
                )
            )
            def before_hooked_method(self, param):
                owner = plugin._owner(param.thisObject) if plugin._active else None
                if owner is not None and (
                    plugin._enabled("glass_input") or plugin._enabled("glass_bottom")
                ):
                    # Поле могло появиться после createView. Убираем штатный тёмный фон сразу.
                    plugin._style_input(owner)
                    for name in ("blurredBackgroundDrawable", "inputIslandBubbleDrawable"):
                        plugin._sample_input_backdrop(owner, plugin.field(param.thisObject, name))
                    plugin._style_camera_controls(owner)
                    plugin._cache_input_gate(owner, param.thisObject)

        class CameraControlsHook(MethodHook):
            def after_hooked_method(self, param):
                if not plugin._active:
                    return
                camera = param.thisObject
                owner = plugin._owner(camera) or plugin.field(camera, "delegate") or get_last_fragment()
                if owner is not None and _identity(plugin.field(owner, "instantCameraView")) == _identity(
                    camera
                ):
                    plugin._style_camera_controls(owner)

        class CameraDrawHook(MethodHook):
            @hook_filters(
                HookFilter.Condition(
                    "if (!object[0].contains(this)) { return false; } "
                    "gate = object[1].get(this); "
                    "return gate == null || gate.needsPython();",
                    object=jarray(jclass("java.lang.Object"))(
                        [plugin._owned_views, plugin._java_input_targets]
                    ),
                )
            )
            def before_hooked_method(self, param):
                owner = plugin._owner(param.thisObject) if plugin._active else None
                if owner is not None:
                    plugin._style_camera_controls(owner)
                    plugin._cache_input_gate(owner, param.thisObject)

        class BulletinStyleHook(MethodHook):
            def after_hooked_method(self, param):
                plugin._style_bulletin(param.thisObject)

        class BulletinShowHook(MethodHook):
            def after_hooked_method(self, param):
                if plugin._active:
                    layout = param.thisObject.getLayout()
                    if layout is not None:
                        plugin._style_bulletin(layout)

        class BulletinDrawHook(MethodHook):
            def before_hooked_method(self, param):
                plugin._style_bulletin(param.thisObject)

            @hook_filters(
                HookFilter.Condition(
                    "gate = object.get(this); "
                    "return gate == null || gate.needsPython();",
                    object=plugin._java_bulletin_targets,
                )
            )
            def after_hooked_method(self, param):
                plugin._update_bulletin_capture(param.thisObject)

        class BulletinDetachHook(MethodHook):
            def after_hooked_method(self, param):
                plugin._drop_bulletin(param.thisObject)

        class ActionBarHook(MethodHook):
            def after_hooked_method(self, param):
                owner = plugin._owner(param.thisObject) if plugin._active else None
                if _identity(owner) in plugin._main_headers:
                    param.thisObject.setBackground(None)
                if not plugin._active:
                    return
                action_bar = param.thisObject
                if owner is not None:
                    plugin._style_action_bar(owner)
                    return
                for fragment in list(plugin._known_fragments.values()):
                    if _identity(plugin.field(fragment, "actionBar")) == _identity(action_bar):
                        plugin._style_action_bar(fragment)
                        return
                fragment = get_last_fragment()
                if fragment is not None and _identity(plugin.field(fragment, "actionBar")) == _identity(
                    action_bar
                ):
                    plugin._style_action_bar(fragment)

        class ActionBarLayoutHook(ActionBarHook):
            @hook_filters(
                HookFilter.Condition(
                    "state = object.get(this); if (state == null || this.getBackground() != null) { return true; } "
                    "for (i = 0; i < state.length; i += 2) { "
                    "if (state[i].get(this) != state[i + 1]) { return true; } } return false;",
                    object=plugin._header_layout_targets,
                )
            )
            def after_hooked_method(self, param):
                # Layout меняет размеры; координаты подхватят draw-хуки без пересоздания материалов.
                super().after_hooked_method(param)

        for class_name, methods, hook in (
            (
                "org.telegram.ui.Components.FragmentContextView",
                (
                    "updateStyle",
                    "checkPlayer",
                    "didReceivedNotification",
                    "onAttachedToWindow",
                    "setVisibility",
                    "onDetachedFromWindow",
                ),
                PlayerHook(),
            ),
            (
                "org.telegram.ui.Components.FragmentContextView",
                ("checkCreateView", "onMeasure"),
                PlayerMeasureHook(),
            ),
            ("org.telegram.ui.Components.FragmentContextView", ("dispatchDraw",), PlayerDrawHook()),
            ("org.telegram.ui.Components.BlurredFrameLayout", ("dispatchDraw",), PlayerFrameDrawHook()),
            (
                "com.exteragram.messenger.player.mini.MiniPlayerUiHelper",
                ("setSurfaceColor", "updateColors", "onStyleApplied"),
                MiniPlayerColorsHook(),
            ),
            (
                "org.telegram.ui.Components.ChatActivityTopPanelLayout",
                ("onLayout", "setBlurredBackground"),
                PanelHook(),
            ),
            ("org.telegram.ui.Components.ChatActivityTopPanelLayout", ("dispatchDraw",), PanelDividersHook()),
            ("org.telegram.ui.Components.ChatActivityTopPanelLayout", ("dispatchDraw",), self._panel_dividers_hook),
            ("org.telegram.ui.Components.TranslateButton", ("updateColors",), TranslationColorsHook()),
            (
                "org.telegram.ui.Components.chat.buttons.ChatActivityBlurredRoundButton",
                ("draw", "onDraw"),
                RoundDrawHook(),
            ),
            (
                "org.telegram.ui.Components.chat.buttons.ChatActivityBlurredRoundButton",
                ("draw",),
                RoundPositionHook(),
            ),
            (
                "org.telegram.ui.Components.chat.buttons.ChatActivityBlurredRoundButton",
                ("updateColors", "onSizeChanged"),
                RoundColorsHook(),
            ),
            (
                "org.telegram.ui.Components.chat.layouts.ChatActivityChannelButtonsLayout",
                ("setupDrawableForContainer", "showButton", "onLayout"),
                BottomHook(),
            ),
            (
                "org.telegram.ui.Components.chat.layouts.ChatActivityChannelButtonsLayout",
                ("dispatchDraw",),
                BottomDrawHook(),
            ),
            (
                "org.telegram.ui.Components.chat.layouts.ChatActivitySideControlsButtonsLayout",
                ("getOrCreateButtonHolder", "showButton", "onLayout"),
                BottomHook(),
            ),
            (
                "org.telegram.ui.Components.chat.layouts.ChatActivitySideControlsButtonsLayout",
                ("onAttachedToWindow",),
                SideDrawHook(),
            ),
            (
                "org.telegram.ui.Components.chat.ChatInputViewsContainer",
                ("dispatchDraw",),
                InputBackdropHook(),
            ),
            ("org.telegram.ui.Components.InstantCameraView", ("setButtonsBackground",), CameraControlsHook()),
            (
                "org.telegram.ui.Components.InstantCameraView2",
                ("setButtonsBackground",),
                CameraControlsHook(),
            ),
            ("org.telegram.ui.Components.InstantCameraView", ("onDraw", "onMeasure"), CameraDrawHook()),
            ("org.telegram.ui.Components.InstantCameraView2", ("onMeasure",), CameraDrawHook()),
            (
                "com.exteragram.messenger.camera.InstantCameraZoomSlider",
                ("drawPillBackground",),
                CameraDrawHook(),
            ),
            ("org.telegram.ui.Components.Bulletin$Layout", ("onAttach",), BulletinStyleHook()),
            ("org.telegram.ui.Components.Bulletin", ("show",), BulletinShowHook()),
            (
                "org.telegram.ui.Components.Bulletin$Layout",
                ("dispatchDraw", "dispatchDrawImpl"),
                BulletinDrawHook(),
            ),
            ("org.telegram.ui.Components.Bulletin$Layout", ("onDetach",), BulletinDetachHook()),
            ("org.telegram.ui.ActionBar.ActionBar", ("updateColors", "setBackgroundColor"), ActionBarHook()),
            ("org.telegram.ui.ActionBar.ActionBar", ("onLayout",), ActionBarLayoutHook()),
        ):
            try:
                cls = find_class(class_name)
                if cls is None:
                    self._warn_once(class_name, "Класс отсутствует в установленной сборке")
                    continue
                for method in methods:
                    self._hook_optional(cls, method, hook)
            except Exception as exc:
                self._warn_once(class_name, exc)

    def _patch_chat(self, fragment):
        if fragment is None or not self._active:
            return
        try:
            name = str(fragment.getClass().getName())
        except Exception:
            name = ""
        for suffix, style in (
            (".EmojiView", self._style_emoji_panel),
            (".PhotoViewer", self._style_photo_viewer),
            (".ChatAttachAlert", self._style_attach_alert),
        ):
            if name.endswith(suffix):
                style(fragment)
                return
        if _identity(fragment) not in self._known_fragments:
            self.log("Оформление: обнаружен новый экран")
        self._known_fragments[_identity(fragment)] = fragment
        try:
            self._prepare_pinned(fragment)
            self._style_action_bar(fragment)
            self._style_input(fragment)
            self._style_camera_controls(fragment)
            self._style_mentions(fragment)
            self._style_bot_menu(fragment)
            self._style_bottom_overlay(fragment)
            self._style_top_capsules(fragment)
            self._style_side_capsules(fragment)
            self._style_forward_button(fragment)
            self._style_topics(fragment)
            self._style_profile_tabs(fragment)
            self._style_pinned_message(fragment)
            self._style_floating_date(fragment)

            container = self.field(fragment, "chatInputViewsContainer")
            try:
                if container is not None:
                    container.updateColors()
            except Exception:
                pass
        except Exception as exc:
            self._warn_once("Оформление чата", exc)

    # Восстановление штатного оформления и очистка

    def restore_all(self):
        self._drop_media_glass()
        if self._java_stock_panels is not None:
            try:
                self._java_stock_panels.clear()
            except Exception as exc:
                self._warn_once("Восстановление штатных панелей", exc)
        if self._java_bot_menus is not None:
            try:
                self._java_bot_menus.clear()
            except Exception as exc:
                self._warn_once("Восстановление меню бота", exc)
        self._attach_targets.clear()
        self._pre_draw_depth = 0
        for observer, listener in list(self._deferred_listener_removals.values()):
            try:
                if observer.isAlive():
                    observer.removeOnPreDrawListener(listener)
            except Exception:
                pass
        self._deferred_listener_removals.clear()
        self._restore_folder_blur()
        self._restore_side_buttons()
        self._round_playing = False
        self._round_video_active = False
        self._round_capture_gate[0] = 0
        self._round_panel_clips.clear()
        self._panel_divider_targets.clear()
        for key in list(self._capture_states):
            self._drop_capture_limit(key)
        if self._round_targets is not None:
            self._round_targets.clear()
        self.log("Оформление: восстановление штатного вида")
        for key in list(self._main_searches):
            self._restore_main_search(key)
        for key in list(self._main_headers):
            self._restore_main_header(key)
        self._chat_tokens.clear()
        self._pending_capsules.clear()
        self._pending_pinned.clear()
        self._pinned_retry_counts.clear()
        view_keys = (
            self._pinned_positions.keys()
            | self._pinned_layouts.keys()
            | self._player_layouts.keys()
            | self._surface_positions.keys()
        )
        for key in view_keys:
            self._remove_view_listeners(key)
        self._pinned_busy.clear()
        for entry in list(self._home_guards.values()):
            self._forget_home_guard(entry["owner"])
        self._styling_main.clear()
        for key in list(self._extra_surfaces):
            self._restore_extra_surface(key)
        self._folder_owners.clear()
        self._folder_fades.clear()
        self._checking_capsules.clear()
        for key in list(self._main_nav):
            self._restore_main_nav(key)
        self._main_owners.clear()
        for key in list(self._top_surfaces):
            self._restore_top_surface(key)
        self._restore_emoji_materials()
        for saved in list(self._emoji_backgrounds.values()):
            panel = saved.get("panel")
            try:
                if panel is not None:
                    panel.setBackground(saved["background"])
                    bottom = self.field(panel, "bottomTabContainerBackground")
                    if bottom is not None:
                        bottom.setBackground(saved["bottom"])
                    tabs = saved.get("tabs_view") or self.field(panel, "emojiTabs")
                    if tabs is not None:
                        tabs.setBackground(saved["tabs"])
            except Exception as exc:
                self._warn_once("Восстановление панели эмодзи", exc)
        self._emoji_backgrounds.clear()
        for frame, _color in list(self._player_native_colors.values()):
            self._restore_player_native_blur(frame)
        for frame, _tag in list(self._player_native_tags.values()):
            self._restore_player_native_blur(frame)
        for pinned, _color in list(self._pinned_native_colors.values()):
            self._restore_pinned_native_blur(pinned)
        for key in list(self._native_surfaces):
            self._restore_native_surface(key)
        self._restore_round_button_backgrounds()
        for panel, drawable in self._panel_backgrounds.values():
            if self.field(panel, "backgroundDrawable") is None:
                self._set_java_field(panel, "backgroundDrawable", drawable, "obj")
                panel.invalidate()
        self._panel_backgrounds.clear()
        self._panel_blur_targets.clear()
        self._player_fade_targets.clear()
        self._owners.clear()
        self._owned_views.clear()
        self._main_header_views.clear()
        self._date_cell_targets.clear()
        self._pending_chats.clear()
        for entry in list(self._patched_dates.values()):
            self._unpatch_date(entry.get("cell"))
        for key in list(self._header_islands.keys()):
            data = self._header_islands.get(key)
            if data:
                glass = data.get("glass")
                if glass is not None and glass.getParent() is not None:
                    try:
                        glass.getParent().removeView(glass)
                    except Exception:
                        pass
            self._remove_header_island(data.get("container") if data else None)
        for key in list(self._fallback_inputs.keys()):
            entry = self._fallback_inputs.pop(key, None)
            if entry is not None:
                try:
                    view = entry.get("view")
                    rim = self._rims.pop(key, None)
                    if view is not None and rim is not None:
                        view.getOverlay().remove(rim)
                    if view is not None:
                        view.setBackground(None)
                except Exception:
                    pass
        for entry in list(self._pinned_surfaces.values()):
            self._restore_pinned_entry(entry)
        self._rims.clear()
        self._patched_dates.clear()
        self._header_islands.clear()
        self._fallback_inputs.clear()
        self._pinned_surfaces.clear()
        self._restore_materials()
        self._object_owners.clear()
        self._drawable_owners.clear()
        self._known_fragments.clear()
        self._saved_lenses.clear()
        self._round_button_backgrounds.clear()
